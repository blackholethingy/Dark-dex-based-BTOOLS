local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local mouse = player:GetMouse()
local playerGui = player:WaitForChild("PlayerGui")

-- 1. Global State Management
getgenv().CustomBToolsConfig = {
	Active = true,
	SelectedInstance = nil,
	HoverInstance = nil,
	CurrentMode = "Delete", -- Modes: Delete, Move, Scale, Rotate
	Increment = 1 -- Grid snapping metric (1 stud / 15 degrees rotation)
}
local config = getgenv().CustomBToolsConfig
local btoolsConnections = {}

-- Clean up any duplicate interface layouts left from past test runs
if playerGui:FindFirstChild("BToolsDashboard") then playerGui.BToolsDashboard:Destroy() end
if player.Backpack:FindFirstChild("Custom BTools") then player.Backpack["Custom BTools"]:Destroy() end
if player.Character and player.Character:FindFirstChild("Custom BTools") then player.Character["Custom BTools"]:Destroy() end

-- 2. Build the Control HUD Dashboard Menu
