-- ==========================================================
-- RENDER / HOVER
-- ==========================================================

table.insert(
	state.BtoolsConnections,

	RunService.RenderStepped:
		Connect(function()

			if not config.Active
				or not tool
				or tool.Parent
					~= player.Character
			then

				if not config.SelectedInstance then
					ui.SelectionHighlight.Adornee =
						nil
				end

				return
			end

			if isDragging then

				local currentMousePos =
					Vector2.new(
						mouse.X,
						mouse.Y
					)

				local minX =
					math.min(
						dragStart.X,
						currentMousePos.X
					)

				local maxX =
					math.max(
						dragStart.X,
						currentMousePos.X
					)

				local minY =
					math.min(
						dragStart.Y,
						currentMousePos.Y
					)

				local maxY =
					math.max(
						dragStart.Y,
						currentMousePos.Y
					)

				ui.DragBox.Position =
					UDim2.new(
						0,
						minX,
						0,
						minY
					)

				ui.DragBox.Size =
					UDim2.new(
						0,
						maxX - minX,
						0,
						maxY - minY
					)

				return
			end

			if state.IsManipulating then
				return
			end

			local mouseRay =
				camera:
					ScreenPointToRay(
						mouse.X,
						mouse.Y
					)

			local params =
				RaycastParams.new()

			params.FilterDescendantsInstances =
				{
					player.Character
				}

			params.FilterType =
				Enum.RaycastFilterType.Exclude

			local result =
				workspace:Raycast(
					mouseRay.Origin,
					mouseRay.Direction
						* 500,
					params
				)

			if result
				and result.Instance
				and result.Instance:
					IsA("BasePart")
				and not result.Instance.Locked
			then

				config.HoverInstance =
					result.Instance

				if not config.SelectedInstance then

					ui.SelectionHighlight.Adornee =
						result.Instance

					ui.SelectionHighlight.Color3 =
						Color3.fromRGB(
							0,
							255,
							255
						)
				end

			else

				config.HoverInstance =
					nil

				if not config.SelectedInstance then

					ui.SelectionHighlight.Adornee =
						nil
				end
			end
		end)
)

