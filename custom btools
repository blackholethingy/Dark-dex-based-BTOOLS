			elseif input.KeyCode
				== Enum.KeyCode.C
			then

				config.CurrentMode =
					"Scale"

				ui.ModeText.Text =
					"Mode: SCALE DOTS"

			elseif input.KeyCode
				== Enum.KeyCode.V
			then

				config.CurrentMode =
					"Rotate"

				ui.ModeText.Text =
					"Mode: ROTATE WHEELS"
			end

