-- ==========================================================
-- SNAP
-- ==========================================================

local function snapDistance(distance)

	local increment =
		config.Increment

	if not increment
		or increment <= 0
	then
		return distance
	end

	return math.round(
		distance / increment
	) * increment
end

-- ==========================================================
-- SCALE HELPER
--
-- THIS IS THE IMPORTANT FIX.
--
-- normal = which bubble/face you grabbed.
--
-- Example:
--
-- Right bubble (+X):
--   Pull outward -> X grows
--   Center moves right
--   LEFT SIDE stays fixed
--
-- Left bubble (-X):
--   Pull outward -> X grows
--   Center moves left
--   RIGHT SIDE stays fixed
--
-- Drag inward:
--   That selected face moves inward
--   Size shrinks
--   Opposite face stays fixed
-- ==========================================================

local function scalePartFromFace(
	part,
	face,
	distance
)

	local originalSize =
		state.InitialSizes[part]

	local originalCFrame =
		state.InitialCFrames[part]

	if not originalSize
		or not originalCFrame
	then
		return
	end

	local snappedDistance =
		snapDistance(
			distance
		)

	-- Direction of the selected handle.
	local faceNormal =
		Vector3.FromNormalId(
			face
		)

	-- ======================================================
	-- CRITICAL DIFFERENCE FROM OLD CODE:
	--
	-- Size change ignores +/- FACE DIRECTION,
	-- but DOES NOT ignore +/- DRAG DISTANCE.
	--
	-- So:
	--
	-- +X outward = grow X
	-- -X outward = grow X
	-- +X inward  = shrink X
	-- -X inward  = shrink X
	--
	-- The FACE decides which side the center shifts toward.
	-- ======================================================

	local axisMask =
		Vector3.new(
			math.abs(faceNormal.X),
			math.abs(faceNormal.Y),
			math.abs(faceNormal.Z)
		)

	local sizeDelta =
		axisMask
		* snappedDistance

	local newSize =
		originalSize
		+ sizeDelta

	-- ======================================================
	-- MINIMUM PART SIZE PROTECTION
	-- ======================================================

	local MIN_SIZE = 0.05

	if newSize.X < MIN_SIZE
		or newSize.Y < MIN_SIZE
		or newSize.Z < MIN_SIZE
	then
		return
	end

	-- ======================================================
	-- KEEP OPPOSITE FACE ANCHORED
	--
	-- If one side grows 4 studs:
	-- center moves 2 studs toward dragged face.
	-- ======================================================

	local centerShift =
		faceNormal
		* (
			snappedDistance / 2
		)

	part.Size =
		newSize

	part.CFrame =
		originalCFrame
		* CFrame.new(
			centerShift
		)
end

-- ==========================================================
-- PROCESS DRAG
-- ==========================================================

getgenv().ProcessHandleDragDelta =
	function(
		face,
		distance
	)

		if not state.IsManipulating then
			return
		end

		local primary =
			getPrimaryPart()

		if not primary then
			return
		end

		local targets =
			getTargets()

		local snappedDistance =
			snapDistance(
				distance
			)

		-- ==================================================
		-- MOVE
		-- ==================================================

		if config.CurrentMode
			== "Move"
		then

			local initial =
				state.InitialCFrames[
					primary
				]

			if not initial then
				return
			end

			local localNormal =
				Vector3.FromNormalId(
					face
				)

			local worldDelta =
				initial:
					VectorToWorldSpace(
						localNormal
						* snappedDistance
					)

			for _, part in ipairs(
				targets
			) do

				local startCFrame =
					state.InitialCFrames[
						part
					]

				if startCFrame then

					part.CFrame =
						startCFrame
						+ worldDelta
				end
			end

		-- ==================================================
		-- SCALE
		-- ==================================================

		elseif config.CurrentMode
			== "Scale"
		then

			for _, part in ipairs(
				targets
			) do

				scalePartFromFace(
					part,
					face,
					distance
				)
			end

		-- ==================================================
		-- ROTATE
		-- ==================================================

		elseif config.CurrentMode
			== "Rotate"
		then

			local snappedDegrees =
				math.round(
					math.deg(
						distance
					) / 15
				) * 15

			local radians =
				math.rad(
					snappedDegrees
				)

			local axisVector =
				Vector3.FromAxis(
					face
				)

			local primaryStart =
				state.InitialCFrames[
					primary
				]

			if not primaryStart then
				return
			end

			local rotation =
				CFrame.fromAxisAngle(
					axisVector,
					radians
				)

			for _, part in ipairs(
				targets
			) do

				local startCFrame =
					state.InitialCFrames[
						part
					]

				if startCFrame then

					if part == primary then

						part.CFrame =
							primaryStart
							* rotation

					else

						local offset =
							primaryStart:
								ToObjectSpace(
									startCFrame
								)

						part.CFrame =
							primaryStart
							* rotation
							* offset
					end
				end
			end
		end
	end

