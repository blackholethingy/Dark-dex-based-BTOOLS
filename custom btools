					.. config.SelectedInstance.Name

				getgenv().
					UpdateBToolsHandleVisibility()
			end
		end)
)

-- ==========================================================
-- BOX SELECT FINISH
-- ==========================================================

table.insert(
	state.BtoolsConnections,

	mouse.Button1Up:
		Connect(function()

			if not isDragging then
				return
			end

			isDragging =
				false

			ui.DragBox.Visible =
				false

			local dragEnd =
				Vector2.new(
					mouse.X,
					mouse.Y
				)

			local minX =
				math.min(
					dragStart.X,
					dragEnd.X
				)

			local maxX =
				math.max(
					dragStart.X,
					dragEnd.X
				)

			local minY =
				math.min(
					dragStart.Y,
					dragEnd.Y
				)

			local maxY =
				math.max(
					dragStart.Y,
					dragEnd.Y
				)

			local selectedBuffer =
				{}

			for _, part in ipairs(
				workspace:
					GetDescendants()
			) do

				if part:IsA("BasePart")
					and not part.Locked
					and not (
						player.Character
						and part:
							IsDescendantOf(
								player.Character
							)
					)
				then

					local screenPos,
						onScreen =
						camera:
							WorldToScreenPoint(
								part.Position
							)

					if onScreen
						and screenPos.X >= minX
						and screenPos.X <= maxX
						and screenPos.Y >= minY
						and screenPos.Y <= maxY
					then

						table.insert(
							selectedBuffer,
							part
						)
					end
				end
			end

			if #selectedBuffer > 0 then

				config.SelectedGroup =
					selectedBuffer

				config.SelectedInstance =
					selectedBuffer[1]

				ui.TargetText.Text =
					"Selected Group Matrix: ("
					.. tostring(
						#selectedBuffer
					)
					.. " parts)"

			else

				config.SelectedInstance =
					nil

				config.SelectedGroup =
					{}

				ui.TargetText.Text =
					"Selected: None (Box Empty)"
			end

			getgenv().
				UpdateBToolsHandleVisibility()
		end)
)

