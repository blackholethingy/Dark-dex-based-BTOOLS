-- PART 2: Drag Logic & Physics Interaction Core
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local mouse = player:GetMouse()

local ui = getgenv().AsylumBToolsUI
local config = getgenv().CustomBToolsConfig

if not ui or not config then
	warn("ERROR: Run Part 1 before executing Part 2 logic loops!")
	return
end

local btoolsConnections = {}
local tool = nil

local function updateHandleAdornee()
	local part = config.SelectedInstance
	if part and part.Parent and config.CurrentMode ~= "Select" then
		ui.SelectionHighlight.Adornee = part
		ui.SelectionHighlight.Color3 = Color3.fromRGB(255, 170, 0)
		
		ui.MoveHandles.Adornee = (config.CurrentMode == "Move") and part or nil
		ui.MoveHandles.Visible = (config.CurrentMode == "Move")
		
		ui.ScaleHandles.Adornee = (config.CurrentMode == "Scale") and part or nil
		ui.ScaleHandles.Visible = (config.CurrentMode == "Scale")
		
		ui.RotateHandles.Adornee = (config.CurrentMode == "Rotate") and part or nil
		ui.RotateHandles.Visible = (config.CurrentMode == "Rotate")
	else
		ui.MoveHandles.Adornee = nil ui.MoveHandles.Visible = false
		ui.ScaleHandles.Adornee = nil ui.ScaleHandles.Visible = false
		ui.RotateHandles.Adornee = nil ui.RotateHandles.Visible = false
		if not part then ui.SelectionHighlight.Adornee = nil end
	end
end

-- Arrow Drag Calculation Engine
local lastMoveDist = 0
table.insert(btoolsConnections, ui.MoveHandles.MouseDrag:Connect(function(face, distance)
	local part = config.SelectedInstance
	if not part then return end
	local snapDist = math.floor(distance / config.Increment + 0.5) * config.Increment
	local delta = snapDist - lastMoveDist
	if delta ~= 0 then
		local direction = Vector3.FromNormalId(face)
		part.CFrame = part.CFrame * CFrame.new(direction * delta)
		lastMoveDist = snapDist
	end
end))
table.insert(btoolsConnections, ui.MoveHandles.MouseButton1Up:Connect(function() lastMoveDist = 0 end))

-- Face-Aligned Scaling Engine (Opposite edge remains anchored)
local lastScaleDist = 0
table.insert(btoolsConnections, ui.ScaleHandles.MouseDrag:Connect(function(face, distance)
	local part = config.SelectedInstance
	if not part then return end
	local snapDist = math.floor(distance / config.Increment + 0.5) * config.Increment
	local delta = snapDist - lastScaleDist
	
	if delta ~= 0 then
		local direction = Vector3.FromNormalId(face)
		local currentSize = part.Size
		local sizeChange = direction * delta
		local newSize = currentSize + Vector3.new(math.abs(sizeChange.X), math.abs(sizeChange.Y), math.abs(sizeChange.Z))
		
		if newSize.X > 0.05 and newSize.Y > 0.05 and newSize.Z > 0.05 then
			part.Size = newSize
			part.CFrame = part.CFrame * CFrame.new(direction * (delta / 2))
			lastScaleDist = snapDist
		end
	end
end))
table.insert(btoolsConnections, ui.ScaleHandles.MouseButton1Up:Connect(function() lastScaleDist = 0 end))

-- Arc Rotation Wheels Engine
local lastAngle = 0
table.insert(btoolsConnections, ui.RotateHandles.MouseDrag:Connect(function(axis, relativeAngle)
	local part = config.SelectedInstance
	if not part then return end
	local degrees = math.deg(relativeAngle)
	local snapDegrees = math.floor(degrees / 15 + 0.5) * 15
	local deltaRad = math.rad(snapDegrees - lastAngle)
	
	if deltaRad ~= 0 then
		local axisVector = Vector3.FromAxis(axis)
		part.CFrame = part.CFrame * CFrame.fromAxisAngle(axisVector, deltaRad)
		lastAngle = snapDegrees
	end
end))
table.insert(btoolsConnections, ui.RotateHandles.MouseButton1Up:Connect(function() lastAngle = 0 end))

-- GUI Action Panel Buttons Setup
local function createInterfaceButton(text, posZ, color, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -20, 0, 30)
	btn.Position = UDim2.new(0, 10, 0, posZ)
	btn.BackgroundColor3 = color
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 12
	btn.Text = text
	btn.Parent = ui.Frame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
	
	btn.MouseButton1Click:Connect(function()
		if not config.Active or not config.SelectedInstance then 
			ui.TargetText.Text = "Selected: SELECT A PART FIRST!"
			return 
		end
		callback(config.SelectedInstance)
	end)
end

createInterfaceButton("DUPLICATE SELECTED PART", 140, Color3.fromRGB(0, 160, 100), function(part)
	local clone = part:Clone()
	clone.CFrame = part.CFrame + Vector3.new(part.Size.X + 1, 0, 0)
	clone.Parent = part.Parent
	config.SelectedInstance = clone
	updateHandleAdornee()
	ui.TargetText.Text = "Selected: " .. clone.Name .. " (Clone)"
end)

createInterfaceButton("DELETE SELECTED PART", 175, Color3.fromRGB(180, 45, 45), function(part)
	part:Destroy()
	config.SelectedInstance = nil
	updateHandleAdornee()
	ui.TargetText.Text = "Selected: Part Erased ✔"
	config.CurrentMode = "Select"
	ui.ModeText.Text = "Mode: SELECT POINTER"
end)

-- Hotkey Management Engine
table.insert(btoolsConnections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or (tool and tool.Parent ~= player.Character) then return end
	
	if input.KeyCode == Enum.KeyCode.Z then
		config.CurrentMode = "Select"
		ui.ModeText.Text = "Mode: SELECT POINTER"
	elseif input.KeyCode == Enum.KeyCode.X then
		config.CurrentMode = "Move"
		ui.ModeText.Text = "Mode: MOVE ARROWS"
	elseif input.KeyCode == Enum.KeyCode.C then
		config.CurrentMode = "Scale"
		ui.ModeText.Text = "Mode: SCALE DOTS"
	elseif input.KeyCode == Enum.KeyCode.V then
		config.CurrentMode = "Rotate"
		ui.ModeText.Text = "Mode: ROTATE WHEELS"
	end
	updateHandleAdornee()
end))

-- Instantiate Inventory Backpack Entry Item
tool = Instance.new("Tool")
tool.Name = "Custom BTools"
tool.RequiresHandle = false
tool.Parent = player.Backpack

-- Cursor Highlight Casting Thread
table.insert(btoolsConnections, RunService.RenderStepped:Connect(function()
	if not config.Active or not tool or tool.Parent ~= player.Character then 
		if not config.SelectedInstance then ui.SelectionHighlight.Adornee = nil end
		return 
	end
	local mouseRay = camera:ScreenPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {player.Character}
	params.FilterType = Enum.RaycastFilterType.Exclude
	
	local result = workspace:Raycast(mouseRay.Origin, mouseRay.Direction * 500, params)
	if result and result.Instance and result.Instance:IsA("BasePart") and not result.Instance.Locked then
		config.HoverInstance = result.Instance
		if not config.SelectedInstance then
			ui.SelectionHighlight.Adornee = result.Instance
			ui.SelectionHighlight.Color3 = Color3.fromRGB(0, 255, 255)
		end
	else
		config.HoverInstance = nil
		if not config.SelectedInstance then ui.SelectionHighlight.Adornee = nil end
	end
end))

table.insert(btoolsConnections, tool.Equipped:Connect(function() ui.Frame.Visible = true updateHandleAdornee() end))
table.insert(btoolsConnections, tool.Unequipped:Connect(function()
	ui.Frame.Visible = false config.SelectedInstance = nil updateHandleAdornee()
end))

table.insert(btoolsConnections, mouse.Button1Down:Connect(function()
	if tool.Parent ~= player.Character or not config.HoverInstance or config.SelectedInstance then return end
	config.SelectedInstance = config.HoverInstance
	ui.TargetText.Text = "Selected: " .. config.SelectedInstance.Name
	updateHandleAdornee()
end))

-- Uninstall Handler Hook Link
ui.UninstallButton.MouseButton1Click:Connect(function()
	config.Active = false
	for _, conn in ipairs(btoolsConnections) do if conn then conn:Disconnect() end end
	btoolsConnections = {}
	if ui.SelectionHighlight then ui.SelectionHighlight:Destroy() end
	if ui.MoveHandles then ui.MoveHandles:Destroy() end
	if ui.ScaleHandles then ui.ScaleHandles:Destroy() end
	if ui.RotateHandles then ui.RotateHandles:Destroy() end
	if ui.ScreenGui then ui.ScreenGui:Destroy() end
	if tool then tool:Destroy() end
	print("SUCCESS: Handles BTools framework uninstalled completely.")
end)
print("Part 2: Active execution logic loop mounted.")
