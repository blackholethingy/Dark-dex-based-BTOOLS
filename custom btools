-- 3. Unified Mouse Click Gaze Target Raycaster Selection Hooks
_G.DexInputConnection = UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		-- Skip target resets if clicking directly on a visual handles widget
		if moveHandles.TargetPart or scaleHandles.TargetPart or rotateHandles.TargetPart then return end
		
		if _G.DexCurrentMode == "Select" or _G.DexCurrentMode == "Move" or _G.DexCurrentMode == "Scale" or _G.DexCurrentMode == "Rotate" then
			local target = mouse.Target
			if target and not target.Locked then
				_G.DexActivePart = target
				_G.DexUpdateHandles(target)
			else
				_G.DexActivePart = nil
				_G.DexHideAllHandles()
			end
			
		elseif _G.DexCurrentMode == "Create" then
			-- Instantiate standard primitive components seamlessly on surface boundaries
			local spawnPos = mouse.Hit.Position + Vector3.new(0, 2, 0)
			local newPart = Instance.new("Part")
			newPart.Size = Vector3.new(4, 2, 4)
			newPart.Position = spawnPos
			newPart.Material = Enum.Material.SmoothPlastic
			newPart.Color = Color3.fromRGB(163, 162, 165)
			newPart.Anchored = true
			
			if _G.DexCurrentShape == "Ball" then newPart.Shape = Enum.PartType.Ball newPart.Size = Vector3.new(4, 4, 4)
			elseif _G.DexCurrentShape == "Cylinder" then newPart.Shape = Enum.PartType.Cylinder newPart.Size = Vector3.new(4, 4, 4)
			elseif _G.DexCurrentShape == "Wedge" then newPart.Size = Vector3.new(4, 4, 4) pcall(function() newPart:Destroy() newPart = Instance.new("WedgePart") newPart.Size = Vector3.new(4, 4, 4) newPart.Position = spawnPos newPart.Anchored = true end) end
			
			newPart.Parent = workspace
			getgenv().PushDexUndo({Type = "Create", Part = newPart})
			_G.DexActivePart = newPart
			_G.DexCurrentMode = "Select"
			_G.DexUpdateButtonHighlights("Select")
			_G.DexUpdateHandles(newPart)
		end
	end
end)

