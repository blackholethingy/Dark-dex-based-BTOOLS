-- ==========================================================
-- GET CURRENT TARGETS
-- ==========================================================

local function getTargets()
	local targets = {}

	if #config.SelectedGroup > 0 then
		for _, part in ipairs(
			config.SelectedGroup
		) do

			if part
				and part.Parent
				and part:IsA("BasePart")
			then
				table.insert(
					targets,
					part
				)
			end
		end

	elseif config.SelectedInstance
		and typeof(
			config.SelectedInstance
		) == "Instance"
		and config.SelectedInstance:
			IsA("BasePart")
	then

		table.insert(
			targets,
			config.SelectedInstance
		)
	end

	return targets
end

-- ==========================================================
-- GROUP HIGHLIGHTS
-- ==========================================================

local function applyGroupHighlights()

	getgenv().ClearBToolsGroupHighlights()

	for _, part in ipairs(
		getTargets()
	) do

		local highlight =
			Instance.new(
				"SelectionBox"
			)

		highlight.Color3 =
			Color3.fromRGB(
				255,
				170,
				0
			)

		highlight.LineThickness =
			0.03

		highlight.Adornee =
			part

		highlight.Parent =
			camera

		table.insert(
			state.ActiveHighlights,
			highlight
		)
	end
end

-- ==========================================================
-- GET PRIMARY PART
-- ==========================================================

local function getPrimaryPart()

	if config.SelectedInstance
		and typeof(
			config.SelectedInstance
		) == "Instance"
		and config.SelectedInstance:
			IsA("BasePart")
	then

		return config.SelectedInstance
	end

	if #config.SelectedGroup > 0 then

		local part =
			config.SelectedGroup[1]

		if part
			and part.Parent
			and part:IsA("BasePart")
		then

			return part
		end
	end

	return nil
end

