local ui = getgenv().AsylumBToolsUI
local config = getgenv().CustomBToolsConfig

if not ui or not config then
	warn("ERROR: Missing dependencies! Part 1 must run first.")
	return
end

getgenv().BToolsInternalState = {
	IsManipulating = false,
	CurrentHandleFace = nil,
	InitialCFrames = {},
	InitialSizes = {},
	ActiveHighlights = {},
	BtoolsConnections = {}
}

local state = getgenv().BToolsInternalState
local camera = workspace.CurrentCamera

getgenv().ClearBToolsGroupHighlights = function()
	for _, hl in ipairs(state.ActiveHighlights) do pcall(function() hl:Destroy() end) end
	state.ActiveHighlights = {}
end

local function applyGroupHighlights()
	getgenv().ClearBToolsGroupHighlights()
	local targets = #config.SelectedGroup > 0 and config.SelectedGroup or {config.SelectedInstance}
	for _, part in ipairs(targets) do
		if part and part.Parent and part:IsA("BasePart") then
			local hl = Instance.new("SelectionBox")
			hl.Color3 = Color3.fromRGB(255, 170, 0)
			hl.LineThickness = 0.03
			hl.Adornee = part
			hl.Parent = camera
			table.insert(state.ActiveHighlights, hl)
		end
	end
end

getgenv().UpdateBToolsHandleVisibility = function()
	local part = config.SelectedInstance
	if part and part.Parent and type(part) ~= "table" and config.CurrentMode ~= "Select" then
		ui.SelectionHighlight.Adornee = part
		ui.SelectionHighlight.Color3 = Color3.fromRGB(255, 170, 0)
		applyGroupHighlights()
		
		ui.MoveHandles.Adornee = (config.CurrentMode == "Move") and part or nil
		ui.MoveHandles.Visible = (config.CurrentMode == "Move")
		ui.ScaleHandles.Adornee = (config.CurrentMode == "Scale") and part or nil
		ui.ScaleHandles.Visible = (config.CurrentMode == "Scale")
		ui.RotateHandles.Adornee = (config.CurrentMode == "Rotate") and part or nil
		ui.RotateHandles.Visible = (config.CurrentMode == "Rotate")
	else
		ui.MoveHandles.Adornee = nil ui.MoveHandles.Visible = false
		ui.ScaleHandles.Adornee = nil ui.ScaleHandles.Visible = false
		ui.RotateHandles.Adornee = nil ui.RotateHandles.Visible = false
		if not part then ui.SelectionHighlight.Adornee = nil getgenv().ClearBToolsGroupHighlights() end
	end
end

getgenv().StartTrackingTransforms = function()
	state.IsManipulating = true
	state.InitialCFrames = {}
	state.InitialSizes = {}
	local targets = #config.SelectedGroup > 0 and config.SelectedGroup or {config.SelectedInstance}
	for _, p in ipairs(targets) do
		if p and p.Parent and p:IsA("BasePart") then
			state.InitialCFrames[p] = p.CFrame
			state.InitialSizes[p] = p.Size
		end
	end
end

getgenv().StopTrackingTransforms = function()
	state.IsManipulating = false
	state.CurrentHandleFace = nil
	state.InitialCFrames = {}
	state.InitialSizes = {}
end

getgenv().ProcessHandleDragDelta = function(face, distance)
	if not state.IsManipulating or not config.SelectedInstance then return end
	local primary = config.SelectedInstance
	if type(primary) == "table" or not primary:IsA("BasePart") then return end
	
	local snapDist = math.floor(distance / config.Increment + 0.5) * config.Increment
	local normalVector = Vector3.FromNormalId(face)
	local targets = #config.SelectedGroup > 0 and config.SelectedGroup or {primary}
	
	if config.CurrentMode == "Move" then
		if state.InitialCFrames[primary] then
			local worldDelta = state.InitialCFrames[primary]:VectorToWorldSpace(normalVector * snapDist)
			for _, p in ipairs(targets) do
				if state.InitialCFrames[p] then p.CFrame = state.InitialCFrames[p] + worldDelta end
			end
		end
	elseif config.CurrentMode == "Scale" then
		local origSize = state.InitialSizes[primary]
		local origCFrame = state.InitialCFrames[primary]
		if origSize and origCFrame then
			local sizeChange = normalVector * snapDist
			local newSize = origSize + Vector3.new(math.abs(sizeChange.X), math.abs(sizeChange.Y), math.abs(sizeChange.Z))
			if newSize.X > 0.05 and newSize.Y > 0.05 and newSize.Z > 0.05 then
				primary.Size = newSize
				primary.CFrame = origCFrame * CFrame.new(normalVector * (snapDist / 2))
			end
		end
	elseif config.CurrentMode == "Rotate" then
		local rad = math.rad(math.floor(math.deg(distance) / 15 + 0.5) * 15)
		local axisVector = Vector3.FromAxis(face)
		for _, p in ipairs(targets) do
			if state.InitialCFrames[p] then
				if p == primary then
					p.CFrame = state.InitialCFrames[primary] * CFrame.fromAxisAngle(axisVector, rad)
				else
					local localOffset = state.InitialCFrames[primary]:ToObjectSpace(state.InitialCFrames[p])
					local rotatedOffset = CFrame.fromAxisAngle(axisVector, rad) * localOffset
					p.CFrame = (state.InitialCFrames[primary] * CFrame.fromAxisAngle(axisVector, rad)) * rotatedOffset
				end
			end
		end
	end
end

local function createInterfaceButton(text, posZ, color, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -20, 0, 30)
	btn.Position = UDim2.new(0, 10, 0, posZ)
	btn.BackgroundColor3 = color
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 12
	btn.Text = text
	btn.Parent = ui.Frame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
	
	btn.MouseButton1Click:Connect(function()
		if not config.Active or (#config.SelectedGroup == 0 and not config.SelectedInstance) then 
			ui.TargetText.Text = "Selected: NOTHING HIGHLIGHTED!"
			return 
		end
		callback()
	end)
end

createInterfaceButton("DUPLICATE CHOSEN TARGETS", 155, Color3.fromRGB(0, 160, 100), function()
	local newGroup = {}
	local primary = config.SelectedInstance
	local targets = #config.SelectedGroup > 0 and config.SelectedGroup or {primary}
	for _, part in ipairs(targets) do
		pcall(function()
			if part and part:IsA("BasePart") then
				local clone = part:Clone()
				clone.CFrame = part.CFrame + Vector3.new(0, part.Size.Y + 2, 0)
				clone.Parent = part.Parent
				table.insert(newGroup, clone)
			end
		end)
	end
	if #newGroup > 0 then
		config.SelectedGroup = newGroup
		config.SelectedInstance = newGroup
		getgenv().UpdateBToolsHandleVisibility()
		ui.TargetText.Text = "Selected: Group Cloned (" .. tostring(#newGroup) .. " parts)"
	end
end)

createInterfaceButton("DELETE CHOSEN TARGETS", 190, Color3.fromRGB(180, 45, 45), function()
	local targets = #config.SelectedGroup > 0 and config.SelectedGroup or {config.SelectedInstance}
	for _, part in ipairs(targets) do pcall(function() part:Destroy() end) end
	config.SelectedInstance = nil
	config.SelectedGroup = {}
	getgenv().UpdateBToolsHandleVisibility()
	ui.TargetText.Text = "Selected: Group Erased ✔"
	config.CurrentMode = "Select"
	ui.ModeText.Text = "Mode: SELECT POINTER"
end)

