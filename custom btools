createInterfaceButton(
	"DUPLICATE CHOSEN TARGETS",
	155,
	Color3.fromRGB(
		0,
		160,
		100
	),
	function()

		local newGroup = {}

		for _, part in ipairs(
			getTargets()
		) do

			pcall(function()

				local clone =
					part:Clone()

				clone.CFrame =
					part.CFrame
					+ Vector3.new(
						0,
						part.Size.Y + 2,
						0
					)

				clone.Parent =
					part.Parent

				table.insert(
					newGroup,
					clone
				)

			end)
		end

		if #newGroup > 0 then

			config.SelectedGroup =
				newGroup

			config.SelectedInstance =
				newGroup[1]

			getgenv().
				UpdateBToolsHandleVisibility()

			ui.TargetText.Text =
				"Selected: Group Cloned ("
				.. tostring(
					#newGroup
				)
				.. " parts)"
		end
	end
)

