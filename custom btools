-- PART 3: Raycast Scanner Loops & Input Mapping Enforcers
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local mouse = player:GetMouse()

local ui = getgenv().AsylumBToolsUI
local config = getgenv().CustomBToolsConfig
local state = getgenv().BToolsInternalState

if not ui or not config or not state then
	warn("ERROR: Absolute execution crash. Missing state tables from Part 2.")
	return
end

local isDragging = false
local dragStart = Vector2.new()

-- Bind handle listeners to calculation matrix functions
table.insert(state.BtoolsConnections, ui.MoveHandles.MouseButton1Down:Connect(function(face) getgenv().StartTrackingTransforms() end))
table.insert(state.BtoolsConnections, ui.MoveHandles.MouseDrag:Connect(function(face, distance) getgenv().ProcessHandleDragDelta(face, distance) end))
table.insert(state.BtoolsConnections, ui.MoveHandles.MouseButton1Up:Connect(function() getgenv().StopTrackingTransforms() end))

table.insert(state.BtoolsConnections, ui.ScaleHandles.MouseButton1Down:Connect(function(face) getgenv().StartTrackingTransforms() end))
table.insert(state.BtoolsConnections, ui.ScaleHandles.MouseDrag:Connect(function(face, distance) getgenv().ProcessHandleDragDelta(face, distance) end))
table.insert(state.BtoolsConnections, ui.ScaleHandles.MouseButton1Up:Connect(function() getgenv().StopTrackingTransforms() end))

table.insert(state.BtoolsConnections, ui.RotateHandles.MouseButton1Down:Connect(function(axis) getgenv().StartTrackingTransforms() end))
table.insert(state.BtoolsConnections, ui.RotateHandles.MouseDrag:Connect(function(axis, relativeAngle) getgenv().ProcessHandleDragDelta(axis, relativeAngle) end))
table.insert(state.BtoolsConnections, ui.RotateHandles.MouseButton1Up:Connect(function() getgenv().StopTrackingTransforms() end))

-- Hotkey Listeners
table.insert(state.BtoolsConnections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or (tool and tool.Parent ~= player.Character) then return end
	if input.KeyCode == Enum.KeyCode.Z then
		config.CurrentMode = "Select"
		ui.ModeText.Text = "Mode: SELECT POINTER"
	elseif input.KeyCode == Enum.KeyCode.X then
		config.CurrentMode = "Move"
		ui.ModeText.Text = "Mode: MOVE ARROWS"
	elseif input.KeyCode == Enum.KeyCode.C then
		config.CurrentMode = "Scale"
		ui.ModeText.Text = "Mode: SCALE DOTS"
	elseif input.KeyCode == Enum.KeyCode.V then
		config.CurrentMode = "Rotate"
		ui.ModeText.Text = "Mode: ROTATE WHEELS"
	end
	getgenv().UpdateBToolsHandleVisibility()
end))

local tool = Instance.new("Tool")
tool.Name = "Custom BTools"
tool.RequiresHandle = false
tool.Parent = player.Backpack

-- Render Loop Processing
table.insert(state.BtoolsConnections, RunService.RenderStepped:Connect(function()
	if not config.Active or not tool or tool.Parent ~= player.Character then 
		if not config.SelectedInstance then ui.SelectionHighlight.Adornee = nil end
		return 
	end
	
	if isDragging then
		local currentMousePos = Vector2.new(mouse.X, mouse.Y)
		local minX = math.min(dragStart.X, currentMousePos.X)
		local maxX = math.max(dragStart.X, currentMousePos.X)
		local minY = math.min(dragStart.Y, currentMousePos.Y)
		local maxY = math.max(dragStart.Y, currentMousePos.Y)
		ui.DragBox.Position = UDim2.new(0, minX, 0, minY)
		ui.DragBox.Size = UDim2.new(0, maxX - minX, 0, maxY - minY)
		return
	end
	
	if state.IsManipulating then return end
	
	local mouseRay = camera:ScreenPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {player.Character}
	params.FilterType = Enum.RaycastFilterType.Exclude
	
	local result = workspace:Raycast(mouseRay.Origin, mouseRay.Direction * 500, params)
	if result and result.Instance and result.Instance:IsA("BasePart") and not result.Instance.Locked then
		config.HoverInstance = result.Instance
		if not config.SelectedInstance then
			ui.SelectionHighlight.Adornee = result.Instance
			ui.SelectionHighlight.Color3 = Color3.fromRGB(0, 255, 255)
		end
	else
		config.HoverInstance = nil
		if not config.SelectedInstance then ui.SelectionHighlight.Adornee = nil end
	end
end))

table.insert(state.BtoolsConnections, tool.Equipped:Connect(function() ui.Frame.Visible = true getgenv().UpdateBToolsHandleVisibility() end))
table.insert(state.BtoolsConnections, tool.Unequipped:Connect(function()
	ui.Frame.Visible = false config.SelectedInstance = nil config.SelectedGroup = {} getgenv().UpdateBToolsHandleVisibility()
end))

table.insert(state.BtoolsConnections, mouse.Button1Down:Connect(function()
	if tool.Parent ~= player.Character or state.IsManipulating then return end
	
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
		isDragging = true
		dragStart = Vector2.new(mouse.X, mouse.Y)
		ui.DragBox.Position = UDim2.new(0, dragStart.X, 0, dragStart.Y)
		ui.DragBox.Size = UDim2.new(0, 0, 0, 0)
		ui.DragBox.Visible = true
		config.SelectedInstance = nil
		config.SelectedGroup = {}
		getgenv().UpdateBToolsHandleVisibility()
	else
		if not config.HoverInstance or config.SelectedInstance then return end
		config.SelectedInstance = config.HoverInstance
		config.SelectedGroup = {config.HoverInstance}
		ui.TargetText.Text = "Selected: " .. config.SelectedInstance.Name
		getgenv().UpdateBToolsHandleVisibility()
	end
end))

table.insert(state.BtoolsConnections, mouse.Button1Up:Connect(function()
	if not isDragging then return end
	isDragging = false
	ui.DragBox.Visible = false
	
	local dragEnd = Vector2.new(mouse.X, mouse.Y)
	local minX = math.min(dragStart.X, dragEnd.X)
	local maxX = math.max(dragStart.X, dragEnd.X)
	local minY = math.min(dragStart.Y, dragEnd.Y)
	local maxY = math.max(dragStart.Y, dragEnd.Y)
	
	local selectedBuffer = {}
	for _, part in ipairs(workspace:GetDescendants()) do
		if part:IsA("BasePart") and not part.Locked and part.Parent ~= player.Character then
			local screenPos, onScreen = camera:WorldToScreenPoint(part.Position)
			if onScreen then
				if screenPos.X >= minX and screenPos.X <= maxX and screenPos.Y >= minY and screenPos.Y <= maxY then
					table.insert(selectedBuffer, part)
				end
			end
		end
	end
	
	if #selectedBuffer > 0 then
		config.SelectedGroup = selectedBuffer
		config.SelectedInstance = selectedBuffer
		ui.TargetText.Text = "Selected Group Matrix: (" .. tostring(#selectedBuffer) .. " parts)"
	else
		ui.TargetText.Text = "Selected: None (Box Empty)"
	end
	getgenv().UpdateBToolsHandleVisibility()
end))

-- SAFE RED DESTRUCTOR OVERRIDE: Instantly clears all frames, variables, highlights, and tools
ui.UninstallButton.MouseButton1Click:Connect(function()
	config.Active = false
	getgenv().StopTrackingTransforms()
	for _, conn in ipairs(state.BtoolsConnections) do if conn then conn:Disconnect() end end
	state.BtoolsConnections = {}
	getgenv().ClearBToolsGroupHighlights()
	if ui.SelectionHighlight then ui.SelectionHighlight:Destroy() end
	if ui.MoveHandles then ui.MoveHandles:Destroy() end
	if ui.ScaleHandles then ui.ScaleHandles:Destroy() end
	if ui.RotateHandles then ui.RotateHandles:Destroy() end
	if ui.ScreenGui then ui.ScreenGui:Destroy() end
	if tool then tool:Destroy() end
	getgenv().AsylumBToolsUI = nil
	getgenv().CustomBToolsConfig = nil
	getgenv().BToolsInternalState = nil
	print("SUCCESS: GUI completely destroyed, tools wiped, and event listeners disconnected.")
end)
