-- Mathematical Snap Calculator Function
local function snapValue(value, snap)
	if not snap or snap <= 0 then return value end
	return math.round(value / snap) * snap
end

_G.DexUpdateButtonHighlights = function(activeMode)
	for _, btn in ipairs(toolbar:GetChildren()) do
		if btn:IsA("TextButton") and modeColors[btn.Text] then
			btn.BackgroundColor3 = (btn.Text == activeMode) and modeColors[btn.Text] or Color3.fromRGB(45, 45, 48)
		end
	end
end

-- 1. Precision Single-Sided Scale and Move Event Handlers Logic
local initialCFrame, initialSize
local lastMoveDistance = 0

moveHandles.MouseButton1Down:Connect(function()
	if _G.DexActivePart then
		initialCFrame = _G.DexActivePart.CFrame
		getgenv().PushDexUndo({Type = "Transform", Part = _G.DexActivePart, CFrame = initialCFrame, Size = _G.DexActivePart.Size})
	end
	lastMoveDistance = 0
end)

moveHandles.MouseDrag:Connect(function(face, distance)
	local part = _G.DexActivePart
	if not part or not initialCFrame then return end
	local snappedDist = snapValue(distance, _G.DexMoveSnap)
	local normalIdVector = Vector3.FromNormalId(face)
	-- Shifts CFrame position along structural world axis transforms cleanly
	part.CFrame = initialCFrame * CFrame.new(normalIdVector * snappedDist)
end)

local lastScaleDistance = 0
scaleHandles.MouseButton1Down:Connect(function()
	if _G.DexActivePart then
		initialCFrame = _G.DexActivePart.CFrame
		initialSize = _G.DexActivePart.Size
		getgenv().PushDexUndo({Type = "Transform", Part = _G.DexActivePart, CFrame = initialCFrame, Size = initialSize})
	end
	lastScaleDistance = 0
end)

-- FIXED SINGLE-SIDED SCALING: Grows purely out from the pulled side while anchoring the opposite face
scaleHandles.MouseDrag:Connect(function(face, distance)
	local part = _G.DexActivePart
	if not part or not initialSize or not initialCFrame then return end
	
	local axisVector = Vector3.FromNormalId(face)
	local snappedDist = snapValue(distance, _G.DexMoveSnap)
	
	-- Calculate total geometric growth change variables
	local currentChange = axisVector * snappedDist
	local newSize = initialSize + Vector3.new(math.abs(currentChange.X), math.abs(currentChange.Y), math.abs(currentChange.Z))
	
	if newSize.X > 0.05 and newSize.Y > 0.05 and newSize.Z > 0.05 then
		part.Size = newSize
		-- Core Offset Transform: Translates root matrix coordinate centers by exactly half the growth delta 
		-- along the normal face vector so the back edge stays locked firmly on the platform grid
		part.CFrame = initialCFrame * CFrame.new(axisVector * (snappedDist / 2))
	end
end)

local lastRotAngle = 0
rotateHandles.MouseButton1Down:Connect(function()
	if _G.DexActivePart then
		initialCFrame = _G.DexActivePart.CFrame
		getgenv().PushDexUndo({Type = "Transform", Part = _G.DexActivePart, CFrame = initialCFrame, Size = _G.DexActivePart.Size})
	end
	lastRotAngle = 0
end)

rotateHandles.MouseDrag:Connect(function(axis, relativeAngle)
	local part = _G.DexActivePart
	if not part or not initialCFrame then return end
	
	local degrees = math.deg(relativeAngle)
	local snappedDegrees = snapValue(degrees, _G.DexRotateSnap > 0 and _G.DexRotateSnap or 15)
	local radDelta = math.rad(snappedDegrees)
	
	local axisVector = Vector3.FromAxis(axis)
	part.CFrame = initialCFrame * CFrame.fromAxisAngle(axisVector, radDelta)
end)

