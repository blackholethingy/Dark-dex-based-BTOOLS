	if not node then

		editorLabel.Text =
			"SELECT A NODE"

		return
	end

	if node.Type == "Wait" then

		editorLabel.Text =
			"WAIT: "
			.. string.format(
				"%.1fs",
				node.Duration
					or 2
			)

	elseif node.Type == "Proximity" then

		editorLabel.Text =
			"PROX DISTANCE: "
			.. tostring(
				node.Distance
					or 6
