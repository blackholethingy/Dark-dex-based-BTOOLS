-- ==========================================================
-- NODE AUTO-DOER
-- FIXED DIRECT WALKING + OPTIONAL PATHFINDING
-- ==========================================================
--
-- MOVEMENT:
--
-- DIRECT
--   Uses Humanoid:MoveTo()
--   NO PathfindingService
--
-- PATHFINDING
--   Uses Roblox PathfindingService
--
-- NODE TYPES:
--
-- WALK
-- WAIT
-- PROXIMITY
-- PROMPT
-- JUMP
-- KEY
--
-- ==========================================================

local Players =
	game:GetService("Players")

local PathfindingService =
	game:GetService("PathfindingService")

local UserInputService =
	game:GetService("UserInputService")

local RunService =
	game:GetService("RunService")

local VirtualInputManager =
	game:GetService("VirtualInputManager")

local Workspace =
	game:GetService("Workspace")

local player =
	Players.LocalPlayer

local playerGui =
	player:WaitForChild("PlayerGui")

local mouse =
	player:GetMouse()

-- ==========================================================
-- CLEAN OLD VERSION
-- ==========================================================

if getgenv().NodeAutoDoerCleanup then
	pcall(
		getgenv().NodeAutoDoerCleanup
	)
end

-- ==========================================================
-- NODE STORAGE
-- ==========================================================

if not getgenv().AutoNodes then
	getgenv().AutoNodes = {}
end

local nodes =
	getgenv().AutoNodes

-- ==========================================================
-- SETTINGS
-- ==========================================================

local SETTINGS = {

	MovementMode =
		"Direct",

	-- Direct

	DirectArrivalDistance =
		1.75,

	DirectStuckCheckInterval =
		0.8,

	DirectMinimumMovement =
		0.65,

	DirectAutoJump =
		true,

	-- How often MoveTo target is refreshed.
	DirectRefreshRate =
		0.15,

	-- 0 = infinite
	DirectTimeout =
		0,

	-- Pathfinding

	AgentRadius =
		2,

	AgentHeight =
		5,

	AgentCanJump =
		true,

	WaypointSpacing =
		2.5,

	IntermediateWaypointDistance =
		4.5,

	FinalWaypointDistance =
		1.5,

	PathStuckCheckInterval =
		0.8,

	PathMinimumMovement =
		1.1,

	WaypointTimeout =
		4,

	MaxPathRetries =
		5,

	-- Nodes

	DefaultProximityDistance =
		6
}

-- ==========================================================
-- STATE
-- ==========================================================

local alive =
	true

local executing =
	false

local stopRequested =
	false

local loopRoute =
	false

local currentNodeIndex =
	nil

local selectedNodeIndex =
	nil

local placementMode =
	nil

local keyCaptureNode =
	nil

local routeId =
	0

local connections =
	{}

local markers =
	{}

local markerFolder =
	nil

-- ==========================================================
-- CONNECTION TRACKER
-- ==========================================================

local function track(connection)

	table.insert(
		connections,
		connection
	)

	return connection
end

-- ==========================================================
-- GET CHARACTER
-- ==========================================================

local function getCharacter()

	local character =
		player.Character

	if not character then
		return nil
	end

	local humanoid =
		character:
			FindFirstChildOfClass(
				"Humanoid"
			)

	local root =
		character:
			FindFirstChild(
				"HumanoidRootPart"
			)

	if not humanoid
		or not root
	then

		return nil
	end

	if humanoid.Health <= 0 then
		return nil
	end

	return character,
		humanoid,
		root
end

-- ==========================================================
-- STOP CHARACTER
-- ==========================================================

local function stopMovement()

	local _,
		humanoid,
		root =
		getCharacter()

	if humanoid
		and root
	then

		-- Cancel MoveTo.
		humanoid:
			MoveTo(
				root.Position
			)

		humanoid:
			Move(
				Vector3.zero,
				false
			)
	end
end

-- ==========================================================
-- INSTANCE POSITION
-- ==========================================================

local function getInstancePosition(
	instance
)

	if not instance
		or not instance.Parent
	then

		return nil
	end

	if instance:IsA("Attachment") then

		return instance.WorldPosition
	end

	if instance:IsA("BasePart") then

		return instance.Position
	end

	if instance:IsA("Model") then

		return instance:
			GetPivot().Position
	end

	if instance:IsA("ProximityPrompt") then

		local parent =
			instance.Parent

		if parent:IsA("Attachment") then

			return parent.WorldPosition

		elseif parent:IsA("BasePart") then

			return parent.Position
		end
	end

	local model =
		instance:
			FindFirstAncestorOfClass(
				"Model"
			)

	if model then

		return model:
			GetPivot().Position
	end

	return nil
end

-- ==========================================================
-- NODE POSITION
-- ==========================================================

local function getNodePosition(
	node
)

	if not node then
		return nil
	end

	if node.Type == "Walk" then

		return node.Position

	elseif node.Type == "Proximity" then

		return getInstancePosition(
			node.Target
		)

	elseif node.Type == "Prompt" then

		return getInstancePosition(
			node.Prompt
		)
	end

	return nil
end

-- ==========================================================
-- NODE TEXT
-- ==========================================================

local function nodeText(
	node,
	index
)

	if not node then

		return tostring(index)
			.. ". ???"
	end

	if node.Type == "Walk" then

		return tostring(index)
			.. ". WALK"

	elseif node.Type == "Wait" then

		return tostring(index)
			.. ". WAIT "
			.. string.format(
				"%.1fs",
				node.Duration
					or 2
			)

	elseif node.Type == "Proximity" then

		return tostring(index)
			.. ". PROX "
			.. (
				node.Target
				and node.Target.Name
				or "missing"
			)
			.. " ["
			.. tostring(
				node.Distance
					or SETTINGS.DefaultProximityDistance
			)
			.. "]"

	elseif node.Type == "Prompt" then

		return tostring(index)
			.. ". PROMPT "
			.. (
				node.Prompt
				and node.Prompt.Name
				or "missing"
			)

	elseif node.Type == "Jump" then

		return tostring(index)
			.. ". JUMP"

	elseif node.Type == "Key" then

		return tostring(index)
			.. ". KEY ["
			.. (
				node.KeyCode
				and node.KeyCode.Name
				or "None"
			)
			.. "]"
	end

	return tostring(index)
		.. ". "
		.. tostring(
			node.Type
		)
end

-- ==========================================================
-- MARKERS
-- ==========================================================

local function resetMarkers()

	if markerFolder
		and markerFolder.Parent
	then

		markerFolder:
			Destroy()
	end

	markerFolder =
		Instance.new("Folder")

	markerFolder.Name =
		"AutoDoerNodeMarkers"

	markerFolder.Parent =
		Workspace

	markers = {}
end

local function createMarker(
	index,
	node
)

	local position =
		getNodePosition(
			node
		)

	if not position then
		return nil
	end

	local part =
		Instance.new("Part")

	part.Name =
		"RouteNode_"
		.. tostring(index)

	part.Shape =
		Enum.PartType.Ball

	part.Size =
		Vector3.new(
			1,
			1,
			1
		)

	part.Material =
		Enum.Material.Neon

	part.Anchored =
		true

	part.CanCollide =
		false

	part.CanTouch =
		false

	part.CanQuery =
		false

	part.Transparency =
		0.2

	part.Position =
		position
		+ Vector3.new(
			0,
			1.5,
			0
		)

	part.Parent =
		markerFolder

	local billboard =
		Instance.new(
			"BillboardGui"
		)

	billboard.Size =
		UDim2.fromOffset(
			130,
			45
		)

	billboard.StudsOffset =
		Vector3.new(
			0,
			1,
			0
		)

	billboard.AlwaysOnTop =
		true

	billboard.Parent =
		part

	local label =
		Instance.new("TextLabel")

	label.Size =
		UDim2.fromScale(
			1,
			1
		)

	label.BackgroundColor3 =
		Color3.fromRGB(
			15,
			15,
			18
		)

	label.BackgroundTransparency =
		0.25

	label.BorderSizePixel =
		0

	label.Text =
		nodeText(
			node,
			index
		)

	label.TextColor3 =
		Color3.new(
			1,
			1,
			1
		)

	label.TextWrapped =
		true

	label.TextSize =
		12

	label.Font =
		Enum.Font.SourceSansBold

	label.Parent =
		billboard

	return {

		Part =
			part,

		Label =
			label
	}
end

local function rebuildMarkers()

	resetMarkers()

	for index, node in ipairs(
		nodes
	) do

		markers[index] =
			createMarker(
				index,
				node
			)
	end
end

local function updateMarkers()

	for index, node in ipairs(
		nodes
	) do

		local marker =
			markers[index]

		if marker
			and marker.Part
			and marker.Part.Parent
		then

			local position =
				getNodePosition(
					node
				)

			if position then

				marker.Part.Position =
					position
					+ Vector3.new(
						0,
						1.5,
						0
					)
			end

			marker.Label.Text =
				nodeText(
					node,
					index
				)

			if currentNodeIndex
				== index
			then

				marker.Part.Size =
					Vector3.new(
						1.5,
						1.5,
						1.5
					)

			elseif selectedNodeIndex
				== index
			then

				marker.Part.Size =
					Vector3.new(
						1.2,
						1.2,
						1.2
					)

			else

				marker.Part.Size =
					Vector3.new(
						1,
						1,
						1
					)
			end
		end
	end
end

-- ==========================================================
-- FIXED DIRECT WALK
-- ==========================================================
--
-- Humanoid:Move() can be overwritten by PlayerModule.
--
-- MoveTo() gives Humanoid an actual destination and is much
-- more reliable for autonomous walking.
--
-- ==========================================================

local function directWalk(
	targetPosition,
	arrivalDistance,
	runId
)

	arrivalDistance =
		arrivalDistance
		or SETTINGS.DirectArrivalDistance

	local started =
		os.clock()

	local lastRefresh =
		0

	local lastStuckCheck =
		os.clock()

	local _,
		_,
		firstRoot =
		getCharacter()

	local lastPosition =
		firstRoot
		and firstRoot.Position
		or nil

	while alive do

		if stopRequested
			or runId ~= routeId
		then

			stopMovement()

			return false,
				"Stopped"
		end

		local character,
			humanoid,
			root =
			getCharacter()

		if not character then

			return false,
				"No character"
		end

		local difference =
			targetPosition
			- root.Position

		local horizontalDistance =
			Vector3.new(
				difference.X,
				0,
				difference.Z
			).Magnitude

		-- ==================================================
		-- ARRIVAL
		-- ==================================================

		if horizontalDistance
			<= arrivalDistance
		then

			stopMovement()

			return true
		end

		-- ==================================================
		-- OPTIONAL TIMEOUT
		-- ==================================================

		if SETTINGS.DirectTimeout > 0
			and os.clock()
				- started
				>= SETTINGS.DirectTimeout
		then

			stopMovement()

			return false,
				"Direct timeout"
		end

		-- ==================================================
		-- REFRESH MOVETO
		-- ==================================================

		if os.clock()
			- lastRefresh
			>= SETTINGS.DirectRefreshRate
		then

			humanoid:
				MoveTo(
					targetPosition
				)

			lastRefresh =
				os.clock()
		end

		-- ==================================================
		-- STUCK CHECK
		-- ==================================================

		if os.clock()
			- lastStuckCheck
			>= SETTINGS.DirectStuckCheckInterval
		then

			if lastPosition then

				local moved =
					(
						root.Position
						- lastPosition
					).Magnitude

				if moved
					<= SETTINGS.DirectMinimumMovement
				then

					if SETTINGS.DirectAutoJump then

						humanoid.Jump =
							true
					end

					-- Force MoveTo again after jump.

					humanoid:
						MoveTo(
							targetPosition
						)
				end
			end

			lastPosition =
				root.Position

			lastStuckCheck =
				os.clock()
		end

		RunService.Heartbeat:
			Wait()
	end

	return false
end

-- ==========================================================
-- PATHFIND WALK
-- ==========================================================

local function pathfindWalk(
	targetPosition,
	arrivalDistance,
	runId
)

	arrivalDistance =
		arrivalDistance
		or SETTINGS.FinalWaypointDistance

	for retry = 1,
		SETTINGS.MaxPathRetries
	do

		if stopRequested
			or runId ~= routeId
		then

			return false,
				"Stopped"
		end

		local character,
			humanoid,
			root =
			getCharacter()

		if not character then

			return false,
				"No character"
		end

		local path =
			PathfindingService:
				CreatePath({

					AgentRadius =
						SETTINGS.AgentRadius,

					AgentHeight =
						SETTINGS.AgentHeight,

					AgentCanJump =
						SETTINGS.AgentCanJump,

					WaypointSpacing =
						SETTINGS.WaypointSpacing
				})

		local calculated =
			pcall(function()

				path:
					ComputeAsync(
						root.Position,
						targetPosition
					)
			end)

		if calculated
			and path.Status
				== Enum.PathStatus.Success
		then

			local waypoints =
				path:
					GetWaypoints()

			local failed =
				false

			for waypointIndex,
				waypoint in ipairs(
					waypoints
				)
			do

				if stopRequested
					or runId ~= routeId
				then

					stopMovement()

					return false,
						"Stopped"
				end

				if waypoint.Action
					== Enum.PathWaypointAction.Jump
				then

					humanoid.Jump =
						true
				end

				local finalWaypoint =
					waypointIndex
					== #waypoints

				local distanceNeeded =
					finalWaypoint
					and arrivalDistance
					or SETTINGS.IntermediateWaypointDistance

				local waypointStarted =
					os.clock()

				local lastPosition =
					root.Position

				local stuckCheck =
					os.clock()

				humanoid:
					MoveTo(
						waypoint.Position
					)

				while alive do

					if stopRequested
						or runId ~= routeId
					then

						stopMovement()

						return false,
							"Stopped"
					end

					character,
						humanoid,
						root =
						getCharacter()

					if not character then

						return false,
							"Character lost"
					end

					local difference =
						waypoint.Position
						- root.Position

					local horizontalDistance =
						Vector3.new(
							difference.X,
							0,
							difference.Z
						).Magnitude

					if horizontalDistance
						<= distanceNeeded
					then

						break
					end

					if os.clock()
						- waypointStarted
						>= SETTINGS.WaypointTimeout
					then

						failed =
							true

						break
					end

					-- Refresh MoveTo occasionally.

					humanoid:
						MoveTo(
							waypoint.Position
						)

					if os.clock()
						- stuckCheck
						>= SETTINGS.PathStuckCheckInterval
					then

						local moved =
							(
								root.Position
								- lastPosition
							).Magnitude

						if moved
							<= SETTINGS.PathMinimumMovement
						then

							humanoid.Jump =
								true

							humanoid:
								MoveTo(
									waypoint.Position
								)
						end

						lastPosition =
							root.Position

						stuckCheck =
							os.clock()
					end

					RunService.Heartbeat:
						Wait()
				end

				if failed then
					break
				end
			end

			if not failed then

				stopMovement()

				return true
			end
		end

		task.wait(
			0.15
		)
	end

	stopMovement()

	return false,
		"Path failed"
end

-- ==========================================================
-- WALK ROUTER
-- ==========================================================

local function walkTo(
	position,
	distance,
	runId
)

	if SETTINGS.MovementMode
		== "Direct"
	then

		return directWalk(
			position,
			distance,
			runId
		)

	else

		return pathfindWalk(
			position,
			distance,
			runId
		)
	end
end

-- ==========================================================
-- MOVING PROXIMITY TARGET
-- ==========================================================

local function moveNearTarget(
	node,
	runId
)

	local target =
		node.Target

	if not target
		or not target.Parent
	then

		return false,
			"Target missing"
	end

	local requiredDistance =
		node.Distance
		or SETTINGS.DefaultProximityDistance

	local lastMoveRefresh =
		0

	local lastStuckCheck =
		os.clock()

	local previousPosition =
		nil

	while alive do

		if stopRequested
			or runId ~= routeId
		then

			stopMovement()

			return false,
				"Stopped"
		end

		local targetPosition =
			getInstancePosition(
				target
			)

		local character,
			humanoid,
			root =
			getCharacter()

		if not targetPosition
			or not character
		then

			return false,
				"Target lost"
		end

		local difference =
			targetPosition
			- root.Position

		local horizontalDistance =
			Vector3.new(
				difference.X,
				0,
				difference.Z
			).Magnitude

		if horizontalDistance
			<= requiredDistance
		then

			stopMovement()

			return true
		end

		-- ==================================================
		-- DIRECT MODE
		--
		-- MoveTo gets refreshed with live target position.
		-- ==================================================

		if SETTINGS.MovementMode
			== "Direct"
		then

			if os.clock()
				- lastMoveRefresh
				>= SETTINGS.DirectRefreshRate
			then

				humanoid:
					MoveTo(
						targetPosition
					)

				lastMoveRefresh =
					os.clock()
			end

			if not previousPosition then

				previousPosition =
					root.Position
			end

			if os.clock()
				- lastStuckCheck
				>= SETTINGS.DirectStuckCheckInterval
			then

				local moved =
					(
						root.Position
						- previousPosition
					).Magnitude

				if moved
					<= SETTINGS.DirectMinimumMovement
					and SETTINGS.DirectAutoJump
				then

					humanoid.Jump =
						true

					humanoid:
						MoveTo(
							targetPosition
						)
				end

				previousPosition =
					root.Position

				lastStuckCheck =
					os.clock()
			end

			RunService.Heartbeat:
				Wait()

		else

			-- Pathfind toward latest target position.

			local success =
				pathfindWalk(
					targetPosition,
					math.max(
						1,
						requiredDistance
							- 1
					),
					runId
				)

			if not success then

				return false,
					"Could not reach target"
			end
		end
	end

	return false
end

-- ==========================================================
-- PRESS KEY
-- ==========================================================

local function pressKey(
	keyCode,
	duration
)

	VirtualInputManager:
		SendKeyEvent(
			true,
			keyCode,
			false,
			game
		)

	task.wait(
		math.max(
			0.03,
			duration or 0.08
		)
	)

	VirtualInputManager:
		SendKeyEvent(
			false,
			keyCode,
			false,
			game
		)
end

-- ==========================================================
-- PROMPT NODE
-- ==========================================================

local function executePrompt(
	node,
	runId
)

	local prompt =
		node.Prompt

	if not prompt
		or not prompt.Parent
		or not prompt:IsA(
			"ProximityPrompt"
		)
	then

		return false,
			"Prompt missing"
	end

	local promptPosition =
		getInstancePosition(
			prompt
		)

	if not promptPosition then

		return false,
			"No prompt position"
	end

	local distance =
		math.max(
			1,
			prompt.MaxActivationDistance
				- 1
		)

	local reached =
		walkTo(
			promptPosition,
			distance,
			runId
		)

	if not reached then

		return false,
			"Could not reach prompt"
	end

	if stopRequested
		or runId ~= routeId
	then

		return false,
			"Stopped"
	end

	task.wait(
		0.1
	)

	-- ======================================================
	-- EXECUTOR FIREPROMPT
	-- ======================================================

	local firePrompt =
		getgenv().
			fireproximityprompt

	if typeof(firePrompt)
		== "function"
	then

		local success =
			pcall(function()

				firePrompt(
					prompt
				)
			end)

		if success then

			return true
		end
	end

	-- ======================================================
	-- KEY FALLBACK
	-- ======================================================

	local key =
		prompt.KeyboardKeyCode

	if key
		== Enum.KeyCode.Unknown
	then

		return false,
			"No keyboard key"
	end

	pressKey(
		key,
		prompt.HoldDuration
			+ 0.1
	)

	return true
end

-- ==========================================================
-- EXECUTE NODE
-- ==========================================================

local function executeNode(
	node,
	runId
)

	if node.Type == "Walk" then

		if typeof(
			node.Position
		)
			~= "Vector3"
		then

			return false,
				"No position"
		end

		return walkTo(
			node.Position,
			SETTINGS.MovementMode
				== "Direct"
				and SETTINGS.DirectArrivalDistance
				or SETTINGS.FinalWaypointDistance,
			runId
		)

	elseif node.Type == "Wait" then

		local duration =
			math.max(
				0,
				node.Duration
					or 2
			)

		local started =
			os.clock()

		while os.clock()
			- started
			< duration
		do

			if stopRequested
				or runId ~= routeId
			then

				return false,
					"Stopped"
			end

			task.wait(
				0.05
			)
		end

		return true

	elseif node.Type == "Proximity" then

		return moveNearTarget(
			node,
			runId
		)

	elseif node.Type == "Prompt" then

		return executePrompt(
			node,
			runId
		)

	elseif node.Type == "Jump" then

		local _,
			humanoid =
			getCharacter()

		if humanoid then

			humanoid.Jump =
				true

			task.wait(
				0.15
			)

			return true
		end

	elseif node.Type == "Key" then

		if node.KeyCode then

			pressKey(
				node.KeyCode,
				node.HoldDuration
					or 0.08
			)

			return true
		end
	end

	return false,
		"Unknown node"
end

