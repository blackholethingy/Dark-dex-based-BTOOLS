-- ==========================================================
-- FIND PROMPT
-- ==========================================================

local function findPrompt(
	part
)

	if not part then

		return nil
	end

	local prompt =
		part:
			FindFirstChildWhichIsA(
				"ProximityPrompt",
				true
			)

	if prompt then

		return prompt
	end

	local current =
		part.Parent

	for _ = 1, 6 do

		if not current then

			break
		end

		local found =
			current:
				FindFirstChildWhichIsA(
					"ProximityPrompt",
					true
				)

		if found then

			return found
		end

		current =
			current.Parent
	end

	return nil
end

