track(
	mouse.Button1Down:
		Connect(function()

			if not placementMode then

				return
			end

			local target =
				mouse.Target

			if placementMode
				== "Walk"
			then

				addNode({

					Type =
						"Walk",

					Position =
						mouse.Hit.Position
				})

				placementMode =
					nil

			elseif placementMode
				== "Proximity"
			then

				if target then

					addNode({

						Type =
							"Proximity",

						Target =
							target,

						Distance =
							SETTINGS.DefaultProximityDistance
					})
				end

				placementMode =
					nil

			elseif placementMode
				== "Prompt"
			then

				local prompt =
					findPrompt(
						target
					)

				if prompt then

					addNode({

						Type =
							"Prompt",

						Prompt =
							prompt
					})

				else

					status.Text =
						"No prompt found."
				end

				placementMode =
					nil

			elseif selectedNodeIndex then

				local node =
					nodes[
						selectedNodeIndex
					]

				if placementMode
					== "EditWalk"
				then

					node.Position =
						mouse.Hit.Position

					placementMode =
						nil

					rebuildList()

				elseif placementMode
					== "EditProximity"
				then

					if target then

						node.Target =
							target

						placementMode =
							nil

						rebuildList()
					end

				elseif placementMode
					== "EditPrompt"
				then

					local prompt =
						findPrompt(
							target
						)

					if prompt then

						node.Prompt =
							prompt

						placementMode =
							nil

						rebuildList()
					end
				end
			end
		end)
