	end)

-- ==========================================================
-- LIVE MARKERS
-- ==========================================================

local accumulator =
	0

track(
	RunService.RenderStepped:
		Connect(function(dt)

			if not alive then
				return
			end

			accumulator += dt

			if accumulator < 0.1 then
				return
			end

			accumulator = 0

			updateMarkers()
		end)
)

