-- ==========================================================
-- BACKUP COLLIDERS
-- ==========================================================

local function createBackupCollider(
	torsoPart,
	index
)

	local collider =
		Instance.new("Part")

	collider.Name =
		"RagdollTorsoCollider_"
		.. tostring(index)

	collider.Size =
		Vector3.new(

			math.max(
				0.5,
				torsoPart.Size.X
					* 0.88
			),

			math.max(
				0.5,
				torsoPart.Size.Y
					* 0.88
			),

			math.max(
				0.5,
				torsoPart.Size.Z
					* 0.78
			)
		)

	collider.CFrame =
		torsoPart.CFrame

	collider.Transparency =
		1

	collider.CastShadow =
		false

	collider.Anchored =
		false

	collider.Massless =
		true

	collider.CanCollide =
		true

	collider.CanTouch =
		true

	collider.CanQuery =
		false

	if config.ZeroFriction then

		collider.CustomPhysicalProperties =
			ZERO_FRICTION_PROPERTIES

	else

		collider.CustomPhysicalProperties =
			NORMAL_COLLIDER_PROPERTIES
	end

	collider.Parent =
		character

	local weld =
		Instance.new(
			"WeldConstraint"
		)

	weld.Part0 =
		torsoPart

	weld.Part1 =
		collider

	weld.Parent =
		collider

	remember(
		collider
	)

	remember(
		weld
	)

	return collider
end

local function createBackupTorsoColliders()

	local colliders = {}

	if not config.BackupTorsoCollider
		or not config.TorsoOnlyCollision
	then

		return colliders
	end

	for index, torsoPart in ipairs(
		getTorsoParts()
	) do

		table.insert(
			colliders,

			createBackupCollider(
				torsoPart,
				index
			)
		)
	end

	return colliders
end

-- ==========================================================
-- APPLY FRICTION
-- ==========================================================

local function applyRagdollFriction()

	if not ragdolled then
		return
	end

	local torsoParts =
		getTorsoParts()

	if config.ZeroFriction then

		for _, part in ipairs(
			torsoParts
		) do

			part.CustomPhysicalProperties =
				ZERO_FRICTION_PROPERTIES
		end

		for _, object in ipairs(
			character:GetChildren()
		) do

			if object:IsA("BasePart")
				and string.find(
					object.Name,
					"RagdollTorsoCollider_",
					1,
					true
				) == 1
			then

				object.CustomPhysicalProperties =
					ZERO_FRICTION_PROPERTIES
			end
		end

		if not config.TorsoOnlyCollision then

			for _, object in ipairs(
				character:GetDescendants()
			) do

				if object:IsA("BasePart")
					and object ~= root
				then

					object.CustomPhysicalProperties =
						ZERO_FRICTION_PROPERTIES
				end
			end
		end

	else

		-- Restore real body parts.

		for _, object in ipairs(
			character:GetDescendants()
		) do

			if object:IsA("BasePart") then

				local stored =
					originalPhysicalProperties[
						object
					]

				if stored then

					object.CustomPhysicalProperties =
						stored.Value
				end
			end
		end

		-- Backup colliders didn't exist when
		-- original properties were saved.

		for _, object in ipairs(
			character:GetChildren()
		) do

			if object:IsA("BasePart")
				and string.find(
					object.Name,
					"RagdollTorsoCollider_",
					1,
					true
				) == 1
			then

				object.CustomPhysicalProperties =
					NORMAL_COLLIDER_PROPERTIES
			end
		end
	end
end

-- ==========================================================
-- COLLISION ENFORCEMENT
-- ==========================================================

local function isTorsoPart(
	part
)

	for _, torsoPart in ipairs(
		getTorsoParts()
	) do

		if torsoPart == part then
			return true
		end
	end

	return false
end

local function enforceRagdollCollision()

	if not ragdolled then
		return
	end

	if config.TorsoOnlyCollision then

		for _, object in ipairs(
			character:GetDescendants()
		) do

			if object:IsA("BasePart") then

				object.CanCollide =
					false
			end
		end

		for _, torsoPart in ipairs(
			getTorsoParts()
		) do

			torsoPart.CanCollide =
				true

			torsoPart.CanTouch =
				true
		end

		root.CanCollide =
			false

		for _, object in ipairs(
			character:GetChildren()
		) do

			if object:IsA("BasePart")
				and string.find(
					object.Name,
					"RagdollTorsoCollider_",
					1,
					true
				) == 1
			then

				object.CanCollide =
					true

				object.CanTouch =
					true
			end
		end

	else

		for _, object in ipairs(
			character:GetChildren()
		) do

			if object:IsA("BasePart") then

				object.CanCollide =
					true
			end
		end

		root.CanCollide =
			false
	end

	applyRagdollFriction()
end

-- ==========================================================
-- BOUNCE RAY PARAMS
-- ==========================================================

local bounceParams =
	RaycastParams.new()

bounceParams.FilterType =
	Enum.RaycastFilterType.Exclude

bounceParams.FilterDescendantsInstances =
	{ character }

bounceParams.IgnoreWater =
	false

bounceParams.RespectCanCollide =
	true

-- ==========================================================
-- BOUNCE HELPERS
-- ==========================================================

local function reflectVelocity(
	velocity,
	normal
)

	return velocity
		- (
			2
			* velocity:Dot(normal)
			* normal
		)
end

local function randomizedDirection(
	direction
)

	if direction.Magnitude < 0.001 then

		return Vector3.yAxis
	end

	direction =
		direction.Unit

	local maxAngle =
		config.BounceAngle

	local pitch =
		math.rad(
			math.random(
				-maxAngle * 100,
				maxAngle * 100
			) / 100
		)

	local yaw =
		math.rad(
			math.random(
				-maxAngle * 100,
				maxAngle * 100
			) / 100
		)

	local cf =
		CFrame.lookAt(
			Vector3.zero,
			direction
		)

	return (
		cf
		* CFrame.Angles(
			pitch,
			yaw,
			0
		)
	).LookVector.Unit
end

-- ==========================================================
-- ESTIMATE SURFACE NORMAL
-- ==========================================================

local function estimateNormal(
	contactPart,
	incomingVelocity,
	sourcePart
)

	if incomingVelocity.Magnitude
		< 0.001
	then

		return nil
	end

	local direction =
		incomingVelocity.Unit

	local origin =
		sourcePart.Position
		- direction * 2

	local result =
		Workspace:Raycast(

			origin,

			direction * 6,

			bounceParams
		)

	if result
		and result.Instance
		== contactPart
	then

		return result.Normal.Unit
	end

	-- Center-to-center fallback.

	local difference =
		sourcePart.Position
		- contactPart.Position

	if difference.Magnitude
		> 0.001
	then

		return difference.Unit
	end

	return -direction
end

-- ==========================================================
-- PROCESS REAL PHYSICAL CONTACT
-- ==========================================================

local function processBounce(
	sourcePart,
	contactPart
)

	if not running
		or not ragdolled
		or not config.Bounce
	then

		return
	end

	if not contactPart
		or not contactPart:IsA("BasePart")
	then

		return
	end

	if contactPart:IsDescendantOf(
		character
	) then

		return
	end

	if not contactPart.CanCollide then
		return
	end

	local incoming =
		lastPhysicsVelocity

	local speed =
		incoming.Magnitude

	if speed
		< config.BounceMinSpeed
	then

		return
	end

	local now =
		os.clock()

	if now - lastBounceTime
		< config.BounceCooldown
	then

		return
	end

	local normal =
		estimateNormal(
			contactPart,
			incoming,
			sourcePart
		)

	if not normal then
		return
	end

	-- Must actually be travelling toward surface.

	if incoming:Dot(normal)
		>= -0.15
	then

		return
	end

	local reflected =
		reflectVelocity(
			incoming,
			normal
		)

	if reflected.Magnitude
		< 0.001
	then

		reflected =
			normal
	end

	local direction =
		randomizedDirection(
			reflected
		)

	-- Prevent random result pointing back into wall.

	if direction:Dot(normal)
		< 0.2
	then

		direction =
			direction
			+ normal * 0.9

		if direction.Magnitude
			> 0.001
		then

			direction =
				direction.Unit
		else

			direction =
				normal
		end
	end

	local outputVelocity =
		direction
		* speed
		* config.BouncePower

	lastBounceTime =
		now

	-- Let Roblox finish collision resolution first.

	task.defer(function()

		if not running
			or not ragdolled
			or not config.Bounce
		then

			return
		end

		local primaryTorso =
			getPrimaryTorso()

		if primaryTorso then

			primaryTorso.AssemblyLinearVelocity =
				outputVelocity

			primaryTorso.AssemblyAngularVelocity +=
				Vector3.new(
					math.random(-6, 6),
					math.random(-6, 6),
					math.random(-6, 6)
				)
		end

		root.AssemblyLinearVelocity =
			outputVelocity
	end)
end

-- ==========================================================
-- START BOUNCE LISTENERS
-- ==========================================================

local function startBounceSystem(
	backupColliders
)

	lastBounceTime =
		0

	local primaryTorso =
		getPrimaryTorso()

	if primaryTorso then

		lastPhysicsVelocity =
			primaryTorso.AssemblyLinearVelocity
	end

	-- Track incoming velocity before contacts alter it.

	trackRagdoll(

		RunService.PreSimulation:
			Connect(function()

				if not running
					or not ragdolled
				then

					return
				end

				local torsoPart =
					getPrimaryTorso()

				if not torsoPart then
					return
				end

				local velocity =
					torsoPart.AssemblyLinearVelocity

				if velocity.Magnitude
					> 0.1
				then

					lastPhysicsVelocity =
						velocity
				end
			end)
	)

	-- Real torso parts.

	for _, torsoPart in ipairs(
		getTorsoParts()
	) do

		trackRagdoll(

			torsoPart.Touched:
				Connect(function(hit)

					processBounce(
						torsoPart,
						hit
					)
				end)
		)
	end

	-- Backup colliders.

	for _, collider in ipairs(
		backupColliders
	) do

		trackRagdoll(

			collider.Touched:
				Connect(function(hit)

					processBounce(
						collider,
						hit
					)
				end)
		)
	end
end

-- ==========================================================
-- DESTROY RAGDOLL OBJECTS
-- ==========================================================

local function destroyRagdollObjects()

	for _, object in ipairs(
		ragdollObjects
	) do

		if object
			and object.Parent
		then

			pcall(function()
				object:Destroy()
			end)
		end
	end

	table.clear(
		ragdollObjects
	)
end

-- ==========================================================
-- UPRIGHT RECOVERY
-- ==========================================================

local function makeRootUpright()

	local primaryTorso =
		getPrimaryTorso()

	if not primaryTorso then
		return
	end

	local look =
		root.CFrame.LookVector

	local flat =
		Vector3.new(
			look.X,
			0,
			look.Z
		)

	if flat.Magnitude
		< 0.01
	then

		flat =
			Vector3.new(
				0,
				0,
				-1
			)
	end

	flat =
		flat.Unit

	root.CFrame =
		CFrame.lookAt(

			primaryTorso.Position,

			primaryTorso.Position
				+ flat,

			Vector3.yAxis
		)
end

-- ==========================================================
-- FORWARD DECLARATION
-- ==========================================================

local unragdoll

-- ==========================================================
-- RAGDOLL
-- ==========================================================

local function ragdoll(
	savedVelocity,
	savedAngularVelocity
)

	if not running
		or ragdolled
	then

		return
	end

	doingTrick =
		false

	autoGetUpToken +=
		1

	local token =
		autoGetUpToken

	local primaryTorso =
		getPrimaryTorso()

	if not primaryTorso then
		return
	end

	local velocity =
		savedVelocity
		or root.AssemblyLinearVelocity

	local angularVelocity =
		savedAngularVelocity
		or root.AssemblyAngularVelocity

	-- Save normal state.

	saveMotorStates()

	saveCollisionStates()

	savePhysicalProperties()

	ragdolled =
		true

	-- Physics humanoid.

	humanoid.AutoRotate =
		false

	humanoid.PlatformStand =
		true

	humanoid:ChangeState(
		Enum.HumanoidStateType.Physics
	)

	-- Convert body motors to constraints.

	createRagdollConstraints()

	disableMotors()

	-- Backup torso shells.

	local backupColliders =
		createBackupTorsoColliders()

	-- Collision setup.

	enforceRagdollCollision()

	if collisionEnforcer then

		collisionEnforcer:
			Disconnect()
	end

	collisionEnforcer =
		RunService.PostSimulation:
			Connect(function()

				if running
					and ragdolled
				then

					enforceRagdollCollision()
				end
			end)

	-- Bounce.

	startBounceSystem(
		backupColliders
	)

	-- Momentum.

	if config.PreserveMomentum then

		primaryTorso.AssemblyLinearVelocity =
			velocity

		root.AssemblyLinearVelocity =
			velocity

		primaryTorso.AssemblyAngularVelocity =
			angularVelocity
	end

	-- Extra flop.

	if config.ExtraFlop then

		primaryTorso.AssemblyAngularVelocity +=
			Vector3.new(
				math.random(-8, 8),
				math.random(-5, 5),
				math.random(-8, 8)
			)
	end

	-- Auto get-up.

	if config.AutoGetUp then

		task.delay(
			config.AutoGetUpDelay,

			function()

				if running
					and ragdolled
					and token
						== autoGetUpToken
				then

					unragdoll()
				end
			end)
	end
end

-- ==========================================================
-- UNRAGDOLL
-- ==========================================================

unragdoll =
	function()

		if not ragdolled then
			return
		end

		autoGetUpToken +=
			1

		disconnectRagdollConnections()

		if collisionEnforcer then

			collisionEnforcer:
				Disconnect()

			collisionEnforcer =
				nil
		end

		ragdolled =
			false

		destroyRagdollObjects()

		restoreMotors()

		restoreCollisionStates()

		restorePhysicalProperties()

		makeRootUpright()

		local primaryTorso =
			getPrimaryTorso()

		root.AssemblyAngularVelocity =
			Vector3.zero

		if primaryTorso then

			primaryTorso.AssemblyAngularVelocity =
				Vector3.zero
		end

		humanoid.PlatformStand =
			false

		humanoid.AutoRotate =
			true

		humanoid:ChangeState(
			Enum.HumanoidStateType.GettingUp
		)
	end

-- ==========================================================
-- TOGGLE RAGDOLL
-- ==========================================================

local function toggleRagdoll()

	if doingTrick then
		return
	end

	if ragdolled then

		unragdoll()

	else

		ragdoll()
	end
end

-- ==========================================================
-- STUNT HELPERS
-- ==========================================================

local function stuntFails()

	return math.random(
		1,
		100
	) <= config.FailureChance
end

local function beginTrick()

	if not running
		or ragdolled
		or doingTrick
	then

		return false
	end

	doingTrick =
		true

	humanoid.AutoRotate =
		false

	humanoid.PlatformStand =
		true

	humanoid:ChangeState(
		Enum.HumanoidStateType.Physics
	)

	return true
end

local function finishTrick()

	if not running
		or ragdolled
		or not doingTrick
	then

		return
	end

	root.AssemblyAngularVelocity =
		Vector3.zero

	humanoid.PlatformStand =
		false

	humanoid.AutoRotate =
		true

	humanoid:ChangeState(
		Enum.HumanoidStateType.Running
	)

	doingTrick =
		false
end

local function failTrick()

	if not running
		or ragdolled
		or not doingTrick
	then

		return
	end

	ragdoll(
		root.AssemblyLinearVelocity,
		root.AssemblyAngularVelocity
	)
end

-- ==========================================================
-- FRONTFLIP
-- ==========================================================

local function frontflip()

	if not beginTrick() then
		return
	end

	root:ApplyImpulse(

		(
			root.CFrame.LookVector * 16

			+ Vector3.new(
				0,
				config.FrontflipPower,
				0
			)
		)

		* root.AssemblyMass
	)

	root.AssemblyAngularVelocity =
		root.CFrame.RightVector
		* -config.FlipAngularSpeed

	if stuntFails() then

		task.delay(
			math.random(28, 58)
				/ 100,

			failTrick
		)

	else

		task.delay(
			0.9,
			finishTrick
		)
	end
end

-- ==========================================================
-- BACKFLIP
-- ==========================================================

local function backflip()

	if not beginTrick() then
		return
	end

	root:ApplyImpulse(

		(
			-root.CFrame.LookVector * 8

			+ Vector3.new(
				0,
				config.BackflipPower,
				0
			)
		)

		* root.AssemblyMass
	)

	root.AssemblyAngularVelocity =
		root.CFrame.RightVector
		* config.FlipAngularSpeed

	if stuntFails() then

		task.delay(
			math.random(28, 58)
				/ 100,

			failTrick
		)

	else

		task.delay(
			0.9,
			finishTrick
		)
	end
end

-- ==========================================================
-- DIVE
-- ==========================================================

local function dive()

	if not beginTrick() then
		return
	end

	root:ApplyImpulse(

		(
			root.CFrame.LookVector
				* config.DiveForwardPower

			+ Vector3.new(
				0,
				config.DiveUpPower,
				0
			)
		)

		* root.AssemblyMass
	)

	root.AssemblyAngularVelocity =
		root.CFrame.RightVector
		* -4

	if stuntFails() then

		task.delay(
			0.35,
			failTrick
		)

	else

		task.delay(
			0.8,
			finishTrick
		)
	end
end

-- ==========================================================
-- SPIN
-- ==========================================================

local function spinJump()

	if not beginTrick() then
		return
	end

	root:ApplyImpulse(

		Vector3.new(
			0,
			config.SpinPower,
			0
		)

		* root.AssemblyMass
	)

	root.AssemblyAngularVelocity =
		Vector3.new(
			0,
			config.SpinAngularSpeed,
			0
		)

	if stuntFails() then

		task.delay(
			0.45,
			failTrick
		)

	else

		task.delay(
			0.85,
			finishTrick
		)
	end
end

