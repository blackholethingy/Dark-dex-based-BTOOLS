-- MOTOR COLLECTION
-- ==========================================================

local function getBodyMotors()

	local motors = {}

	for _, object in ipairs(
		character:GetDescendants()
	) do

		if object:IsA("Motor6D")
			and object.Part0
			and object.Part1
			and object.Part0:IsDescendantOf(
				character
			)
			and object.Part1:IsDescendantOf(
				character
			)
		then

			table.insert(
				motors,
				object
			)
		end
	end

	return motors
end

