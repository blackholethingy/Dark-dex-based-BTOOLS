-- CLEANUP
-- ==========================================================

local function cleanup()

	if not running then
		return
	end

	running =
		false

	autoGetUpToken +=
		1

	doingTrick =
		false

	awaitingBind =
		nil

	disconnectRagdollConnections()

	if collisionEnforcer then

		collisionEnforcer:
			Disconnect()

		collisionEnforcer =
			nil
	end

	destroyRagdollObjects()

	restoreMotors()

	restoreCollisionStates()

	restorePhysicalProperties()

	ragdolled =
		false

	pcall(
		makeRootUpright
	)

	root.AssemblyAngularVelocity =
		Vector3.zero

	humanoid.PlatformStand =
		false

	humanoid.AutoRotate =
		true

	pcall(function()

		humanoid:ChangeState(
			Enum.HumanoidStateType.GettingUp
		)

	end)

	for _, connection in ipairs(
		connections
	) do

		pcall(function()

			connection:
				Disconnect()

		end)
	end

	table.clear(
		connections
	)

	if gui then
		gui:Destroy()
	end

	_G.UniversalRagdollCleanup =
		nil

	_G.R6StuntCleanup =
		nil

	print(
		"Universal R6/R15 Ragdoll Lab killed."
	)
end

_G.UniversalRagdollCleanup =
	cleanup

_G.R6StuntCleanup =
	cleanup

killButton.MouseButton1Click:
	Connect(
		cleanup
	)

