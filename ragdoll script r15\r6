track(

	UserInputService.InputBegan:
		Connect(function(
			input,
			processed
		)

			if processed
				or not running
			then

				return
			end

			if input.UserInputType
				~= Enum.UserInputType.Keyboard
			then

				return
			end

			if awaitingBind then

				local actionName =
					awaitingBind

				binds[actionName] =
					input.KeyCode

				awaitingBind =
					nil

				if bindRefreshers[
					actionName
				] then

					bindRefreshers[
						actionName
					]()
				end

				return
			end

			for actionName,
				keyCode in pairs(
					binds
				)
			do

				if input.KeyCode
					== keyCode
				then

					local action =
						actions[
							actionName
						]

					if action then
						action()
					end

					return
				end
			end
		end)
)

