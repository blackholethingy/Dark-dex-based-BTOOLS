-- ==========================================================
-- PHYSICAL PROPERTY STATE
-- ==========================================================

local function savePhysicalProperties()

	originalPhysicalProperties = {}

	for _, object in ipairs(
		character:GetDescendants()
	) do

		if object:IsA("BasePart") then

			-- Wrapper is needed because the property
			-- itself is allowed to be nil.

			originalPhysicalProperties[
				object
			] = {

				Value =
					object.CustomPhysicalProperties
			}
		end
	end
end

local function originalProperties(part)

	local entry =
		originalPhysicalProperties[
			part
		]

	if entry then

		return entry.Value
	end

	return nil
end

local function restorePhysicalProperties()

	for part, data in pairs(
		originalPhysicalProperties
	) do

		if part
			and part.Parent
		then

			part.CustomPhysicalProperties =
				data.Value
		end
	end

	originalPhysicalProperties = {}
end

