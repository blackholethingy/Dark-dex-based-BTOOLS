local function remember(object)

	table.insert(
		ragdollObjects,
		object
	)

	return object
end

-- ==========================================================
-- ATTACHMENT
-- ==========================================================

local function createAttachment(
	part,
	cframe,
	name
)

	local attachment =
		Instance.new(
			"Attachment"
		)

	attachment.Name =
		name

	attachment.CFrame =
		cframe

	attachment.Parent =
		part

	return remember(
		attachment
	)
end

-- ==========================================================
-- CREATE SOCKET FROM MOTOR
-- ==========================================================

local function createSocketForMotor(
	motor
)

	if not motor
		or not motor.Part0
		or not motor.Part1
	then

		return
	end

	local a0 =
		createAttachment(
			motor.Part0,
			motor.C0,
			"RD_"
				.. motor.Name
				.. "_A0"
		)

	local a1 =
		createAttachment(
			motor.Part1,
			motor.C1,
			"RD_"
				.. motor.Name
				.. "_A1"
		)

	local socket =
		Instance.new(
			"BallSocketConstraint"
		)

	socket.Name =
		"RD_"
		.. motor.Name

	socket.Attachment0 =
		a0

	socket.Attachment1 =
		a1

	socket.Restitution =
		0

	if config.Boneless then

		socket.LimitsEnabled =
			false

		socket.TwistLimitsEnabled =
			false

	else

		socket.LimitsEnabled =
			true

		socket.UpperAngle =
			100

		socket.TwistLimitsEnabled =
			true

		socket.TwistLowerAngle =
			-90

		socket.TwistUpperAngle =
			90
	end

	socket.Parent =
		motor.Part0

	remember(
		socket
	)
end

-- ==========================================================
-- MOTOR STATE
-- ==========================================================

local function saveMotorStates()

	originalMotorStates = {}

	for _, motor in ipairs(
		getBodyMotors()
	) do

		originalMotorStates[motor] =
			motor.Enabled
	end
end

local function createRagdollConstraints()

	for _, motor in ipairs(
		getBodyMotors()
	) do

		createSocketForMotor(
			motor
		)
	end
end

local function disableMotors()

	for _, motor in ipairs(
		getBodyMotors()
	) do

		motor.Enabled =
			false
	end
end

local function restoreMotors()

	for motor, state in pairs(
		originalMotorStates
	) do

		if motor
			and motor.Parent
		then

			motor.Enabled =
				state
		end
	end

	originalMotorStates = {}
end

