-- ==========================================================
-- CONNECTION HELPERS
-- ==========================================================

local function track(connection)

	table.insert(
		connections,
		connection
	)

	return connection
end

local function trackRagdoll(connection)

	table.insert(
		ragdollConnections,
		connection
	)

	return connection
end

local function disconnectRagdollConnections()

	for _, connection in ipairs(
		ragdollConnections
	) do

		pcall(function()

			connection:
				Disconnect()

		end)
	end

	table.clear(
		ragdollConnections
	)
end

-- ==========================================================
-- DETECT RIG
-- ==========================================================

local function getDetectedRig()

	if humanoid.RigType
		== Enum.HumanoidRigType.R15
	then

		return "R15"
	end

	return "R6"
end

local function getActiveRig()

	local detected =
		getDetectedRig()

	if config.RigMode
		== "Auto"
	then

		return detected
	end

	-- You can't actually turn an R15 avatar into R6
	-- just by changing a setting.
	--
	-- If forced mode doesn't match the real avatar,
	-- safely use the actual rig.

	if config.RigMode
		~= detected
	then

		return detected
	end

	return config.RigMode
end

-- ==========================================================
-- TORSO PARTS
-- ==========================================================

local function getTorsoParts()

	local rig =
		getActiveRig()

	if rig == "R15" then

		local result = {}

		local upper =
			character:
				FindFirstChild(
					"UpperTorso"
				)

		local lower =
			character:
				FindFirstChild(
					"LowerTorso"
				)

		if upper then

			table.insert(
				result,
				upper
			)
		end

		if lower then

			table.insert(
				result,
				lower
			)
		end

		return result
	end

	local torso =
		character:
			FindFirstChild(
				"Torso"
			)

	if torso then

		return {
			torso
		}
	end

	return {}
end

local function getPrimaryTorso()

	local rig =
		getActiveRig()

	if rig == "R15" then

		return character:
			FindFirstChild(
				"LowerTorso"
			)
			or character:
				FindFirstChild(
					"UpperTorso"
				)

	else

		return character:
			FindFirstChild(
				"Torso"
			)
	end
end

