-- ============================================================================

-- Anti-Anti-Cheat Safe Orbit Combat Framework
RunService.PostSimulation:Connect(function(deltaTime)
	if not config.ScriptRunning or not config.AutoCombat then return end
	
	local character, humanoid, hrp = getLocalCharacterState()
	if not character or not humanoid or not hrp then return end
	
	local target = getSmartCombatTarget()
	if target and target:FindFirstChild("HumanoidRootPart") then
		local enemyHrp = target.HumanoidRootPart
		local distance = (hrp.Position - enemyHrp.Position).Magnitude
		
		local backpack = player:FindFirstChild("Backpack")
		if backpack then
			local weapon = backpack:FindFirstChildOfClass("Tool")
			if weapon then 
				weapon.Parent = character 
			end
		end
		
		if config.SmartStrafe then
			strafeTick = strafeTick + (deltaTime * 6)
			
			if distance <= config.AttackReach then
				local repelVector = (hrp.Position - enemyHrp.Position).Unit
				humanoid:Move(Vector3.new(repelVector.X, 0, repelVector.Z), false)
			else
				local orbitRadius = 4.5
				local offsetX = math.sin(strafeTick) * orbitRadius
				local offsetZ = math.cos(strafeTick) * orbitRadius
				local desiredPosition = enemyHrp.Position + Vector3.new(offsetX, 0, offsetZ)
				
				local moveDirection = (desiredPosition - hrp.Position).Unit
				humanoid:Move(Vector3.new(moveDirection.X, 0, moveDirection.Z), false)
			end
			hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(enemyHrp.Position.X, hrp.Position.Y, enemyHrp.Position.Z))
		end
		
		if distance <= config.AttackReach then
			VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
			task.wait(0.01)
			VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
		end
	end
end)

-- Dedicated Post-Death Janitorial Engine Integration Loop
task.spawn(function()
	while config.ScriptRunning do
		local character, humanoid, hrp = getLocalCharacterState()
		
		if not character or not humanoid or not hrp then
			task.wait(0.5)
			continue
		end
		
		if config.AutoMop and (not config.AutoCombat or not getSmartCombatTarget()) then
			local backpack = player:FindFirstChild("Backpack")
			local ownedMop = backpack and (backpack:FindFirstChild("Mop") or backpack:FindFirstChild("Ignotus Mop")) 
				or character:FindFirstChild("Mop") or character:FindFirstChild("Ignotus Mop")
			
			-- MOP RECOVERY STATE: If killed/respawned without a mop, run retrieval logic
			if not ownedMop then
				local giver = getMopGiverAsset()
				if giver then
					local targetPos = giver:IsA("Model") and giver:GetPivot().Position or giver:IsA("BasePart") and giver.Position
					if not targetPos then
						local fallbackPart = giver:FindFirstChildWhichIsA("BasePart", true)
						targetPos = fallbackPart and fallbackPart.Position
					end

					if targetPos then
						currentTargetSpill = nil -- Suspend mopping to run tool retrieval
						walkToTarget(targetPos)
						
						if (hrp.Position - targetPos).Magnitude <= 8.5 then
							-- Deep search every descendant for ANY ProximityPrompt instance
							local prompt = nil
							for _, descendant in ipairs(giver:GetDescendants()) do
								if descendant:IsA("ProximityPrompt") then
									prompt = descendant
									break
								end
							end
							
							if prompt then
								-- Use executor native function if available, fallback to input simulation
								if fireproximityprompt then
									fireproximityprompt(prompt)
								else
									prompt:InputBegan(player)
									task.wait(0.05)
									prompt:InputEnded(player)
								end
								print("[Mop Recovery] Located and triggered hidden ProximityPrompt.")
							else
								-- Ultimate fallback: Mash 'E' key manually if prompt object is completely missing from the hierarchy
								VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
								task.wait(0.05)
								VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
								print("[Mop Recovery] No prompt instance found. Attempting manual key-mash fallback.")
							end
							task.wait(0.4) -- Buffer delay to allow inventory to process the asset swap
						end
					end
				else
					warn("[Mop Recovery] Error: 'Double Mop Giver' path could not be located inside workspace.")
					task.wait(2)
				end
				
				task.wait(0.1)
				continue
			end
			
			-- STANDARD AUTO-MOP LOOP (Fires instantly once inventory ownership is verified)
			if backpack and ownedMop and ownedMop.Parent == backpack then 
				ownedMop.Parent = character 
			end
			
			currentTargetSpill = findClosestSpill()
			if currentTargetSpill and currentTargetSpill.Parent then
				local targetPos = currentTargetSpill:IsA("BasePart") and currentTargetSpill.Position or currentTargetSpill:GetPivot().Position
				
				walkToTarget(targetPos)
				
				local interactionRange = (currentTargetSpill.Name == "Spill_Large") and 9.5 or 6.0
				
				if currentTargetSpill and currentTargetSpill.Parent and (hrp.Position - targetPos).Magnitude <= interactionRange then
					VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
					
					local holdTimeout = 0
					while currentTargetSpill and currentTargetSpill.Parent and holdTimeout < 5.0 do
						task.wait(0.1)
						holdTimeout = holdTimeout + 0.1
						if config.AutoCombat and getSmartCombatTarget() then break end
					end
					
					VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
					task.wait(0.05)
				end
			end
		end
		task.wait(0.1)
	end
end)

print("Part 2 - Block B execution loops started cleanly.")
