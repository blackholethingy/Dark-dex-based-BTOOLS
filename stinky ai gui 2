local function forceEquipMeleeWeapon(character, backpack)
	local activeTool = character:FindFirstChildOfClass("Tool")
	if activeTool and (string.find(string.lower(activeTool.Name), "fist") or string.find(string.lower(activeTool.Name), "bat") or string.find(string.lower(activeTool.Name), "knife") or string.find(string.lower(activeTool.Name), "melee")) then
		return activeTool
	end
	local weaponKeywords = {"knife", "bat", "fist", "melee"}
	for _, keyword in ipairs(weaponKeywords) do
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") and string.find(string.lower(item.Name), keyword) then
				item.Parent = character
				return item
			end
		end
	end
	return nil
end

-- Anti-Anti-Cheat Safe Orbit Combat Framework Loop
RunService.PostSimulation:Connect(function(deltaTime)
	if not config.ScriptRunning or not config.AutoCombat then return end
	local character, humanoid, hrp = getgenv().getLocalCharacterState()
	if not character or not humanoid or not hrp then return end
	
	local target = getgenv().getSmartCombatTarget()
	if target and target:FindFirstChild("HumanoidRootPart") then
		local enemyHrp = target.HumanoidRootPart
		local distance = (hrp.Position - enemyHrp.Position).Magnitude
		local backpack = game:GetService("Players").LocalPlayer:FindFirstChild("Backpack")
		if backpack then forceEquipMeleeWeapon(character, backpack) end
		
		if config.SmartStrafe then
			strafeTick = strafeTick + (deltaTime * 6)
			if distance <= config.AttackReach then
				local repelVector = (hrp.Position - enemyHrp.Position).Unit
				humanoid:Move(Vector3.new(repelVector.X, 0, repelVector.Z), false)
			else
				local orbitRadius = 4.5
				local offsetX = math.sin(strafeTick) * orbitRadius
				local offsetZ = math.cos(strafeTick) * orbitRadius
				local desiredPosition = enemyHrp.Position + Vector3.new(offsetX, 0, offsetZ)
				local moveDirection = (desiredPosition - hrp.Position).Unit
				humanoid:Move(Vector3.new(moveDirection.X, 0, moveDirection.Z), false)
			end
			hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(enemyHrp.Position.X, hrp.Position.Y, enemyHrp.Position.Z))
		end
		
		if distance <= config.AttackReach then
			VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
			task.wait(0.01)
			VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
		end
	end
end)

-- FIXED ADAPTIVE SOLVER: Tracks and aligns with teleporting red zone angles dynamically
getgenv().solveMovingRedZoneMinigame = function(laundryAsset)
	local minigameInterfaceFound = false
	local needleGui, redZoneGui = nil, nil
	
	for _, element in ipairs(game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui"):GetDescendants()) do
		if element:IsA("ImageLabel") or element:IsA("Frame") then
			if element.Visible then
				local nameLower = string.lower(element.Name)
				if string.find(nameLower, "pointer") or string.find(nameLower, "needle") or string.find(nameLower, "clicker") then
					needleGui = element
				elseif string.find(nameLower, "red") or string.find(nameLower, "zone") or (element.BackgroundColor3.R > 0.6 and element.BackgroundColor3.G < 0.2) then
					redZoneGui = element
				end
			end
		end
	end
	
	if needleGui and redZoneGui then
		minigameInterfaceFound = true
		local needleRotation = needleGui.Rotation % 360
		local redZoneRotation = redZoneGui.Rotation % 360
		local angleDifference = math.abs(needleRotation - redZoneRotation)
		if angleDifference > 180 then angleDifference = 360 - angleDifference end
		
		if angleDifference <= 25 then
			VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
			RunService.PostSimulation:Wait()
			VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
			task.wait(0.05)
			return true
		end
	end
	
	if laundryAsset and laundryAsset.Parent and not minigameInterfaceFound then
		VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
		RunService.PostSimulation:Wait()
		VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
		return true
	end
	return minigameInterfaceFound
end
