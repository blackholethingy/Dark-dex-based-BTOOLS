-- ==========================================================
-- MOVE
-- ==========================================================

local moveStartCFrame = nil
local moveStartSize = nil
local movingPart = nil

moveHandles.MouseButton1Down:Connect(function()
	local part = _G.DexActivePart

	if part and part:IsA("BasePart") then
		movingPart = part
		moveStartCFrame = part.CFrame
		moveStartSize = part.Size
	end
end)

moveHandles.MouseDrag:Connect(function(face, distance)
	if not movingPart then
		return
	end

	if movingPart ~= _G.DexActivePart then
		return
	end

	if not moveStartCFrame then
		return
	end

	local direction = Vector3.FromNormalId(face)

	local amount = snapValue(
		distance,
		_G.DexMoveSnap
	)

	movingPart.CFrame =
		moveStartCFrame
		* CFrame.new(direction * amount)
end)

moveHandles.MouseButton1Up:Connect(function()
	if movingPart and moveStartCFrame then
		if movingPart.CFrame ~= moveStartCFrame then
			pushUndo({
				Type = "Transform",
				Part = movingPart,
				CFrame = moveStartCFrame,
				Size = moveStartSize
			})
		end
	end

	movingPart = nil
	moveStartCFrame = nil
	moveStartSize = nil
end)

-- ==========================================================
-- SCALE
-- ==========================================================

local scalingPart = nil
local scaleStartSize = nil
local scaleStartCFrame = nil

scaleHandles.MouseButton1Down:Connect(function()
	local part = _G.DexActivePart

	if part and part:IsA("BasePart") then
		scalingPart = part
		scaleStartSize = part.Size
		scaleStartCFrame = part.CFrame
	end
end)

scaleHandles.MouseDrag:Connect(function(face, distance)
	if not scalingPart then
		return
	end

	if scalingPart ~= _G.DexActivePart then
		return
	end

	if not scaleStartSize then
		return
	end

	local direction = Vector3.FromNormalId(face)

	local amount = snapValue(
		distance,
		_G.DexMoveSnap
	)

	local size = scaleStartSize + direction * amount

	size = Vector3.new(
		math.max(0.1, size.X),
		math.max(0.1, size.Y),
		math.max(0.1, size.Z)
	)

	scalingPart.Size = size
end)

scaleHandles.MouseButton1Up:Connect(function()
	if scalingPart and scaleStartSize then
		if scalingPart.Size ~= scaleStartSize then
			pushUndo({
				Type = "Transform",
				Part = scalingPart,
				CFrame = scaleStartCFrame,
				Size = scaleStartSize
			})
		end
	end

	scalingPart = nil
	scaleStartSize = nil
	scaleStartCFrame = nil
end)

-- ==========================================================
-- ROTATE
-- ==========================================================

local rotatingPart = nil
local rotateStartCFrame = nil
local rotateStartSize = nil

rotateHandles.MouseButton1Down:Connect(function(axis)
	local part = _G.DexActivePart

	if part and part:IsA("BasePart") then
		rotatingPart = part
		rotateStartCFrame = part.CFrame
		rotateStartSize = part.Size
	end
end)

rotateHandles.MouseDrag:Connect(function(axis, relativeAngle)
	if not rotatingPart then
		return
	end

	if rotatingPart ~= _G.DexActivePart then
		return
	end

	if not rotateStartCFrame then
		return
	end

	local angle = relativeAngle

	if _G.DexRotateSnap > 0 then
		local degrees = math.deg(angle)

		degrees =
			math.round(
				degrees / _G.DexRotateSnap
			)
			* _G.DexRotateSnap

		angle = math.rad(degrees)
	end

	local rotation

	if axis == Enum.Axis.X then
		rotation = CFrame.Angles(
			angle,
			0,
			0
		)

	elseif axis == Enum.Axis.Y then
		rotation = CFrame.Angles(
			0,
			angle,
			0
		)

	elseif axis == Enum.Axis.Z then
		rotation = CFrame.Angles(
			0,
			0,
			angle
		)

	else
		return
	end

	rotatingPart.CFrame =
		rotateStartCFrame
		* rotation
end)

rotateHandles.MouseButton1Up:Connect(function()
	if rotatingPart and rotateStartCFrame then
		if rotatingPart.CFrame ~= rotateStartCFrame then
			pushUndo({
				Type = "Transform",
				Part = rotatingPart,
				CFrame = rotateStartCFrame,
				Size = rotateStartSize
			})
		end
	end

	rotatingPart = nil
	rotateStartCFrame = nil
	rotateStartSize = nil
end)

