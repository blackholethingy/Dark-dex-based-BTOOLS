_G.DexRunDeleteAction = function()
	local part = _G.DexActivePart

	if not part then
		return
	end

	if not part:IsA("BasePart") then
		return
	end

	if part.Name ~= "DexStudioSpawnedPart" then
		return
	end

	pushUndo({
		Type = "Delete",
		Clone = part:Clone(),
		Parent = part.Parent
	})

	_G.DexHideAllHandles()

	_G.DexActivePart = nil

	part:Destroy()
end

