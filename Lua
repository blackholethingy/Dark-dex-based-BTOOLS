_G.DexHideAllHandles = function()
	moveHandles.Visible = false
	scaleHandles.Visible = false
	rotateHandles.Visible = false

	moveHandles.Adornee = nil
	scaleHandles.Adornee = nil
	rotateHandles.Adornee = nil
end

_G.DexUpdateHandles = function(part)
	_G.DexHideAllHandles()

	if not part then
		return
	end

	if not part:IsA("BasePart") then
		return
	end

	if not part.Parent then
		return
	end

	if _G.DexCurrentMode == "Move" then
		moveHandles.Adornee = part
		moveHandles.Visible = true

	elseif _G.DexCurrentMode == "Scale" then
		scaleHandles.Adornee = part
		scaleHandles.Visible = true

	elseif _G.DexCurrentMode == "Rotate" then
		rotateHandles.Adornee = part
		rotateHandles.Visible = true
	end
end

