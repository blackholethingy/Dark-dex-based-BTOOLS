-- ==========================================================
-- INPUT
-- ==========================================================

inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not _G.DexDraggerEngine then
		if inputConnection then
			inputConnection:Disconnect()
		end

		return
	end

	if gameProcessed then
		return
	end

	-- ======================================================
	-- CTRL + Z
	-- ======================================================

	if input.KeyCode == Enum.KeyCode.Z
		and (
			UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
		)
	then
		runUndo()
		return
	end

	-- ======================================================
	-- HOTKEYS
	-- ======================================================

	if input.KeyCode == Enum.KeyCode.One then
		setMode("Select")
		return

	elseif input.KeyCode == Enum.KeyCode.Two then
		setMode("Move")
		return

	elseif input.KeyCode == Enum.KeyCode.Three then
		setMode("Scale")
		return

	elseif input.KeyCode == Enum.KeyCode.Four then
		setMode("Rotate")
		return

	elseif input.KeyCode == Enum.KeyCode.Five then
		setMode("Create")
		return

	elseif input.KeyCode == Enum.KeyCode.Delete then
		_G.DexRunDeleteAction()
		return
	end

	-- ======================================================
	-- LEFT CLICK
	-- ======================================================

	if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
		return
	end

	if _G.DexCurrentMode == "Create" then
		createNewPart()
		return
	end

	if _G.DexCurrentMode == "Select" then
		selectTarget()
		return
	end

	if _G.DexCurrentMode == "Move"
		or _G.DexCurrentMode == "Scale"
		or _G.DexCurrentMode == "Rotate"
	then
		if not _G.DexActivePart then
			selectTarget()
		end
	end
end)

