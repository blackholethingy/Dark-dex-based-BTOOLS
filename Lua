-- ==========================================================
-- CREATE PART
-- ==========================================================

local function createPart()
	local spawnPart

	if _G.DexCurrentShape == "Block" then
		spawnPart = Instance.new("Part")
		spawnPart.Shape = Enum.PartType.Block

	elseif _G.DexCurrentShape == "Wedge" then
		spawnPart = Instance.new("WedgePart")

	elseif _G.DexCurrentShape == "Sphere" then
		spawnPart = Instance.new("Part")
		spawnPart.Shape = Enum.PartType.Ball

	elseif _G.DexCurrentShape == "Cylinder" then
		spawnPart = Instance.new("Part")
		spawnPart.Shape = Enum.PartType.Cylinder
	end

	if not spawnPart then
		return
	end

	spawnPart.Size = Vector3.new(4, 4, 4)
	spawnPart.Name = "DexStudioSpawnedPart"
	spawnPart.Material = Enum.Material.SmoothPlastic
	spawnPart.Color = Color3.fromRGB(163, 162, 165)
	spawnPart.Anchored = true

	local hitPosition =
		mouse.Hit.Position

	local rawPos =
		hitPosition
		+ Vector3.new(
			0,
			spawnPart.Size.Y / 2,
			0
		)

	spawnPart.Position =
		Vector3.new(
			snapValue(
				rawPos.X,
				_G.DexMoveSnap
			),

			snapValue(
				rawPos.Y,
				_G.DexMoveSnap
			),

			snapValue(
				rawPos.Z,
				_G.DexMoveSnap
			)
		)

	spawnPart.Parent = workspace

	_G.DexActivePart = spawnPart
	_G.DexCurrentMode = "Move"

	_G.DexUpdateButtonHighlights("Move")
	_G.DexUpdateHandles(spawnPart)
end

-- ==========================================================
-- KEYBOARD / MOUSE INPUT
-- ==========================================================

local inputConnection

inputConnection =
	UserInputService.InputBegan:Connect(
		function(input, gameProcessed)

			if not _G.DexDraggerEngine then
				inputConnection:Disconnect()
				return
			end

			if gameProcessed then
				return
			end

			local targetMode

			if input.KeyCode == Enum.KeyCode.One then
				targetMode = "Select"

			elseif input.KeyCode == Enum.KeyCode.Two then
				targetMode = "Move"

			elseif input.KeyCode == Enum.KeyCode.Three then
				targetMode = "Scale"

			elseif input.KeyCode == Enum.KeyCode.Four then
				targetMode = "Rotate"

			elseif input.KeyCode == Enum.KeyCode.Five then
				targetMode = "Create"

			elseif input.KeyCode == Enum.KeyCode.Delete then
				_G.DexRunDeleteAction()
				return
			end

			if targetMode then
				_G.DexCurrentMode =
					targetMode

				_G.DexUpdateButtonHighlights(
					targetMode
				)

				if targetMode == "Create" then
					_G.DexActivePart = nil
				end

				_G.DexUpdateHandles(
					_G.DexActivePart
				)

				return
			end

			if input.UserInputType
				~= Enum.UserInputType.MouseButton1
			then
				return
			end

			-- ==================================================
			-- CREATE MODE
			-- ==================================================

			if _G.DexCurrentMode == "Create" then
				if mouse.Target then
					createPart()
				end

				return
			end

			-- ==================================================
			-- SELECT / MOVE / SCALE / ROTATE
			-- ==================================================

			if _G.DexCurrentMode == "Select"
				or _G.DexCurrentMode == "Move"
				or _G.DexCurrentMode == "Scale"
				or _G.DexCurrentMode == "Rotate"
			then

				if moveHandles.Visible
					and moveHandles.Adornee
				then
					return
				end

				if scaleHandles.Visible
					and scaleHandles.Adornee
				then
					return
				end

				if rotateHandles.Visible
					and rotateHandles.Adornee
				then
					return
				end

				local target = mouse.Target

				if target
					and (
						not player.Character
						or not target:IsDescendantOf(
							player.Character
						)
					)
				then
					_G.DexActivePart = target

					_G.DexUpdateHandles(
						target
					)
				else
					_G.DexActivePart = nil

					_G.DexHideAllHandles()
				end
			end
		end
	)

print("Advanced Studio Dragger Engine Loaded!")
