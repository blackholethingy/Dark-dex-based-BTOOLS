	btn.Size = UDim2.new(0, 56, 0, 35)
	btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
	btn.Text = name
	btn.TextColor3 = Color3.fromRGB(220, 220, 220)
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 12
	btn.BorderSizePixel = 0
	btn.Parent = toolbar

	btn.MouseButton1Click:Connect(function()
		_G.DexCurrentMode = name

		_G.DexUpdateButtonHighlights(name)

		if name == "Create" then
			_G.DexActivePart = nil
		end

		if _G.DexUpdateHandles then
			_G.DexUpdateHandles(_G.DexActivePart)
		end
	end)
end

