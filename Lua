-- ==========================================================
-- BUTTON HIGHLIGHTING
-- ==========================================================

_G.DexUpdateButtonHighlights = function(activeModeName)
	for _, b in pairs(toolbar:GetChildren()) do
		if b:IsA("TextButton")
			and b.Text ~= "[X] Close"
			and b.Text ~= "[-] Delete"
		then
			if b.Text == activeModeName then
				if activeModeName == "Select" then
					b.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
				elseif activeModeName == "Create" then
					b.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
				elseif activeModeName == "Move" then
					b.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
				elseif activeModeName == "Scale" then
					b.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
				elseif activeModeName == "Rotate" then
					b.BackgroundColor3 = Color3.fromRGB(200, 120, 0)
				end
			else
				b.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
			end
		end
	end
end

