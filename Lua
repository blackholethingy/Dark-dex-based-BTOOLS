-- ==========================================================
-- CREATE PART
-- ==========================================================

local function createNewPart()
	if not mouse.Target then
		return
	end

	local part

	if _G.DexCurrentShape == "Block" then
		part = Instance.new("Part")
		part.Shape = Enum.PartType.Block

	elseif _G.DexCurrentShape == "Wedge" then
		part = Instance.new("WedgePart")

	elseif _G.DexCurrentShape == "Sphere" then
		part = Instance.new("Part")
		part.Shape = Enum.PartType.Ball

	elseif _G.DexCurrentShape == "Cylinder" then
		part = Instance.new("Part")
		part.Shape = Enum.PartType.Cylinder

	else
		return
	end

	part.Name = "DexStudioSpawnedPart"
	part.Size = Vector3.new(4, 4, 4)
	part.Material = Enum.Material.SmoothPlastic
	part.Color = Color3.fromRGB(163, 162, 165)
	part.Anchored = true
	part.CanCollide = true

	local hitPosition = mouse.Hit.Position

	local position =
		hitPosition
		+ Vector3.new(
			0,
			part.Size.Y / 2,
			0
		)

	position = Vector3.new(
		snapValue(position.X, _G.DexMoveSnap),
		snapValue(position.Y, _G.DexMoveSnap),
		snapValue(position.Z, _G.DexMoveSnap)
	)

	part.Position = position
	part.Parent = workspace

	pushUndo({
		Type = "Create",
		Part = part
	})

	_G.DexActivePart = part

	setMode("Move")
end

