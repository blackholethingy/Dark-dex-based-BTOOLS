-- ==========================================================
-- UNDO SYSTEM
-- ==========================================================

local undoStack = {}
local MAX_UNDO = 50

local function pushUndo(action)
	table.insert(undoStack, action)

	if #undoStack > MAX_UNDO then
		table.remove(undoStack, 1)
	end
end

local function runUndo()
	local action = table.remove(undoStack)

	if not action then
		return
	end

	if action.Type == "Transform" then
		local part = action.Part

		if part and part.Parent then
			part.CFrame = action.CFrame
			part.Size = action.Size

			_G.DexActivePart = part

			if _G.DexUpdateHandles then
				_G.DexUpdateHandles(part)
			end
		end

	elseif action.Type == "Create" then
		local part = action.Part

		if part and part.Parent then
			if _G.DexActivePart == part then
				_G.DexActivePart = nil

				if _G.DexHideAllHandles then
					_G.DexHideAllHandles()
				end
			end

			part:Destroy()
		end

	elseif action.Type == "Delete" then
		if action.Clone then
			local restored = action.Clone:Clone()

			if action.Parent and action.Parent.Parent then
				restored.Parent = action.Parent
			else
				restored.Parent = workspace
			end

			_G.DexActivePart = restored

			if _G.DexUpdateHandles then
				_G.DexUpdateHandles(restored)
			end
		end
	end
end

