-- ==========================================================
-- SNAP FUNCTION
-- ==========================================================

local function snapValue(value, snap)
	if snap == 0 then
		return value
	end

	return math.round(value / snap) * snap
end

-- ==========================================================
-- HANDLE MANAGEMENT
-- ==========================================================

_G.DexHideAllHandles = function()
	moveHandles.Visible = false
	scaleHandles.Visible = false
	rotateHandles.Visible = false

	moveHandles.Adornee = nil
	scaleHandles.Adornee = nil
	rotateHandles.Adornee = nil
end

_G.DexUpdateHandles = function(part)
	_G.DexHideAllHandles()

	if not part then
		return
	end

	if not part:IsA("BasePart") then
		return
	end

	if _G.DexCurrentMode == "Move" then
		moveHandles.Adornee = part
		moveHandles.Style = Enum.HandlesStyle.Movement
		moveHandles.Visible = true

	elseif _G.DexCurrentMode == "Scale" then
		scaleHandles.Adornee = part
		scaleHandles.Style = Enum.HandlesStyle.Resize
		scaleHandles.Visible = true

	elseif _G.DexCurrentMode == "Rotate" then
		rotateHandles.Adornee = part
		rotateHandles.Visible = true
	end
end

-- ==========================================================
-- MOVE LOGIC
-- ==========================================================

local startCFrame
local startSize

moveHandles.MouseButton1Down:Connect(function()
	if _G.DexActivePart then
		startCFrame = _G.DexActivePart.CFrame
	end
end)

moveHandles.MouseDrag:Connect(function(face, distance)
	if not _G.DexActivePart then
		return
	end

	if not startCFrame then
		return
	end

	local direction = Vector3.FromNormalId(face)

	local snappedDistance = snapValue(
		distance,
		_G.DexMoveSnap
	)

	_G.DexActivePart.CFrame =
		startCFrame
		* CFrame.new(
			direction * snappedDistance
		)
end)

-- ==========================================================
-- SCALE LOGIC
-- ==========================================================

scaleHandles.MouseButton1Down:Connect(function()
	if _G.DexActivePart then
		startCFrame = _G.DexActivePart.CFrame
		startSize = _G.DexActivePart.Size
	end
end)

scaleHandles.MouseDrag:Connect(function(face, distance)
	if not _G.DexActivePart then
		return
	end

	if not startCFrame or not startSize then
		return
	end

	local direction = Vector3.FromNormalId(face)

	local snappedDistance = snapValue(
		distance,
		_G.DexMoveSnap
	)

	local newSize =
		startSize
		+ direction * snappedDistance

	newSize = Vector3.new(
		math.max(0.1, newSize.X),
		math.max(0.1, newSize.Y),
		math.max(0.1, newSize.Z)
	)

	_G.DexActivePart.Size = newSize
end)

-- ==========================================================
-- ROTATE LOGIC
-- ==========================================================

rotateHandles.MouseButton1Down:Connect(function()
	if _G.DexActivePart then
		startCFrame = _G.DexActivePart.CFrame
	end
end)

rotateHandles.MouseDrag:Connect(function(axis, relativeAngle)
	if not _G.DexActivePart then
		return
	end

	if not startCFrame then
		return
	end

	local axisVector = Vector3.FromAxis(axis)

	local degrees =
		math.degrees(relativeAngle)

	local snappedDegrees = snapValue(
		degrees,
		_G.DexRotateSnap
	)

	local snappedAngle =
		math.rad(snappedDegrees)

	_G.DexActivePart.CFrame =
		startCFrame
		* CFrame.fromAxisAngle(
			axisVector,
			snappedAngle
		)
end)

