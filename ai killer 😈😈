-- 1. UTILITY: SAFE CHARACTER FETCHING FOR CUSTOM FOLDER
----------------------------------------------------------------
_G.GetMyCharacter = function()
	local customFolder = workspace:FindFirstChild("Characters")
	if customFolder then
		return customFolder:FindFirstChild("AreWeAloneOnEarth")
	end
	return localPlayer.Character
end

_G.GetTargetCharacter = function(player)
	if not player then return nil end
	local customFolder = workspace:FindFirstChild("Characters")
	if customFolder then
		return customFolder:FindFirstChild(player.Name)
	end
	return player.Character
end

