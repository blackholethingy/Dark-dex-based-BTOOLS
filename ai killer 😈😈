_G.UpdatePlayerList = function()
	if not _G.IsScriptRunning then return end
	for _, child in ipairs(playerScroller:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer then
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, -10, 0, 30)
			btn.Text = player.Name
			btn.Font = Enum.Font.SourceSans
			btn.TextSize = 14
			btn.BackgroundColor3 = (_G.TargetPlayer == player) and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(60, 60, 60)
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			btn.BorderSizePixel = 0
			btn.Parent = playerScroller

			btn.MouseButton1Click:Connect(function()
				_G.TargetPlayer = (_G.TargetPlayer == player) and nil or player
				_G.UpdatePlayerList()
			end)
		end
	end
	playerScroller.CanvasSize = UDim2.new(0, 0, 0, playerLayout.AbsoluteContentSize.Y)
end

_G.UpdateToolList = function()
	if not _G.IsScriptRunning then return end
	for _, child in ipairs(toolScroller:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end

	local backpack = localPlayer:FindFirstChild("Backpack")
	local character = _G.GetMyCharacter()
	
	local function scanDirectory(dir)
		if not dir then return end
		for _, item in ipairs(dir:GetChildren()) do
			if item:IsA("Tool") then
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(1, -10, 0, 30)
				btn.Text = item.Name
				btn.Font = Enum.Font.SourceSans
				btn.TextSize = 14
				btn.BackgroundColor3 = (_G.SelectedToolName == item.Name) and Color3.fromRGB(0, 120, 200) or Color3.fromRGB(60, 60, 60)
				btn.TextColor3 = Color3.fromRGB(255, 255, 255)
				btn.BorderSizePixel = 0
				btn.Parent = toolScroller

				btn.MouseButton1Click:Connect(function()
					_G.SelectedToolName = (_G.SelectedToolName == item.Name) and nil or item.Name
					_G.UpdateToolList()
				end)
			end
		end
	end

	scanDirectory(backpack)
	scanDirectory(character)
	toolScroller.CanvasSize = UDim2.new(0, 0, 0, toolLayout.AbsoluteContentSize.Y)
end

