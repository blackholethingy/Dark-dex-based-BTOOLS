						currentPathToken +=
							1

						targetPlayer =
							nil

						local character =
							getMyCharacter()

						local _,
							humanoid =
							getCharacterState(
								character
							)

						if humanoid then

							humanoid:Move(
								Vector3.zero,
								false
							)
						end

						setStatus(
							"Idle"
						)

					else

						startTracking(
							player
						)
					end

					updatePlayerList()
				end)
		end
	end

	task.defer(function()

		playerScroller.CanvasSize =
			UDim2.new(
				0,
				0,
				0,
				playerLayout.AbsoluteContentSize.Y
				+ 5
			)
	end)
end

-- ==========================================================
-- TOOL LIST UPDATE
-- ==========================================================

local function updateToolList()

	for _, child in ipairs(
		toolScroller:GetChildren()
	) do

		if child:IsA(
			"TextButton"
		) then

			child:Destroy()
		end
	end

	local shown =
		{}

	local function scan(container)

		if not container then
			return
		end

		for _, object in ipairs(
			container:GetChildren()
		) do

			if object:IsA("Tool")
				and not shown[
					object.Name
				]
			then

				shown[
					object.Name
				] = true

				local button =
					Instance.new(
						"TextButton"
					)

				button.Size =
					UDim2.new(
						1,
						-6,
						0,
						30
					)

				button.Text =
					object.Name

				button.Font =
					Enum.Font.SourceSans

				button.TextSize =
					14

				button.TextColor3 =
					Color3.fromRGB(
						255,
						255,
						255
					)

				button.BorderSizePixel =
					0

				if selectedToolName
					== object.Name
				then

					button.BackgroundColor3 =
						Color3.fromRGB(
							0,
							110,
							180
						)

				else

					button.BackgroundColor3 =
						Color3.fromRGB(
							58,
							58,
							64
						)
				end

				button.Parent =
					toolScroller

				button.MouseButton1Click:
					Connect(function()

						if selectedToolName
							== object.Name
						then

							selectedToolName =
								nil

						else

							selectedToolName =
								object.Name
						end

						updateToolList()
					end)
			end
		end
	end

	scan(
		localPlayer:FindFirstChild(
			"Backpack"
		)
	)

	scan(
		getMyCharacter()
	)

	task.defer(function()

		toolScroller.CanvasSize =
			UDim2.new(
				0,
				0,
				0,
				toolLayout.AbsoluteContentSize.Y
				+ 5
			)
	end)
end

-- ==========================================================
-- WEAPON SYSTEM
-- ==========================================================

local lastAttack =
	0

local function updateWeapon()

	if not running
		or not targetPlayer
		or not selectedToolName
	then
		return
	end

	local character =
		getMyCharacter()

	local targetCharacter =
		getTargetCharacter(
			targetPlayer
		)

	local _,
		humanoid,
		root =
		getCharacterState(
			character
		)

	local _,
		targetHumanoid,
		targetRoot =
		getCharacterState(
			targetCharacter
		)

	if not humanoid
		or not root
		or not targetHumanoid
		or not targetRoot
	then
		return
	end

	local tool =
		character:FindFirstChild(
			selectedToolName
		)

	if not tool then

		local backpack =
			localPlayer:
				FindFirstChild(
					"Backpack"
				)

		tool =
			backpack
			and backpack:
				FindFirstChild(
					selectedToolName
				)

		if tool then

			tool.Parent =
				character
		end
	end

	if not tool
		or not tool:IsA(
			"Tool"
		)
	then
		return
	end

	local distance =
		(
			root.Position
			- targetRoot.Position
		).Magnitude

	if distance <= ATTACK_RANGE then

		local now =
			os.clock()

		if now - lastAttack
			>= 0.25
		then

			lastAttack =
				now

			pcall(function()
				tool:Activate()
			end)
		end
	end
end

-- ==========================================================
-- STOP TRACKING
-- ==========================================================

local function stopTracking()

	currentPathToken +=
		1

	targetPlayer =
		nil

	selectedToolName =
		nil

	clearVisuals()

	local character =
		getMyCharacter()

	local _,
		humanoid =
		getCharacterState(
			character
		)

	if humanoid then

		humanoid:Move(
			Vector3.zero,
			false
		)
	end

	if character then

		local equipped =
			character:
				FindFirstChildOfClass(
					"Tool"
				)

		local backpack =
			localPlayer:
				FindFirstChild(
					"Backpack"
				)

		if equipped
			and backpack
		then

			equipped.Parent =
				backpack
		end
	end

	setStatus(
		"Stopped"
	)

	updatePlayerList()
	updateToolList()
end

stopButton.MouseButton1Click:
	Connect(
		stopTracking
	)

