-- BACKPACK EVENTS
-- ==========================================================

local backpack =
	localPlayer:
		WaitForChild(
			"Backpack"
		)

trackConnection(
	backpack.ChildAdded:
		Connect(function()

			task.defer(
				updateToolList
			)
		end)
)

trackConnection(
	backpack.ChildRemoved:
		Connect(function()

			task.defer(
				updateToolList
			)
		end)
)

-- ==========================================================
-- CLEANUP
-- ==========================================================

local function cleanup()

	if not running then
		return
	end

	running =
		false

	currentPathToken +=
		1

	targetPlayer =
		nil

	selectedToolName =
		nil

	local character =
		getMyCharacter()

	local _,
		humanoid =
		getCharacterState(
			character
		)

	if humanoid then

		humanoid:Move(
			Vector3.zero,
			false
		)
	end

	for _, connection in ipairs(
		connections
	) do

		pcall(function()
			connection:
				Disconnect()
		end)
	end

	table.clear(
		connections
	)

	clearVisuals()

	if visualFolder then
		visualFolder:
			Destroy()
	end

	if screenGui then
		screenGui:
			Destroy()
	end

	_G.PlayerTrackerCleanup =
		nil

	print(
		"Player Tracker terminated."
	)
end

_G.PlayerTrackerCleanup =
	cleanup

killButton.MouseButton1Click:
	Connect(
		cleanup
	)

