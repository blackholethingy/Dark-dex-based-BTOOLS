pathBeam.Attachment0 = playerAttachment
pathBeam.Attachment1 = targetAttachment
pathBeam.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0)) -- Neon Red Color Sequence
pathBeam.Width0 = 0.5 
pathBeam.Width1 = 0.5 
pathBeam.LightEmission = 1 
pathBeam.LightInfluence = 0 
pathBeam.Enabled = false
pathBeam.FaceCamera = true
pathBeam.Parent = visualFolder

_G.ClearVisualMarkers = function()
	targetHighlight.Enabled = false
	targetHighlight.Adornee = nil
	targetBox.Transparency = 1
	pathBeam.Enabled = false
	playerAttachment.Parent = nil
end

----------------------------------------------------------------
-- 5. ZERO-CALCULATION VISUAL FRAME RENDERS (FEET ACCURATE)
----------------------------------------------------------------
_G.RenderVisualPath = function()
	local myCharacter = _G.GetMyCharacter and _G.GetMyCharacter()
	local targetCharacter = _G.GetTargetCharacter and _G.GetTargetCharacter(_G.TargetPlayer)
	
	if not targetCharacter or not targetCharacter:FindFirstChild("HumanoidRootPart") or not myCharacter or not myCharacter:FindFirstChild("HumanoidRootPart") then
		_G.ClearVisualMarkers()
		return 
	end
	
	local myRoot = myCharacter.HumanoidRootPart
	local targetRoot = targetCharacter.HumanoidRootPart

	-- Attach highlight outline around model frame
	targetHighlight.Adornee = targetCharacter
	targetHighlight.Enabled = true
	
	-- FIXED FEET TARGET: Position the green box exactly 3 studs below HumanoidRootPart center
	targetBox.Position = targetRoot.Position - Vector3.new(0, 3, 0)
	targetBox.Transparency = 0

	-- Anchor beam line segments via hardware rendering structures
	playerAttachment.Parent = myRoot
	pathBeam.Enabled = true
end

----------------------------------------------------------------
-- 6. HEIGHT & DROP CHASE ENGINE LOOPS (FEET ACCURATE)
----------------------------------------------------------------
local function autoRunLoop()
	if not _G.IsScriptRunning then return end

	local character = _G.GetMyCharacter and _G.GetMyCharacter()
	if not character then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart or humanoid.Health <= 0 then return end

	local targetCharacter = _G.GetTargetCharacter and _G.GetTargetCharacter(_G.TargetPlayer)
	if targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart") then
		local targetRoot = targetCharacter.HumanoidRootPart
		local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
		
		if targetHumanoid and targetHumanoid.Health > 0 then
			-- Fixed destination tracking position: straight to target's feet base vectors
			local destinationPosition = targetRoot.Position - Vector3.new(0, 3, 0)
			local distance = (rootPart.Position - targetRoot.Position).Magnitude
			
			-- Calculate vertical delta gap matrix (Target Y minus Player Y)
			local verticalGap = targetRoot.Position.Y - rootPart.Position.Y
			
			-- 1A. HIGH GAP DETECTION: Auto-jump if climbing
			if verticalGap >= VERTICAL_JUMP_THRESHOLD then
				humanoid.Jump = true
			
			-- 1B. LOW GAP DETECTION: Force path velocity downward if target is below you
			elseif verticalGap <= VERTICAL_DROP_THRESHOLD then
				-- If walking directly above them, apply a slight forward push to step off ledge structures cleanly
				if distance < 12 and humanoid.FloorMaterial ~= Enum.Material.Air then
					rootPart.AssemblyLinearVelocity = (destinationPosition - rootPart.Position).Unit * humanoid.WalkSpeed
				end
			end
			
			-- Handle regular directional tracking step assignment directly to feet marker vector position
			humanoid:MoveTo(destinationPosition)
			_G.RenderVisualPath()
			
			-- 2. Stutter-Free Weapon Handling
			if _G.SelectedToolName then
				local equippedTool = character:FindFirstChild(_G.SelectedToolName)
				if not equippedTool then
					local backpack = localPlayer:FindFirstChild("Backpack")
					local targetTool = backpack and backpack:FindFirstChild(_G.SelectedToolName)
					if targetTool then targetTool.Parent = character end
				end
				
				if equippedTool and distance < ATTACK_RANGE then
					equippedTool:Activate()
				end
			end
		else
			_G.ClearVisualMarkers()
		end
	else
		_G.ClearVisualMarkers()
	end
end

-- Hook loops safely to structural frame triggers
_G.LoopConnection = RunService.RenderStepped:Connect(autoRunLoop)

if _G.KillButton then
	_G.KillButton.MouseButton1Click:Connect(function()
		_G.IsScriptRunning = false
		if _G.LoopConnection then _G.LoopConnection:Disconnect() end
		if _G.InputConnection then _G.InputConnection:Disconnect() end
		_G.ClearVisualMarkers()
		targetHighlight:Destroy()
		targetBox:Destroy()
		playerAttachment:Destroy()
		pathBeam:Destroy()
		local gui = localPlayer.PlayerGui:FindFirstChild("AutoTrackerGui")
		if gui then gui:Destroy() end
		print("Auto-Tracker terminated.")
	end)
end
