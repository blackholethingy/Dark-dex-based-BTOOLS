	for _, child in ipairs(
		playerScroller:GetChildren()
	) do

		if child:IsA(
			"TextButton"
		) then

			child:Destroy()
		end
	end

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= localPlayer then

			local button =
				Instance.new(
					"TextButton"
				)

			button.Size =
				UDim2.new(
					1,
					-6,
					0,
					30
				)

			button.Text =
				player.Name

			button.Font =
				Enum.Font.SourceSans

			button.TextSize =
				14

			button.TextColor3 =
				Color3.fromRGB(
					255,
					255,
					255
				)

			button.BorderSizePixel =
				0

			if targetPlayer
				== player
			then

				button.BackgroundColor3 =
					Color3.fromRGB(
						0,
						145,
						80
					)

			else

				button.BackgroundColor3 =
					Color3.fromRGB(
						58,
						58,
						64
