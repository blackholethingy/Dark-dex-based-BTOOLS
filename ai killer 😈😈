-- Initialize specialized GPU Attachments and Beam components
local playerAttachment = Instance.new("Attachment")
playerAttachment.Name = "TrackerPlayerAttachment"

local targetAttachment = Instance.new("Attachment")
targetAttachment.Name = "TrackerTargetAttachment"
targetAttachment.Parent = targetBox

local pathBeam = visualFolder:FindFirstChild("TrackerPathBeam") or Instance.new("Beam")
