-- 3. DYNAMIC DATA DRAW PATTERNS
----------------------------------------------------------------
_G.UpdatePlayerList = function()
	if not _G.IsScriptRunning then return end
	if not _G.PlayerScroller then return end
	for _, child in ipairs(_G.PlayerScroller:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer then
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, -10, 0, 30)
			btn.Text = player.Name
			btn.Font = Enum.Font.SourceSans
			btn.TextSize = 14
			btn.BackgroundColor3 = (_G.TargetPlayer == player) and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(60, 60, 60)
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
			btn.BorderSizePixel = 0
			btn.Parent = _G.PlayerScroller

			btn.MouseButton1Click:Connect(function()
				_G.TargetPlayer = (_G.TargetPlayer == player) and nil or player
				_G.UpdatePlayerList()
			end)
		end
	end
	_G.PlayerScroller.CanvasSize = UDim2.new(0, 0, 0, _G.PlayerLayout.AbsoluteContentSize.Y)
end

_G.UpdateToolList = function()
	if not _G.IsScriptRunning then return end
	if not _G.ToolScroller then return end
	for _, child in ipairs(_G.ToolScroller:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end

	local backpack = localPlayer:FindFirstChild("Backpack")
	local character = _G.GetMyCharacter and _G.GetMyCharacter()
	
	local function scanDirectory(dir)
		if not dir then return end
		for _, item in ipairs(dir:GetChildren()) do
			if item:IsA("Tool") then
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(1, -10, 0, 30)
				btn.Text = item.Name
				btn.Font = Enum.Font.SourceSans
				btn.TextSize = 14
				btn.BackgroundColor3 = (_G.SelectedToolName == item.Name) and Color3.fromRGB(0, 120, 200) or Color3.fromRGB(60, 60, 60)
				btn.TextColor3 = Color3.fromRGB(255, 255, 255)
				btn.BorderSizePixel = 0
				btn.Parent = _G.ToolScroller

				btn.MouseButton1Click:Connect(function()
					_G.SelectedToolName = (_G.SelectedToolName == item.Name) and nil or item.Name
					_G.UpdateToolList()
				end)
			end
		end
	end

	scanDirectory(backpack)
	scanDirectory(character)
	_G.ToolScroller.CanvasSize = UDim2.new(0, 0, 0, _G.ToolLayout.AbsoluteContentSize.Y)
end

----------------------------------------------------------------
-- 4. EMERGENCY CANCELLATION AND STOP CONNECTIONS
----------------------------------------------------------------
_G.StopAllTracking = function()
	_G.TargetPlayer = nil
	_G.SelectedToolName = nil
	_G.ActiveWaypoints = {}
	if _G.ClearVisualMarkers then _G.ClearVisualMarkers() end
	
	local character = _G.GetMyCharacter and _G.GetMyCharacter()
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local rootPart = character:FindFirstChild("HumanoidRootPart")
		if humanoid and rootPart then
			humanoid:MoveTo(rootPart.Position)
		end
		
		local equippedTool = character:FindFirstChildOfClass("Tool")
		local backpack = localPlayer:FindFirstChild("Backpack")
		if equippedTool and backpack then
			equippedTool.Parent = backpack
		end
	end
	
	_G.UpdatePlayerList()
	_G.UpdateToolList()
	print("Halted tracking operations securely.")
end

if _G.StopButton then
	_G.StopButton.MouseButton1Click:Connect(_G.StopAllTracking)
end

_G.InputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.X then
		_G.StopAllTracking()
	end
end)

