-- PART 3: ENGINE LOOPS AND RENDER NODES (Place this third)
local PathfindingService = game:GetService("PathfindingService")
local RunService = game:GetService("RunService")
local localPlayer = game:GetService("Players").LocalPlayer

local ATTACK_RANGE = 8
local PATH_RECALC_TIME = 0.5
local lastPathUpdateTime = 0
_G.ActiveWaypoints = {}
local currentWaypointIndex = 1

-- Folder validation directly onto global structure layers
local visualFolder = workspace:FindFirstChild("TrackerVisuals")
if not visualFolder then
	visualFolder = Instance.new("Folder")
	visualFolder.Name = "TrackerVisuals"
	visualFolder.Parent = workspace
end

_G.ClearVisualMarkers = function()
	visualFolder:ClearAllChildren()
end

----------------------------------------------------------------
-- 5. HIGH RECALL NEON DESIGN PASSES
----------------------------------------------------------------
local function renderVisualPath()
	_G.ClearVisualMarkers()
	
	local targetCharacter = _G.GetTargetCharacter and _G.GetTargetCharacter(_G.TargetPlayer)
	if targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart") then
		local targetBox = Instance.new("Part")
		targetBox.Name = "TargetMarker"
		targetBox.Size = Vector3.new(2, 2, 2)
		targetBox.Position = targetCharacter.HumanoidRootPart.Position + Vector3.new(0, 5, 0)
		targetBox.Color = Color3.fromRGB(0, 255, 0)
		targetBox.Material = Enum.Material.Neon
		targetBox.Transparency = 0
		targetBox.Anchored = true
		targetBox.CanCollide = false
		targetBox.CastShadow = false
		targetBox.Parent = visualFolder
	end

	if #_G.ActiveWaypoints > 0 then
		local lastPlacedPos = nil
		for i = currentWaypointIndex, #_G.ActiveWaypoints do
			local wp = _G.ActiveWaypoints[i]
			if not lastPlacedPos or (wp.Position - lastPlacedPos).Magnitude >= 4 then
				lastPlacedPos = wp.Position
				
				local stepBox = Instance.new("Part")
				stepBox.Name = "PathStep"
				stepBox.Size = Vector3.new(1.2, 1.2, 1.2)
				stepBox.Position = wp.Position + Vector3.new(0, 0.6, 0)
				stepBox.Color = Color3.fromRGB(255, 0, 0)
				stepBox.Material = Enum.Material.Neon
				stepBox.Transparency = 0
				stepBox.Anchored = true
				stepBox.CanCollide = false
				stepBox.CastShadow = false
				stepBox.Parent = visualFolder
			end
		end
	end
end

----------------------------------------------------------------
-- 6. ASYNC NAVIGATION BOUNDS
----------------------------------------------------------------
local function computeNewPath(startPos, targetPos)
	local path = PathfindingService:CreatePath({
		AgentRadius = 2,
		AgentHeight = 5,
		AgentCanJump = true
	})
	
	local success, _ = pcall(function() path:ComputeAsync(startPos, targetPos) end)
	if success and path.Status == Enum.PathStatus.Success then
		_G.ActiveWaypoints = path:GetWaypoints()
		currentWaypointIndex = 1
		renderVisualPath()
	end
end

local function autoRunLoop()
	if not _G.IsScriptRunning then return end

	local character = _G.GetMyCharacter and _G.GetMyCharacter()
	if not character then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart or humanoid.Health <= 0 then return end

	local targetCharacter = _G.GetTargetCharacter and _G.GetTargetCharacter(_G.TargetPlayer)
	if targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart") then
		local targetRoot = targetCharacter.HumanoidRootPart
		local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
		
		if targetHumanoid and targetHumanoid.Health > 0 then
			local distance = (rootPart.Position - targetRoot.Position).Magnitude
			
			local now = tick()
			if now - lastPathUpdateTime > PATH_RECALC_TIME then
				lastPathUpdateTime = now
				computeNewPath(rootPart.Position, targetRoot.Position)
			else
				local trackingMarker = visualFolder:FindFirstChild("TargetMarker")
				if trackingMarker then
					trackingMarker.Position = targetRoot.Position + Vector3.new(0, 5, 0)
				end
			end
			
			if #_G.ActiveWaypoints > 0 and currentWaypointIndex <= #_G.ActiveWaypoints then
				local nextWaypoint = _G.ActiveWaypoints[currentWaypointIndex]
				if (rootPart.Position - nextWaypoint.Position).Magnitude < 3 then
					currentWaypointIndex = currentWaypointIndex + 1
				else
					if nextWaypoint.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
					humanoid:MoveTo(nextWaypoint.Position)
				end
			else
				humanoid:MoveTo(targetRoot.Position)
			end
			
			if _G.SelectedToolName then
				local equippedTool = character:FindFirstChild(_G.SelectedToolName)
				if not equippedTool then
					local backpack = localPlayer:FindFirstChild("Backpack")
					local targetTool = backpack and backpack:FindFirstChild(_G.SelectedToolName)
					if targetTool then targetTool.Parent = character end
				end
				
				if equippedTool and distance < ATTACK_RANGE then
					equippedTool:Activate()
				end
			end
		else
			_G.ActiveWaypoints = {}
			_G.ClearVisualMarkers()
		end
	else
		if #visualFolder:GetChildren() > 0 then _G.ClearVisualMarkers() end
	end
end

_G.LoopConnection = RunService.RenderStepped:Connect(autoRunLoop)

if _G.KillButton then
	_G.KillButton.MouseButton1Click:Connect(function()
		_G.IsScriptRunning = false
		if _G.LoopConnection then _G.LoopConnection:Disconnect() end
		if _G.InputConnection then _G.InputConnection:Disconnect() end
		_G.ClearVisualMarkers()
		local gui = localPlayer.PlayerGui:FindFirstChild("AutoTrackerGui")
		if gui then gui:Destroy() end
		print("Auto-Tracker terminated.")
	end)
end
