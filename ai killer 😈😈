_G.ClearVisualMarkers = function()
	targetHighlight.Enabled = false
	targetHighlight.Adornee = nil
	targetBox.Transparency = 1
	pathBeam.Enabled = false
	playerOriginAttachment.Parent = nil
end

local function getExactFeetPositionR6(character)
	if not character then return nil end
	local leftLeg = character:FindFirstChild("Left Leg")
	local rightLeg = character:FindFirstChild("Right Leg")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	
	local targetLeg = leftLeg or rightLeg
	if targetLeg and targetLeg:IsA("BasePart") then
		return targetLeg.Position - Vector3.new(0, targetLeg.Size.Y / 2, 0)
	end
	if rootPart then
		return rootPart.Position - Vector3.new(0, 3, 0)
	end
	return nil
end

----------------------------------------------------------------
-- 5. VISUAL LOOP (RUNS INDEPENDENTLY ON FRAME RATE - STRAIGHT LINE)
----------------------------------------------------------------
_G.RenderVisualPath = function()
	local myCharacter = _G.GetMyCharacter and _G.GetMyCharacter()
	local targetCharacter = _G.GetTargetCharacter and _G.GetTargetCharacter(_G.TargetPlayer)
	
	if not targetCharacter or not myCharacter or not myCharacter:FindFirstChild("HumanoidRootPart") then
		_G.ClearVisualMarkers()
		return 
	end
	
	local myRoot = myCharacter.HumanoidRootPart
	local trueFeetPos = getExactFeetPositionR6(targetCharacter)
	
	if trueFeetPos then
		targetHighlight.Adornee = targetCharacter
		targetHighlight.Enabled = true
		
		-- Lock green plate flat to floor
		targetBox.Position = trueFeetPos + Vector3.new(0, 0.05, 0)
		targetBox.Transparency = 0
		
		-- FORCE STRAIGHT BEAM LINE: Maps from point A to point B directly
		playerOriginAttachment.Parent = myRoot
		pathBeam.Enabled = true
	end
end

----------------------------------------------------------------
-- 6. INDEPENDENT MOVEMENT ASYNC LOOP (RUNS TRUE PATHFINDING)
----------------------------------------------------------------
local function followPathfindingWaypoints(character, humanoid, rootPart, trueFeetPos)
	local path = PathfindingService:CreatePath({
		AgentRadius = 3,
		AgentHeight = 5,
		AgentCanJump = true
	})
	
	local success, _ = pcall(function() path:ComputeAsync(rootPart.Position, trueFeetPos) end)
	if success and path.Status == Enum.PathStatus.Success then
		local waypoints = path:GetWaypoints()
		
		-- Step through waypoints asynchronously without frame-rate loop interference
		for i = 2, #waypoints do
			-- Abort if user deselected target or killed script midway
			if not _G.IsScriptRunning or not _G.TargetPlayer then break end
			
			local wp = waypoints[i]
			local flatPlayerPos = Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z)
			local flatWaypointPos = Vector3.new(wp.Position.X, 0, wp.Position.Z)
			
			if wp.Action == Enum.PathWaypointAction.Jump then 
				humanoid.Jump = true 
			end
			
			-- Tell character to walk to this corner point specifically
			humanoid:MoveTo(wp.Position)
			
			-- Keep moving until character gets close to the corner point
			while (flatPlayerPos - flatWaypointPos).Magnitude >= 2.5 and _G.IsScriptRunning and _G.TargetPlayer == game:GetService("Players"):GetPlayerFromCharacter(wp.Parent) do
				task.wait()
				flatPlayerPos = Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z)
			end
		end
	else
		-- Fallback direct command if path computation drops out
		humanoid:MoveTo(trueFeetPos)
	end
end

local function autoRunLoop()
	local guiCheck = localPlayer.PlayerGui:FindFirstChild("AutoTrackerGui")
	if not guiCheck or not _G.IsScriptRunning then
		_G.IsScriptRunning = false
		if _G.LoopConnection then _G.LoopConnection:Disconnect() _G.LoopConnection = nil end
		if _G.InputConnection then _G.InputConnection:Disconnect() _G.InputConnection = nil end
		_G.ClearVisualMarkers()
		return
	end

	local character = _G.GetMyCharacter and _G.GetMyCharacter()
	if not character then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart or humanoid.Health <= 0 then return end

	local targetCharacter = _G.GetTargetCharacter and _G.GetTargetCharacter(_G.TargetPlayer)
	if targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart") then
		local targetRoot = targetCharacter.HumanoidRootPart
		local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
		
		if targetHumanoid and targetHumanoid.Health > 0 then
			local trueFeetPos = getExactFeetPositionR6(targetCharacter) or (targetRoot.Position - Vector3.new(0, 3, 0))
			local distance = (rootPart.Position - targetRoot.Position).Magnitude
			
			-- Render visual straight beam on every single frame tick
			_G.RenderVisualPath()
			
			-- Separate the pathfinding movement thread completely from the frame update lock
			local now = tick()
			if now - lastPathUpdateTime > PATH_RECALC_TIME then
				lastPathUpdateTime = now
				task.spawn(followPathfindingWaypoints, character, humanoid, rootPart, trueFeetPos)
			end
			
			-- Tool Weapon Activation
			if _G.SelectedToolName then
				local equippedTool = character:FindFirstChild(_G.SelectedToolName)
				if not equippedTool then
					local backpack = localPlayer:FindFirstChild("Backpack")
					local targetTool = backpack and backpack:FindFirstChild(_G.SelectedToolName)
					if targetTool then targetTool.Parent = character end
				end
				
				if equippedTool and distance < ATTACK_RANGE then
					equippedTool:Activate()
				end
			end
		else
			_G.ClearVisualMarkers()
		end
	else
		_G.ClearVisualMarkers()
	end
end

_G.LoopConnection = RunService.RenderStepped:Connect(autoRunLoop)

if _G.KillButton then
	_G.KillButton.MouseButton1Click:Connect(function()
		_G.IsScriptRunning = false
		if _G.LoopConnection then _G.LoopConnection:Disconnect() end
		if _G.InputConnection then _G.InputConnection:Disconnect() end
		_G.ClearVisualMarkers()
		targetHighlight:Destroy()
		targetBox:Destroy()
		playerOriginAttachment:Destroy()
		pathBeam:Destroy()
		local gui = localPlayer.PlayerGui:FindFirstChild("AutoTrackerGui")
		if gui then gui:Destroy() end
		print("Auto-Tracker terminated.")
	end)
end
