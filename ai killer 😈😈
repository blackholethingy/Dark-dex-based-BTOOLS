-- PART 2: CORE LOOP AND NAVIGATION MECHANICS (Place this second)
local PathfindingService = game:GetService("PathfindingService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local localPlayer = game:GetService("Players").LocalPlayer

local ATTACK_RANGE = 8
local PATH_RECALC_TIME = 0.5
local lastPathUpdateTime = 0
local currentWaypoints = {}
local currentWaypointIndex = 1

-- Visual Tracker Folder Definition
local visualFolder = workspace:FindFirstChild("TrackerVisuals") or Instance.new("Folder")
visualFolder.Name = "TrackerVisuals"
visualFolder.Parent = workspace

----------------------------------------------------------------
-- 4. UTILITY: VISUAL MARKER GENERATORS
----------------------------------------------------------------
_G.ClearVisualMarkers = function()
	visualFolder:ClearAllChildren()
end

local function renderVisualPath()
	_G.ClearVisualMarkers()
	
	-- 1. Draw Target Marker (Green Cube)
	local targetCharacter = _G.GetTargetCharacter and _G.GetTargetCharacter(_G.TargetPlayer)
	if targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart") then
		local targetRoot = targetCharacter.HumanoidRootPart
		
		local targetBox = Instance.new("Part")
		targetBox.Name = "TargetMarker"
		targetBox.Size = Vector3.new(2, 2, 2)
		targetBox.Position = targetRoot.Position + Vector3.new(0, 4, 0) -- Hover above head
		targetBox.Color = Color3.fromRGB(0, 255, 0)
		targetBox.Material = Enum.Material.Neon
		targetBox.Anchored = true
		targetBox.CanCollide = false
		targetBox.Parent = visualFolder
	end

	-- 2. Draw Navigation Markers (Red Cubes spaced ~4 studs apart)
	if #currentWaypoints > 0 then
		local lastPlacedPos = nil
		
		-- Iterate through waypoints starting past the player's immediate stance
		for i = currentWaypointIndex, #currentWaypoints do
			local wp = currentWaypoints[i]
			
			-- Only render marker if it is the first node or far enough from the last drawn marker
			if not lastPlacedPos or (wp.Position - lastPlacedPos).Magnitude >= 4 then
				lastPlacedPos = wp.Position
				
				local stepBox = Instance.new("Part")
				stepBox.Name = "PathStep"
				stepBox.Size = Vector3.new(1, 1, 1)
				stepBox.Position = wp.Position + Vector3.new(0, 0.5, 0) -- Rest slightly above ground
				stepBox.Color = Color3.fromRGB(255, 0, 0)
				stepBox.Material = Enum.Material.Neon
				stepBox.Anchored = true
				stepBox.CanCollide = false
				stepBox.Parent = visualFolder
			end
		end
	end
end

----------------------------------------------------------------
-- 5. EMERGENCY RESET AND UNSELECT FUNCTION
----------------------------------------------------------------
_G.StopAllTracking = function()
	_G.TargetPlayer = nil
	_G.SelectedToolName = nil
	currentWaypoints = {}
	_G.ClearVisualMarkers()
	
	local character = _G.GetMyCharacter and _G.GetMyCharacter()
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local rootPart = character:FindFirstChild("HumanoidRootPart")
		if humanoid and rootPart then
			humanoid:MoveTo(rootPart.Position)
		end
		
		local equippedTool = character:FindFirstChildOfClass("Tool")
		local backpack = localPlayer:FindFirstChild("Backpack")
		if equippedTool and backpack then
			equippedTool.Parent = backpack
		end
	end
	
	if _G.UpdatePlayerList then _G.UpdatePlayerList() end
	if _G.UpdateToolList then _G.UpdateToolList() end
	print("All targets cleared and actions halted via emergency stop.")
end

_G.InputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.X then
		_G.StopAllTracking()
	end
end)

----------------------------------------------------------------
-- 6. PATHFINDING & CONTROL TRACKING LOOP
----------------------------------------------------------------
local function computeNewPath(startPos, targetPos)
	local path = PathfindingService:CreatePath({
		AgentRadius = 2,
		AgentHeight = 5,
		AgentCanJump = true
	})
	
	local success, _ = pcall(function() path:ComputeAsync(startPos, targetPos) end)
	if success and path.Status == Enum.PathStatus.Success then
		currentWaypoints = path:GetWaypoints()
		currentWaypointIndex = 1
		renderVisualPath() -- Redraw indicators whenever path layout refreshes
	end
end

local function autoRunLoop()
	if not _G.IsScriptRunning then return end

	local character = _G.GetMyCharacter and _G.GetMyCharacter()
	if not character then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart or humanoid.Health <= 0 then return end

	local targetCharacter = _G.GetTargetCharacter and _G.GetTargetCharacter(_G.TargetPlayer)
	if targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart") then
		local targetRoot = targetCharacter.HumanoidRootPart
		local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
		
		if targetHumanoid and targetHumanoid.Health > 0 then
			local distance = (rootPart.Position - targetRoot.Position).Magnitude
			
			-- Handle Navigation Updates
			local now = tick()
			if now - lastPathUpdateTime > PATH_RECALC_TIME then
				lastPathUpdateTime = now
				computeNewPath(rootPart.Position, targetRoot.Position)
			else
				-- Continuously update the green block position tracking the target
				local trackingMarker = visualFolder:FindFirstChild("TargetMarker")
				if trackingMarker then
					trackingMarker.Position = targetRoot.Position + Vector3.new(0, 4, 0)
				end
			end
			
			if #currentWaypoints > 0 and currentWaypointIndex <= #currentWaypoints then
				local nextWaypoint = currentWaypoints[currentWaypointIndex]
				if (rootPart.Position - nextWaypoint.Position).Magnitude < 3 then
					currentWaypointIndex = currentWaypointIndex + 1
				else
					if nextWaypoint.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
					humanoid:MoveTo(nextWaypoint.Position)
				end
			else
				humanoid:MoveTo(targetRoot.Position)
			end
			
			-- Stutter-Free Weapon Handling
			if _G.SelectedToolName then
				local equippedTool = character:FindFirstChild(_G.SelectedToolName)
				
				if not equippedTool then
					local backpack = localPlayer:FindFirstChild("Backpack")
					local targetTool = backpack and backpack:FindFirstChild(_G.SelectedToolName)
					if targetTool then
						targetTool.Parent = character
					end
				end
				
				if equippedTool and distance < ATTACK_RANGE then
					equippedTool:Activate()
				end
			end
		else
			currentWaypoints = {}
			_G.ClearVisualMarkers()
		end
	else
		-- Clear visuals if no target is active
		if #visualFolder:GetChildren() > 0 then
			_G.ClearVisualMarkers()
		end
	end
end

_G.LoopConnection = RunService.RenderStepped:Connect(autoRunLoop)
