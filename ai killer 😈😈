-- MAIN HEARTBEAT
-- ==========================================================

trackConnection(
	RunService.Heartbeat:
		Connect(function()
			if not running then
				return
			end

			updateCombatMode()
			updateWeapon()
		end)
)

-- ==========================================================
-- VISUAL LOOP
-- ==========================================================

trackConnection(
	RunService.RenderStepped:
		Connect(function()
			if running then
				updateVisuals()
			end
		end)
)

-- ==========================================================
-- X KEY
-- ==========================================================

trackConnection(
	UserInputService.InputBegan:
		Connect(function(
			input,
			processed
		)

			if processed then
				return
			end

			if input.KeyCode
				== Enum.KeyCode.X
			then
				stopTracking()
			end
		end)
)

-- ==========================================================
-- PLAYER EVENTS
-- ==========================================================

trackConnection(
	Players.PlayerAdded:
		Connect(function()
			updatePlayerList()
		end)
)

trackConnection(
	Players.PlayerRemoving:
		Connect(function(player)
			if targetPlayer
				== player
			then
				arrivalKeyToken += 1

				releaseArrivalKey()

				currentPathToken += 1

				combatMode = false
				targetPlayer = nil

				clearVisuals()

				setStatus(
					"Target left"
				)
			end

			updatePlayerList()
		end)
)

