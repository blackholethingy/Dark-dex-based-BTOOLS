-- BACKPACK EVENTS
-- ==========================================================

local backpack =
	localPlayer:
		WaitForChild(
			"Backpack"
		)

trackConnection(
	backpack.ChildAdded:
		Connect(function()
			task.defer(
				updateToolList
			)
		end)
)

trackConnection(
	backpack.ChildRemoved:
		Connect(function()
			task.defer(
				updateToolList
			)
		end)
)

-- ==========================================================
-- CLEANUP
-- ==========================================================

local function cleanup()
	if not running then
		return
	end

	running = false

	arrivalKeyToken += 1

	releaseArrivalKey()

	currentPathToken += 1

	combatMode = false
	targetPlayer = nil
	selectedToolName = nil

	local character =
		getMyCharacter()

	local _,
		humanoid =
		getCharacterState(
			character
		)

	if humanoid then
		humanoid.Jump = false

		humanoid:Move(
			Vector3.zero,
			false
		)
	end

	for _, connection in ipairs(
		connections
	) do
		pcall(function()
			connection:
				Disconnect()
		end)
	end

	table.clear(connections)

	clearVisuals()

	if visualFolder then
		visualFolder:Destroy()
	end

	if screenGui then
		screenGui:Destroy()
	end

	_G.PlayerTrackerCleanup = nil

	print(
		"Player Tracker terminated."
	)
end

_G.PlayerTrackerCleanup =
	cleanup

killButton.MouseButton1Click:
	Connect(
		cleanup
	)

