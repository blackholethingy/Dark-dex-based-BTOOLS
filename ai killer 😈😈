-- ==========================================================
-- VISUAL FUNCTIONS
-- ==========================================================

local function clearVisuals()
	targetHighlight.Enabled = false
	targetHighlight.Adornee = nil

	marker.Transparency = 1

	beam.Enabled = false
	playerAttachment.Parent = nil
end

local function updateVisuals()
	if not running
		or not targetPlayer
	then
		clearVisuals()
		return
	end

	local character =
		getMyCharacter()

	local targetCharacter =
		getTargetCharacter(
			targetPlayer
		)

	local _, _, root =
		getCharacterState(
			character
		)

	local _, _, targetRoot =
		getCharacterState(
			targetCharacter
		)

	if not root
		or not targetRoot
	then
		clearVisuals()
		return
	end

	targetHighlight.Adornee =
		targetCharacter

	targetHighlight.Enabled = true

	marker.Position =
		targetRoot.Position
		- Vector3.new(
			0,
			2.8,
			0
		)

	marker.Transparency = 0

	playerAttachment.Parent = root

	beam.Enabled = true
end

-- ==========================================================
-- PATH CANCELLATION
-- ==========================================================

local function pathCancelled(player, token)
	if not running then
		return true
	end

	if token ~= currentPathToken then
		return true
	end

	if targetPlayer ~= player then
		return true
	end

	if combatMode then
		return true
	end

	return false
end

-- ==========================================================
-- PATHFINDING WORKER
-- ==========================================================

local function walkToSelectedPlayer(
	selectedPlayer,
	token
)

	if pathWorkerRunning then
		return
	end

	pathWorkerRunning = true

	while running
		and not pathCancelled(
			selectedPlayer,
			token
		)
	do

		local character =
			getMyCharacter()

		local targetCharacter =
			getTargetCharacter(
				selectedPlayer
			)

		local char,
			humanoid,
			hrp =
			getCharacterState(
				character
			)

		local targetChar,
			targetHumanoid,
			targetRoot =
			getCharacterState(
				targetCharacter
			)

		if not char
			or not humanoid
			or not hrp
			or not targetChar
			or not targetHumanoid
			or not targetRoot
		then
			setStatus(
				"Waiting for character"
			)

			task.wait(0.25)

			continue
		end

		local distance =
			(
				hrp.Position
				- targetRoot.Position
			).Magnitude

		-- ==================================================
		-- ENTER COMBAT BEFORE GETTING TOO CLOSE
		-- ==================================================

		if distance <= COMBAT_ENTER_DISTANCE then
			combatMode = true

			-- Cancel old route immediately.
			currentPathToken += 1

			-- Stop path movement.
			humanoid:Move(
				Vector3.zero,
				false
			)

			-- Stop path jumps.
			humanoid.Jump = false

			setStatus(
				"Combat range"
			)

			break
		end

		local targetPosition =
			targetRoot.Position

		setStatus(
			"Computing path"
		)

		local path =
			PathfindingService:CreatePath({
				AgentRadius =
					PATH_AGENT_RADIUS,

				AgentHeight =
					PATH_AGENT_HEIGHT,

				AgentCanJump =
					true,

				WaypointSpacing =
					PATH_WAYPOINT_SPACING
			})

		local success =
			pcall(function()
				path:ComputeAsync(
					hrp.Position,
					targetPosition
				)
			end)

		if success
			and path.Status
				== Enum.PathStatus.Success
		then

			local lastPosition =
				hrp.Position

			local stuckTimer = 0

			local waypoints =
				path:GetWaypoints()

			local needRepath =
				false

			setStatus(
				"Path: "
					.. tostring(
						#waypoints
					)
					.. " nodes"
			)

			for i, waypoint in ipairs(
				waypoints
			) do
				if i == 1 then
					continue
				end

				if pathCancelled(
					selectedPlayer,
					token
				) then
					break
				end

				character =
					getMyCharacter()

				targetCharacter =
					getTargetCharacter(
						selectedPlayer
					)

				char,
					humanoid,
					hrp =
					getCharacterState(
						character
					)

				targetChar,
					targetHumanoid,
					targetRoot =
					getCharacterState(
						targetCharacter
					)

				if not humanoid
					or not hrp
					or not targetRoot
				then
					break
				end

				local combatDistance =
					(
						hrp.Position
						- targetRoot.Position
					).Magnitude

				-- ==========================================
				-- STOP PATHFINDING EARLY FOR COMBAT
				-- ==========================================

				if combatDistance
					<= COMBAT_ENTER_DISTANCE
				then
					combatMode = true

					currentPathToken += 1

					humanoid:Move(
						Vector3.zero,
						false
					)

					humanoid.Jump =
						false

					setStatus(
						"Combat range"
					)

					break
				end

				if waypoint.Action
					== Enum.PathWaypointAction.Jump
				then
					humanoid.Jump =
						true
				end

				local reachedNode =
					false

				local nodeTimeout =
					0

				setStatus(
					"Node "
						.. tostring(i)
						.. "/"
						.. tostring(
							#waypoints
						)
				)

				while not reachedNode
					and nodeTimeout
						< NODE_TIMEOUT
				do
					character =
						getMyCharacter()

					targetCharacter =
						getTargetCharacter(
							selectedPlayer
						)

					char,
						humanoid,
						hrp =
						getCharacterState(
							character
						)

					targetChar,
						targetHumanoid,
						targetRoot =
						getCharacterState(
							targetCharacter
						)

					if not humanoid
						or not hrp
						or not targetRoot
					then
						break
					end

					local combatDistanceNow =
						(
							hrp.Position
							- targetRoot.Position
						).Magnitude

					-- ======================================
					-- IMMEDIATE COMBAT TRANSITION
					-- ======================================

					if combatDistanceNow
						<= COMBAT_ENTER_DISTANCE
					then
						combatMode = true

						currentPathToken += 1

						humanoid:Move(
							Vector3.zero,
							false
						)

						humanoid.Jump =
							false

						setStatus(
							"Combat range"
						)

						break
					end

					if pathCancelled(
						selectedPlayer,
						token
					) then
						break
					end

					local diffVector =
						waypoint.Position
						- hrp.Position

					local arrivalDistance

					if i == #waypoints then
						arrivalDistance =
							FINAL_NODE_DISTANCE
					else
						arrivalDistance =
							NORMAL_NODE_DISTANCE
					end

					if diffVector.Magnitude
						<= arrivalDistance
					then
						reachedNode =
							true

						break
					end

					stuckTimer +=
						0.015

					if stuckTimer
						>= STUCK_CHECK_TIME
					then
						local moved =
							(
								hrp.Position
								- lastPosition
							).Magnitude

						if moved
							<= STUCK_DISTANCE
						then
							humanoid.Jump =
								true

							local flat =
								Vector3.new(
									diffVector.X,
									0,
									diffVector.Z
								)

							if flat.Magnitude
								> 0.001
							then
								local forward =
									flat.Unit

								for _ = 1, 20 do
									if combatMode then
										break
									end

									humanoid:Move(
										forward,
										false
									)

									RunService.PostSimulation:
										Wait()
								end
							end
						end

						lastPosition =
							hrp.Position

						stuckTimer = 0
					end

					if combatMode then
						break
					end

					local flatDirection =
						Vector3.new(
							diffVector.X,
							0,
							diffVector.Z
						)

					if flatDirection.Magnitude
						> 0.001
					then
						humanoid:Move(
							flatDirection.Unit,
							false
						)
					end

					RunService.PostSimulation:
						Wait()

					nodeTimeout +=
						0.015
				end

				if combatMode
					or pathCancelled(
						selectedPlayer,
						token
					)
				then
					break
				end

				targetCharacter =
					getTargetCharacter(
						selectedPlayer
					)

				targetRoot =
					targetCharacter
					and targetCharacter:
						FindFirstChild(
							"HumanoidRootPart"
						)

				if targetRoot then
					local movement =
						(
							targetRoot.Position
							- targetPosition
						).Magnitude

					if movement
						>= PATH_REPATH_DISTANCE
					then
						needRepath =
							true

						break
					end
				end
			end

			if humanoid and not combatMode then
				humanoid:Move(
					Vector3.zero,
					false
				)
			end

			if not combatMode then
				if needRepath then
					task.wait(0.05)
				else
					task.wait(0.1)
				end
			end
		else
			humanoid:Move(
				Vector3.zero,
				false
			)

			setStatus(
				"No path - retrying"
			)

			task.wait(0.25)
		end
	end

	pathWorkerRunning = false
end

-- ==========================================================
-- START PATHFINDING
-- ==========================================================

local function startPathfinding()
	if not targetPlayer
		or combatMode
		or pathWorkerRunning
	then
		return
	end

	currentPathToken += 1

	local token =
		currentPathToken

	task.spawn(
		walkToSelectedPlayer,
		targetPlayer,
		token
	)
end

-- ==========================================================
-- COMBAT CONTROL
-- ==========================================================

local function updateCombatMode()
	if not running
		or not targetPlayer
	then
		return
	end

	local character =
		getMyCharacter()

	local targetCharacter =
		getTargetCharacter(
			targetPlayer
		)

	local _,
		humanoid,
		root =
		getCharacterState(
			character
		)

	local _,
		targetHumanoid,
		targetRoot =
		getCharacterState(
			targetCharacter
		)

	if not humanoid
		or not root
		or not targetHumanoid
		or not targetRoot
	then
		return
	end

	local difference =
		targetRoot.Position
		- root.Position

	local distance =
		difference.Magnitude

	-- ======================================================
	-- ENTER COMBAT MODE
	-- ======================================================

	if not combatMode
		and distance <= COMBAT_ENTER_DISTANCE
	then
		combatMode = true

		-- Cancel path immediately.
		currentPathToken += 1

		-- Remove path movement.
		humanoid:Move(
			Vector3.zero,
			false
		)

		-- Absolutely stop jumping.
		humanoid.Jump = false

		setStatus(
			"COMBAT - attacking"
		)
	end

	-- ======================================================
	-- COMBAT MODE
	-- ======================================================

	if combatMode then
		-- Prevent pathfinding jump behavior.
		humanoid.Jump = false

		-- If the target escaped, resume pathfinding.
		if distance >= COMBAT_EXIT_DISTANCE then
			combatMode = false

			arrivalKeyToken += 1
			releaseArrivalKey()

			setStatus(
				"Target moved away"
			)

			startPathfinding()

			return
		end

		-- ==============================================
		-- TOO FAR INSIDE COMBAT ZONE
		--
		-- Move directly a little closer.
		-- This is deliberately NOT pathfinding.
		-- ==============================================

		if distance > COMBAT_HOLD_DISTANCE then
			local flat =
				Vector3.new(
					difference.X,
					0,
					difference.Z
				)

			if flat.Magnitude > 0.05 then
				humanoid:Move(
					flat.Unit,
					false
				)
			end
		else
			-- Close enough to hit:
			-- stop movement completely.
			humanoid:Move(
				Vector3.zero,
				false
			)

			if HOLD_KEY_ENABLED
				and not holdingArrivalKey
			then
				holdArrivalKey()
			end
		end
	end
end

-- ==========================================================
-- START TRACKING
-- ==========================================================

local function startTracking(player)
	arrivalKeyToken += 1
	releaseArrivalKey()

	currentPathToken += 1

	combatMode = false

	targetPlayer = player

	if not player then
		setStatus("Idle")
		return
	end

	setStatus(
		"Starting path"
	)

	startPathfinding()
end

-- ==========================================================
-- PLAYER LIST
-- ==========================================================

local function updatePlayerList()
	for _, child in ipairs(
		playerScroller:GetChildren()
	) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _, player in ipairs(
		Players:GetPlayers()
	) do
		if player ~= localPlayer then
			local button =
				Instance.new(
					"TextButton"
				)

			button.Size =
				UDim2.new(
					1,
					-6,
					0,
					30
				)

			button.Text =
				player.Name

			button.Font =
				Enum.Font.SourceSans

			button.TextSize = 14

			button.TextColor3 =
				Color3.fromRGB(
					255,
					255,
					255
				)

			button.BorderSizePixel = 0

			if targetPlayer == player then
				button.BackgroundColor3 =
					Color3.fromRGB(
						0,
						145,
						80
					)
			else
				button.BackgroundColor3 =
					Color3.fromRGB(
						58,
						58,
						64
					)
			end

			button.Parent =
				playerScroller

			button.MouseButton1Click:
				Connect(function()
					if targetPlayer
						== player
					then
						arrivalKeyToken += 1

						releaseArrivalKey()

						currentPathToken += 1

						combatMode = false
						targetPlayer = nil

						local character =
							getMyCharacter()

						local _,
							humanoid =
							getCharacterState(
								character
							)

						if humanoid then
							humanoid.Jump = false

							humanoid:Move(
								Vector3.zero,
								false
							)
						end

						setStatus(
							"Idle"
						)
					else
						startTracking(
							player
						)
					end

					updatePlayerList()
				end)
		end
	end

	task.defer(function()
		playerScroller.CanvasSize =
			UDim2.new(
				0,
				0,
				0,
				playerLayout.AbsoluteContentSize.Y
				+ 5
			)
	end)
end

-- ==========================================================
-- TOOL LIST
-- ==========================================================

local function updateToolList()
	for _, child in ipairs(
		toolScroller:GetChildren()
	) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local shown = {}

	local function scan(container)
		if not container then
			return
		end

		for _, object in ipairs(
			container:GetChildren()
		) do
			if object:IsA("Tool")
				and not shown[
					object.Name
				]
			then
				shown[
					object.Name
				] = true

				local button =
					Instance.new(
						"TextButton"
					)

				button.Size =
					UDim2.new(
						1,
						-6,
						0,
						30
					)

				button.Text =
					object.Name

				button.Font =
					Enum.Font.SourceSans

				button.TextSize = 14

				button.TextColor3 =
					Color3.fromRGB(
						255,
						255,
						255
					)

				button.BorderSizePixel = 0

				if selectedToolName
					== object.Name
				then
					button.BackgroundColor3 =
						Color3.fromRGB(
							0,
							110,
							180
						)
				else
					button.BackgroundColor3 =
						Color3.fromRGB(
							58,
							58,
							64
						)
				end

				button.Parent =
					toolScroller

				button.MouseButton1Click:
					Connect(function()
						if selectedToolName
							== object.Name
						then
							selectedToolName =
								nil
						else
							selectedToolName =
								object.Name
						end

						updateToolList()
					end)
			end
		end
	end

	scan(
		localPlayer:
			FindFirstChild(
				"Backpack"
			)
	)

	scan(
		getMyCharacter()
	)

	task.defer(function()
		toolScroller.CanvasSize =
			UDim2.new(
				0,
				0,
				0,
				toolLayout.AbsoluteContentSize.Y
				+ 5
			)
	end)
end

-- ==========================================================
-- WEAPON SYSTEM
-- ==========================================================

local function updateWeapon()
	if not running
		or not targetPlayer
		or not selectedToolName
	then
		return
	end

	local character =
		getMyCharacter()

	local targetCharacter =
		getTargetCharacter(
			targetPlayer
		)

	local _,
		humanoid,
		root =
		getCharacterState(
			character
		)

	local _,
		targetHumanoid,
		targetRoot =
		getCharacterState(
			targetCharacter
		)

	if not humanoid
		or not root
		or not targetHumanoid
		or not targetRoot
	then
		return
	end

	local tool =
		character:
			FindFirstChild(
				selectedToolName
			)

	if not tool then
		local backpack =
			localPlayer:
				FindFirstChild(
					"Backpack"
				)

		tool =
			backpack
			and backpack:
				FindFirstChild(
					selectedToolName
				)

		if tool then
			tool.Parent = character
		end
	end

	if not tool
		or not tool:IsA("Tool")
	then
		return
	end

	local distance =
		(
			root.Position
			- targetRoot.Position
		).Magnitude

	if distance <= ATTACK_RANGE then
		local now =
			os.clock()

		if now - lastAttack >= 0.18 then
			lastAttack = now

			pcall(function()
				tool:Activate()
			end)
		end
	end
end

-- ==========================================================
-- STOP TRACKING
-- ==========================================================

local function stopTracking()
	arrivalKeyToken += 1

	releaseArrivalKey()

	currentPathToken += 1

	combatMode = false

	targetPlayer = nil
	selectedToolName = nil

	clearVisuals()

	local character =
		getMyCharacter()

	local _,
		humanoid =
		getCharacterState(
			character
		)

	if humanoid then
		humanoid.Jump = false

		humanoid:Move(
			Vector3.zero,
			false
		)
	end

	if character then
		local equipped =
			character:
				FindFirstChildOfClass(
					"Tool"
				)

		local backpack =
			localPlayer:
				FindFirstChild(
					"Backpack"
				)

		if equipped
			and backpack
		then
			equipped.Parent =
				backpack
		end
	end

	setStatus(
		"Stopped"
	)

	updatePlayerList()
	updateToolList()
end

stopButton.MouseButton1Click:
	Connect(
		stopTracking
	)

