local RunService = game:GetService("RunService")
local localPlayer = game:GetService("Players").LocalPlayer

local ATTACK_RANGE = 8
local VERTICAL_JUMP_THRESHOLD = 4  -- Target is 4+ studs higher
local VERTICAL_DROP_THRESHOLD = -4 -- Target is 4+ studs lower

-- Folder validation directly onto global structure layers
local visualFolder = workspace:FindFirstChild("TrackerVisuals")
