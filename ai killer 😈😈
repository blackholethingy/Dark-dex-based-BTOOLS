-- ==========================================================
-- VISUAL CONTROL
-- ==========================================================

local function clearVisuals()

	targetHighlight.Enabled =
		false

	targetHighlight.Adornee =
		nil

	marker.Transparency =
		1

	beam.Enabled =
		false

	playerAttachment.Parent =
		nil
end

local function updateVisuals()

	if not running
		or not targetPlayer
	then
		clearVisuals()
		return
	end

	local character =
		getMyCharacter()

	local targetCharacter =
		getTargetCharacter(
			targetPlayer
		)

	if not character
		or not targetCharacter
	then
		clearVisuals()
		return
	end

	local _, _, myRoot =
		getCharacterState(
			character
		)

	local _, _, targetRoot =
		getCharacterState(
			targetCharacter
		)

	if not myRoot
		or not targetRoot
	then
		clearVisuals()
		return
	end

	targetHighlight.Adornee =
		targetCharacter

	targetHighlight.Enabled =
		true

	marker.Position =
		targetRoot.Position
		- Vector3.new(
			0,
			2.8,
			0
		)

	marker.Transparency =
		0

	playerAttachment.Parent =
		myRoot

	beam.Enabled =
		true
end

-- ==========================================================
-- PATH CANCEL CHECK
-- ==========================================================

local function pathCancelled(
	player,
	token
)

	if not running then
		return true
	end

	if token ~= currentPathToken then
		return true
	end

	if targetPlayer ~= player then
		return true
	end

	return false
end

-- ==========================================================
-- WORKING PATH LOGIC TRANSPLANTED
-- ==========================================================

local function walkToSelectedPlayer(
	selectedPlayer,
	token
)

	if pathWorkerRunning then
		return
	end

	pathWorkerRunning =
		true

	while running
		and not pathCancelled(
			selectedPlayer,
			token
		)
	do

		local character =
			getMyCharacter()

		local targetCharacter =
			getTargetCharacter(
				selectedPlayer
			)

		local char,
			humanoid,
			hrp =
			getCharacterState(
				character
			)

		local targetChar,
			targetHumanoid,
			targetRoot =
			getCharacterState(
				targetCharacter
			)

		if not char
			or not humanoid
			or not hrp
			or not targetChar
			or not targetHumanoid
			or not targetRoot
		then

			setStatus(
				"Waiting for character"
			)

			task.wait(0.25)

			continue
		end

		local distance =
			(
				hrp.Position
				- targetRoot.Position
			).Magnitude

		if distance <= STOP_DISTANCE then

			humanoid:Move(
				Vector3.zero,
				false
			)

			setStatus(
				"Reached target"
			)

			task.wait(0.1)

			continue
		end

		local targetPosition =
			targetRoot.Position

		setStatus(
			"Computing path"
		)

		-- ==================================================
		-- EXACT STYLE FROM WORKING SOURCE
		-- ==================================================

		local path =
			PathfindingService:CreatePath({
				AgentRadius =
					PATH_AGENT_RADIUS,

				AgentHeight =
					PATH_AGENT_HEIGHT,

				AgentCanJump =
					true,

				WaypointSpacing =
					PATH_WAYPOINT_SPACING
			})

		local success =
			pcall(function()

				path:ComputeAsync(
					hrp.Position,
					targetPosition
				)

			end)

		if success
			and path.Status
				== Enum.PathStatus.Success
		then

			local lastPosition =
				hrp.Position

			local stuckTimer =
				0

			local waypoints =
				path:GetWaypoints()

			setStatus(
				"Path: "
					.. tostring(
						#waypoints
					)
					.. " nodes"
			)

			local needRepath =
				false

			-- ==============================================
			-- WALK THE PATH
			-- ==============================================

			for i, waypoint in ipairs(
				waypoints
			) do

				if i == 1 then
					continue
				end

				character =
					getMyCharacter()

				targetCharacter =
					getTargetCharacter(
						selectedPlayer
					)

				char,
					humanoid,
					hrp =
					getCharacterState(
						character
					)

				targetChar,
					targetHumanoid,
					targetRoot =
					getCharacterState(
						targetCharacter
					)

				if pathCancelled(
					selectedPlayer,
					token
				)
					or not hrp
					or not humanoid
					or not targetRoot
				then

					break
				end

				-- ==========================================
				-- JUMP WAYPOINT
				-- ==========================================

				if waypoint.Action
					== Enum.PathWaypointAction.Jump
				then

					humanoid.Jump =
						true
				end

				local reachedNode =
					false

				local nodeTimeout =
					0

				setStatus(
					"Node "
						.. tostring(i)
						.. "/"
						.. tostring(
							#waypoints
						)
				)

				-- ==========================================
				-- EXACT WORKING LOOP
				-- ==========================================

				while not reachedNode
					and nodeTimeout
						< NODE_TIMEOUT
				do

					character =
						getMyCharacter()

					targetCharacter =
						getTargetCharacter(
							selectedPlayer
						)

					char,
						humanoid,
						hrp =
						getCharacterState(
							character
						)

					targetChar,
						targetHumanoid,
						targetRoot =
						getCharacterState(
							targetCharacter
						)

					if pathCancelled(
						selectedPlayer,
						token
					)
						or not hrp
						or not humanoid
						or not targetRoot
					then

						break
					end

					-- ======================================
					-- THIS IS THE IMPORTANT PART:
					-- CURRENT WAYPOINT, NOT TARGET
					-- ======================================

					local diffVector =
						waypoint.Position
						- hrp.Position

					local arrivalDistance

					if i == #waypoints then
						arrivalDistance =
							FINAL_NODE_DISTANCE
					else
						arrivalDistance =
							NORMAL_NODE_DISTANCE
					end

					if diffVector.Magnitude
						<= arrivalDistance
					then

						reachedNode =
							true

						break
					end

					-- ======================================
					-- ANTI-STUCK
					-- ======================================

					stuckTimer =
						stuckTimer
						+ 0.015

					if stuckTimer
						>= STUCK_CHECK_TIME
					then

						local distanceMoved =
							(
								hrp.Position
								- lastPosition
							).Magnitude

						if distanceMoved
							<= STUCK_DISTANCE
						then

							humanoid.Jump =
								true

							local flat =
								Vector3.new(
									diffVector.X,
									0,
									diffVector.Z
								)

							if flat.Magnitude
								> 0.001
							then

								local forwardVector =
									flat.Unit

								for _ = 1, 20 do

									character =
										getMyCharacter()

									char,
										humanoid,
										hrp =
										getCharacterState(
											character
										)

									if pathCancelled(
										selectedPlayer,
										token
									)
										or not humanoid
										or not hrp
									then

										break
									end

									humanoid:Move(
										forwardVector,
										false
									)

									RunService.PostSimulation:
										Wait()
								end
							end
						end

						lastPosition =
							hrp.Position

						stuckTimer =
							0
					end

					-- ======================================
					-- EXACT SAME MOVEMENT IDEA
					-- MOVE TOWARD WAYPOINT
					-- ======================================

					local flatDirection =
						Vector3.new(
							diffVector.X,
							0,
							diffVector.Z
						)

					if flatDirection.Magnitude
						> 0.001
					then

						humanoid:Move(
							flatDirection.Unit,
							false
						)
					end

					RunService.PostSimulation:
						Wait()

					nodeTimeout =
						nodeTimeout
						+ 0.015
				end

				if pathCancelled(
					selectedPlayer,
					token
				) then
					break
				end

				-- ==========================================
				-- CHECK HOW FAR TARGET MOVED
				-- ==========================================

				targetCharacter =
					getTargetCharacter(
						selectedPlayer
					)

				targetRoot =
					targetCharacter
					and targetCharacter:
						FindFirstChild(
							"HumanoidRootPart"
						)

				if targetRoot then

					local movement =
						(
							targetRoot.Position
							- targetPosition
						).Magnitude

					if movement
						>= PATH_REPATH_DISTANCE
					then

						needRepath =
							true

						break
					end
				end
			end

			if humanoid then
				humanoid:Move(
					Vector3.zero,
					false
				)
			end

			if needRepath then

				setStatus(
					"Target moved - repathing"
				)

				task.wait(0.05)

			else

				task.wait(0.1)
			end

		else

			-- ==============================================
			-- IMPORTANT:
			-- NO STRAIGHT-LINE FALLBACK
			-- ==============================================

			humanoid:Move(
				Vector3.zero,
				false
			)

			setStatus(
				"No path - retrying"
			)

			task.wait(0.25)
		end
	end

	pathWorkerRunning =
		false
end

-- ==========================================================
-- START TRACKING
-- ==========================================================

local function startTracking(player)

	currentPathToken += 1

	targetPlayer =
		player

	if not player then

		setStatus("Idle")

		return
	end

	local token =
		currentPathToken

	setStatus(
		"Starting path"
	)

	task.spawn(
		walkToSelectedPlayer,
		player,
		token
	)
end

