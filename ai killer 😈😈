-- ==========================================================

local function getHoldKey()
	return keyOptions[currentKeyIndex].Key
end

local function getHoldKeyName()
	return keyOptions[currentKeyIndex].Name
end

local function getHoldDuration()
	return durationOptions[currentDurationIndex].Value
end

local function getHoldDurationName()
	return durationOptions[currentDurationIndex].Name
end

-- ==========================================================
-- ARRIVAL KEY CONTROL
-- ==========================================================

local function releaseArrivalKey()
	if not holdingArrivalKey then
		return
	end

	holdingArrivalKey = false

	local key = getHoldKey()

	pcall(function()
		VirtualInputManager:SendKeyEvent(
			false,
			key,
			false,
			game
		)
	end)
end

local function holdArrivalKey()
	if not HOLD_KEY_ENABLED then
		return
	end

	arrivalKeyToken += 1

	local token = arrivalKeyToken

	releaseArrivalKey()

	local key = getHoldKey()
	local duration = getHoldDuration()

	holdingArrivalKey = true

	pcall(function()
		VirtualInputManager:SendKeyEvent(
			true,
			key,
			false,
			game
		)
	end)

	if duration == math.huge then
		return
	end

	task.spawn(function()
		local started = os.clock()

		while running
			and holdingArrivalKey
			and arrivalKeyToken == token
			and os.clock() - started < duration
		do
			task.wait(0.05)
		end

		if arrivalKeyToken == token then
			releaseArrivalKey()
		end
	end)
end

-- ==========================================================
-- CHARACTER HELPERS
-- ==========================================================

local function getMyCharacter()
	local folder = workspace:FindFirstChild("Characters")

	if folder then
		local named = folder:FindFirstChild(localPlayer.Name)

		if named then
			return named
		end

		local special = folder:FindFirstChild("AreWeAloneOnEarth")

		if special then
			return special
		end
	end

	return localPlayer.Character
end

local function getTargetCharacter(player)
	if not player then
		return nil
	end

	local folder = workspace:FindFirstChild("Characters")

	if folder then
		local custom = folder:FindFirstChild(player.Name)

		if custom then
			return custom
		end
	end

	return player.Character
end

local function getCharacterState(character)
	if not character then
		return nil, nil, nil
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if humanoid
		and root
		and humanoid.Health > 0
	then
		return character, humanoid, root
	end

	return nil, nil, nil
end

