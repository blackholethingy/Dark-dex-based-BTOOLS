ui.TPButton.MouseButton1Click:Connect(function()
	if countdownActive then return end 
	
	local totalItems = #discoveredMatches
	if totalItems == 0 then return end
	
	local startCFrame, platX, platZ, rowLimit = generateDynamicPlatform(totalItems)
	
	local spacing = 7 
	local halfX = platX / 2
	local halfZ = platZ / 2
	
	for index, obj in ipairs(discoveredMatches) do
		saveOriginalTransform(obj)
		
		local rowIndex = math.floor((index - 1) / rowLimit)
		local colIndex = (index - 1) % rowLimit
		
		local offsetX = -halfX + (colIndex * spacing) + (spacing / 2)
		local offsetZ = -halfZ + (rowIndex * spacing) + (spacing / 2)
		local offsetHeight = 1.5 
		
		local targetWorldPos = (startCFrame * CFrame.new(offsetX, offsetHeight, offsetZ)).Position
		
		pcall(function()
			snapPosition(obj, targetWorldPos)
		end)
	end
	print("Part 3 Logic Core Loop running successfully.")
end)
