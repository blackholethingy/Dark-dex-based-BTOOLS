local function resolveStringToInstance(pathString)
	local segments = {}
	for seg in string.gmatch(pathString, "[^.]+") do 
		table.insert(segments, seg) 
	end
	
	local currentObj = game
	local firstSegment = segments[1]
	
	if firstSegment and (string.lower(firstSegment) == "workspace") then
		currentObj = workspace
	elseif firstSegment and string.lower(firstSegment) == "game" then
		currentObj = game
	else 
		return nil
	end
	
	for i = 2, #segments do
		if currentObj then
			currentObj = currentObj:FindFirstChild(segments[i])
		else
			return nil
		end
	end
	return currentObj
end

local function saveOriginalTransform(obj)
	if originalTransforms[obj] then return end 
	
	if obj:IsA("BasePart") then
		originalTransforms[obj] = {
			CFrame = obj.CFrame,
			Anchored = obj.Anchored
		}
	elseif obj:IsA("Model") then
		originalTransforms[obj] = {
			CFrame = obj:GetPivot(),
			PartsData = {}
		}
		for _, part in ipairs(obj:GetDescendants()) do
			if part:IsA("BasePart") then
				originalTransforms[obj].PartsData[part] = part.Anchored
			end
		end
	end
end

local function snapPosition(obj, position)
	if obj:IsA("BasePart") then
		obj.Anchored = true 
		obj.CFrame = CFrame.new(position)
	elseif obj:IsA("Model") then
		obj:PivotTo(CFrame.new(position))
		for _, part in ipairs(obj:GetDescendants()) do
			if part:IsA("BasePart") then part.Anchored = true end
		end
	end
end

local function executeCleanReclaim()
	countdownActive = false
	print("Timer zeroed out. Reclaiming objects cleanly...")
	
	for obj, data in pairs(originalTransforms) do
		pcall(function()
			if obj:IsA("BasePart") then
				obj.CFrame = data.CFrame
				obj.Anchored = data.Anchored
			elseif obj:IsA("Model") then
				obj:PivotTo(data.CFrame)
				for part, wasAnchored in pairs(data.PartsData) do
					if part and part.Parent then part.Anchored = wasAnchored end
				end
			end
		end)
	end
	
	if targetPlatformInstance and targetPlatformInstance.Parent then
		targetPlatformInstance:Destroy()
		targetPlatformInstance = nil
	end
	
	originalTransforms = {}
	print("Reclaim complete.")
end

local function generateDynamicPlatform(itemCount)
	if targetPlatformInstance and targetPlatformInstance.Parent then
		targetPlatformInstance:Destroy()
	end
	
	local itemsPerRow = math.ceil(math.sqrt(itemCount))
	local sizeX = math.max(15, itemsPerRow * 8)
	local sizeZ = math.max(15, math.ceil(itemCount / itemsPerRow) * 8)
	
	local plat = Instance.new("Part")
	plat.Name = "SortPlatform_Engine"
	plat.Size = Vector3.new(sizeX, 1, sizeZ)
	
	local platformYOffset = hrp.Position.Y - (humanoid.HipHeight + 2)
	plat.CFrame = CFrame.new(hrp.Position.X, platformYOffset, hrp.Position.Z)
	
	plat.Anchored = true
	plat.CanCollide = true
	plat.Material = Enum.Material.SmoothPlastic
	plat.Color = Color3.fromRGB(40, 40, 45)
	plat.Parent = workspace
	
	targetPlatformInstance = plat
	return plat.CFrame, sizeX, sizeZ, itemsPerRow
end

