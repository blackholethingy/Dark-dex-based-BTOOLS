-- ==========================================================
-- CONNECTION TRACKER
-- ==========================================================

local function trackConnection(connection)
	table.insert(
		connections,
		connection
	)

	return connection
end

-- ==========================================================
-- MOTOR LOOKUP
-- ==========================================================

local function findMotor(name)

	for _, object in ipairs(
		character:GetDescendants()
	) do

		if object:IsA("Motor6D")
			and object.Name == name
		then

			return object
		end
	end

	return nil
end

local rootJoint =
	findMotor("RootJoint")

local neck =
	findMotor("Neck")

local leftShoulder =
	findMotor("Left Shoulder")

local rightShoulder =
	findMotor("Right Shoulder")

local leftHip =
	findMotor("Left Hip")

local rightHip =
	findMotor("Right Hip")

-- ==========================================================
-- RAGDOLL OBJECT TRACKER
-- ==========================================================

local function rememberRagdollObject(object)

	table.insert(
		createdRagdollObjects,
		object
	)

	return object
end

-- ==========================================================
-- ATTACHMENTS
-- ==========================================================

local function makeAttachment(
	part,
	cframe,
	name
)

	local attachment =
		Instance.new("Attachment")

	attachment.Name =
		name

	attachment.CFrame =
		cframe

	attachment.Parent =
		part

	return rememberRagdollObject(
		attachment
	)
end

-- ==========================================================
-- SOCKETS
-- ==========================================================

local function makeBallSocket(
	motor,
	name,
	upperAngle,
	twistLower,
	twistUpper
)

	if not motor then
		return
	end

	local part0 =
		motor.Part0

	local part1 =
		motor.Part1

	if not part0
		or not part1
	then
		return
	end

	local attachment0 =
		makeAttachment(
			part0,
			motor.C0,
			name .. "_A0"
		)

	local attachment1 =
		makeAttachment(
			part1,
			motor.C1,
			name .. "_A1"
		)

	local socket =
		Instance.new(
			"BallSocketConstraint"
		)

	socket.Name =
		name

	socket.Attachment0 =
		attachment0

	socket.Attachment1 =
		attachment1

	socket.LimitsEnabled =
		true

	socket.UpperAngle =
		upperAngle

	socket.TwistLimitsEnabled =
		true

	socket.TwistLowerAngle =
		twistLower

	socket.TwistUpperAngle =
		twistUpper

	socket.Restitution =
		0

	socket.Parent =
		part0

	return rememberRagdollObject(
		socket
	)
end

-- ==========================================================
-- COLLISION MEMORY
-- ==========================================================

local function rememberCollisionStates()

	originalCollision =
		{}

	for _, object in ipairs(
		character:GetChildren()
	) do

		if object:IsA("BasePart") then

			originalCollision[
				object
			] =
				object.CanCollide
		end
	end
end

-- ==========================================================
-- TORSO-ONLY COLLISIONS
-- ==========================================================

local function applyFunnyRagdollCollisions()

	for _, object in ipairs(
		character:GetChildren()
	) do

		if object:IsA("BasePart") then

			object.CanCollide =
				false
		end
	end

	-- ONLY THE TORSO COLLIDES.
	torso.CanCollide =
		true

	root.CanCollide =
		false

	head.CanCollide =
		false

	leftArm.CanCollide =
		false

	rightArm.CanCollide =
		false

	leftLeg.CanCollide =
		false

	rightLeg.CanCollide =
		false
end

