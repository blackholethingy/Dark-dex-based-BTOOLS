-- FORWARD DECLARATION
-- ==========================================================

local unragdoll

-- ==========================================================
-- ENTER RAGDOLL
-- ==========================================================

local function ragdoll(
	preservedVelocity,
	preservedAngular
)

	if not running
		or ragdolled
	then

		return
	end

	doingTrick =
		false

	autoGetUpToken +=
		1

	local thisToken =
		autoGetUpToken

	local linearVelocity =
		preservedVelocity
		or root.AssemblyLinearVelocity

	local angularVelocity =
		preservedAngular
		or root.AssemblyAngularVelocity

	-- ======================================================
	-- SAVE ORIGINAL STATE
	-- ======================================================

	saveMotorStates()

	saveCollisionStates()

	savePhysicalProperties()

	ragdolled =
		true

	-- ======================================================
	-- HUMANOID
	-- ======================================================

	humanoid.AutoRotate =
		false

	humanoid.PlatformStand =
		true

	humanoid:ChangeState(
		Enum.HumanoidStateType.Physics
	)

	-- ======================================================
	-- RAGDOLL JOINTS
	-- ======================================================

	createRagdollJoints()

	disableMotors()

	-- ======================================================
	-- BACKUP COLLIDER
	-- ======================================================

	local backupCollider =
		createBackupTorsoCollider()

	-- ======================================================
	-- COLLISION
	-- ======================================================

	enforceRagdollCollision()

	if collisionEnforcer then

		collisionEnforcer:
			Disconnect()
	end

	collisionEnforcer =
		RunService.PostSimulation:
			Connect(function()

				if running
					and ragdolled
				then

					enforceRagdollCollision()
				end
			end)

	-- ======================================================
	-- PHYSICAL CONTACT BOUNCE
	-- ======================================================

	startBounceSystem(
		backupCollider
	)

	-- ======================================================
	-- MOMENTUM
	-- ======================================================

	if config.PreserveMomentum then

		torso.AssemblyLinearVelocity =
			linearVelocity

		root.AssemblyLinearVelocity =
			linearVelocity

		torso.AssemblyAngularVelocity =
			angularVelocity
	end

	-- ======================================================
	-- EXTRA FLOP
	-- ======================================================

	if config.ExtraFlop then

		torso.AssemblyAngularVelocity +=
			Vector3.new(
				math.random(-8, 8),
				math.random(-5, 5),
				math.random(-8, 8)
			)
	end

	-- ======================================================
	-- AUTO GET UP
	-- ======================================================

	if config.AutoGetUp then

		task.delay(
			config.AutoGetUpDelay,

			function()

				if not running
					or not ragdolled
				then

					return
				end

				if thisToken
					~= autoGetUpToken
				then

					return
				end

				unragdoll()
			end
		)
	end
end

-- ==========================================================
-- UNRAGDOLL
-- ==========================================================

unragdoll =
	function()

		if not ragdolled then
			return
		end

		autoGetUpToken +=
			1

		-- ==================================================
		-- STOP RAGDOLL CONNECTIONS FIRST
		-- ==================================================

		disconnectRagdollConnections()

		velocityTracker =
			nil

		if collisionEnforcer then

			collisionEnforcer:
				Disconnect()

			collisionEnforcer =
				nil
		end

		ragdolled =
			false

		-- ==================================================
		-- REMOVE SOCKETS / COLLIDER
		-- ==================================================

		destroyRagdollObjects()

		-- ==================================================
		-- RESTORE ORIGINAL STATES
		-- ==================================================

		restoreMotorStates()

		restoreCollisionStates()

		restorePhysicalProperties()

		-- ==================================================
		-- UPRIGHT
		-- ==================================================

		makeRootUpright()

		root.AssemblyAngularVelocity =
			Vector3.zero

		torso.AssemblyAngularVelocity =
			Vector3.zero

		humanoid.PlatformStand =
			false

		humanoid.AutoRotate =
			true

		humanoid:ChangeState(
			Enum.HumanoidStateType.GettingUp
		)
	end

-- ==========================================================
-- RAGDOLL TOGGLE
-- ==========================================================

local function toggleRagdoll()

	if doingTrick then
		return
	end

	if ragdolled then
		unragdoll()
	else
		ragdoll()
	end
end

-- ==========================================================
-- STUNTS
-- ==========================================================

local function stuntFails()

	return math.random(
		1,
		100
	)
	<= config.FailureChance
end

local function beginTrick()

	if not running
		or ragdolled
		or doingTrick
	then

		return false
	end

	doingTrick =
		true

	humanoid.AutoRotate =
		false

	humanoid.PlatformStand =
		true

	humanoid:ChangeState(
		Enum.HumanoidStateType.Physics
	)

	return true
end

local function finishTrick()

	if not running
		or ragdolled
		or not doingTrick
	then

		return
	end

	root.AssemblyAngularVelocity =
		Vector3.zero

	torso.AssemblyAngularVelocity =
		Vector3.zero

	humanoid.PlatformStand =
		false

	humanoid.AutoRotate =
		true

	humanoid:ChangeState(
		Enum.HumanoidStateType.Running
	)

	doingTrick =
		false
end

local function failTrick()

	if not running
		or ragdolled
		or not doingTrick
	then

		return
	end

	ragdoll(
		root.AssemblyLinearVelocity,
		root.AssemblyAngularVelocity
	)
end

-- ==========================================================
-- FRONTFLIP
-- ==========================================================

local function frontflip()

	if not beginTrick() then
		return
	end

	root:ApplyImpulse(

		(
			root.CFrame.LookVector
				* 16

			+ Vector3.new(
				0,
				config.FrontflipPower,
				0
			)
		)

		* root.AssemblyMass
	)

	root.AssemblyAngularVelocity =
		root.CFrame.RightVector
		* -config.FlipAngularSpeed

	if stuntFails() then

		task.delay(
			math.random(
				28,
				58
			) / 100,
			failTrick
		)

	else

		task.delay(
			0.9,
			finishTrick
		)
	end
end

-- ==========================================================
-- BACKFLIP
-- ==========================================================

local function backflip()

	if not beginTrick() then
		return
	end

	root:ApplyImpulse(

		(
			-root.CFrame.LookVector
				* 8

			+ Vector3.new(
				0,
				config.BackflipPower,
				0
			)
		)

		* root.AssemblyMass
	)

	root.AssemblyAngularVelocity =
		root.CFrame.RightVector
		* config.FlipAngularSpeed

	if stuntFails() then

		task.delay(
			math.random(
				28,
				58
			) / 100,
			failTrick
		)

	else

		task.delay(
			0.9,
			finishTrick
		)
	end
end

-- ==========================================================
-- DIVE
-- ==========================================================

local function dive()

	if not beginTrick() then
		return
	end

	root:ApplyImpulse(

		(
			root.CFrame.LookVector
				* config.DiveForwardPower

			+ Vector3.new(
				0,
				config.DiveUpPower,
				0
			)
		)

		* root.AssemblyMass
	)

	root.AssemblyAngularVelocity =
		root.CFrame.RightVector
		* -4

	if stuntFails() then

		task.delay(
			0.35,
			failTrick
		)

	else

		task.delay(
			0.8,
			finishTrick
		)
	end
end

-- ==========================================================
-- SPIN
-- ==========================================================

local function spinJump()

	if not beginTrick() then
		return
	end

	root:ApplyImpulse(

		Vector3.new(
			0,
			config.SpinPower,
			0
		)

		* root.AssemblyMass
	)

	root.AssemblyAngularVelocity =
		Vector3.new(
			0,
			config.SpinAngularSpeed,
			0
		)

	if stuntFails() then

		task.delay(
			0.45,
			failTrick
		)

	else

		task.delay(
			0.85,
			finishTrick
		)
	end
end

