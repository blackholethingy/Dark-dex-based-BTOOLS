-- ==========================================================
-- STATE
-- ==========================================================

local running = true

local ragdolled = false

local doingTrick = false

local awaitingBind = nil

local autoGetUpToken = 0

local connections = {}

local ragdollObjects = {}

local ragdollConnections = {}

local originalMotorStates = {}

local originalCollisionStates = {}

local originalPhysicalProperties = {}

local bindButtons = {}

local bindRefreshers = {}

local collisionEnforcer = nil

local velocityTracker = nil

local lastPhysicsVelocity =
	Vector3.zero

local lastBounceTime = 0

local lastBouncePart = nil

-- ==========================================================
-- CONNECTION TRACKING
-- ==========================================================

local function track(connection)

	table.insert(
		connections,
		connection
	)

	return connection
end

local function trackRagdollConnection(connection)

	table.insert(
		ragdollConnections,
		connection
	)

	return connection
end

local function disconnectRagdollConnections()

	for _, connection in ipairs(
		ragdollConnections
	) do

		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(
		ragdollConnections
	)
end

-- ==========================================================
-- MOTOR LOOKUP
-- ==========================================================

local function findMotor(name)

	for _, object in ipairs(
		character:GetDescendants()
	) do

		if object:IsA("Motor6D")
			and object.Name == name
		then

			return object
		end
	end

	return nil
end

local rootJoint =
	findMotor("RootJoint")

local neck =
	findMotor("Neck")

local leftShoulder =
	findMotor("Left Shoulder")

local rightShoulder =
	findMotor("Right Shoulder")

local leftHip =
	findMotor("Left Hip")

local rightHip =
	findMotor("Right Hip")

local motors = {

	rootJoint,

	neck,

	leftShoulder,

	rightShoulder,

	leftHip,

	rightHip
}

-- ==========================================================
-- OBJECT TRACKING
-- ==========================================================

local function remember(object)

	table.insert(
		ragdollObjects,
		object
	)

	return object
end

-- ==========================================================
-- ATTACHMENT
-- ==========================================================

local function createAttachment(
	part,
	cframe,
	name
)

	local attachment =
		Instance.new("Attachment")

	attachment.Name =
		name

	attachment.CFrame =
		cframe

	attachment.Parent =
		part

	return remember(
		attachment
	)
end

-- ==========================================================
-- SOCKET
-- ==========================================================

local function createSocket(
	motor,
	name
)

	if not motor then
		return
	end

	local part0 =
		motor.Part0

	local part1 =
		motor.Part1

	if not part0
		or not part1
	then

		return
	end

	local attachment0 =
		createAttachment(
			part0,
			motor.C0,
			name .. "_A0"
		)

	local attachment1 =
		createAttachment(
			part1,
			motor.C1,
			name .. "_A1"
		)

	local socket =
		Instance.new(
			"BallSocketConstraint"
		)

	socket.Name =
		name

	socket.Attachment0 =
		attachment0

	socket.Attachment1 =
		attachment1

	socket.Restitution =
		0

	if config.Boneless then

		socket.LimitsEnabled =
			false

		socket.TwistLimitsEnabled =
			false

	else

		socket.LimitsEnabled =
			true

		socket.UpperAngle =
			100

		socket.TwistLimitsEnabled =
			true

		socket.TwistLowerAngle =
			-90

		socket.TwistUpperAngle =
			90
	end

	socket.Parent =
		part0

	return remember(
		socket
	)
end

-- ==========================================================
-- CREATE RAGDOLL
-- ==========================================================

local function createRagdollJoints()

	createSocket(
		rootJoint,
		"RagdollRoot"
	)

	createSocket(
		neck,
		"RagdollNeck"
	)

	createSocket(
		leftShoulder,
		"RagdollLeftShoulder"
	)

	createSocket(
		rightShoulder,
		"RagdollRightShoulder"
	)

	createSocket(
		leftHip,
		"RagdollLeftHip"
	)

	createSocket(
		rightHip,
		"RagdollRightHip"
	)
end

-- ==========================================================
-- MOTOR STATES
-- ==========================================================

local function saveMotorStates()

	originalMotorStates = {}

	for _, motor in ipairs(
		motors
	) do

		if motor
			and motor.Parent
		then

			originalMotorStates[motor] =
				motor.Enabled
		end
	end
end

local function disableMotors()

	for _, motor in ipairs(
		motors
	) do

		if motor
			and motor.Parent
		then

			motor.Enabled =
				false
		end
	end
end

local function restoreMotorStates()

	for motor, previous in pairs(
		originalMotorStates
	) do

		if motor
			and motor.Parent
		then

			motor.Enabled =
				previous
		end
	end

	originalMotorStates = {}
end

-- ==========================================================
-- COLLISION STATES
-- ==========================================================

local function saveCollisionStates()

	originalCollisionStates = {}

	for _, object in ipairs(
		character:GetDescendants()
	) do

		if object:IsA("BasePart") then

			originalCollisionStates[object] =
				object.CanCollide
		end
	end
end

local function restoreCollisionStates()

	for part, previous in pairs(
		originalCollisionStates
	) do

		if part
			and part.Parent
		then

			part.CanCollide =
				previous
		end
	end

	originalCollisionStates = {}
end

-- ==========================================================
-- PHYSICAL PROPERTIES
--
-- Wrapper tables are intentional.
-- CustomPhysicalProperties may be nil.
-- ==========================================================

local function savePhysicalProperties()

	originalPhysicalProperties = {}

	for _, object in ipairs(
		character:GetDescendants()
	) do

		if object:IsA("BasePart") then

			originalPhysicalProperties[object] = {
				Value =
					object.CustomPhysicalProperties
			}
		end
	end
end

local function getOriginalProperties(part)

	local stored =
		originalPhysicalProperties[part]

	if stored then
		return stored.Value
	end

	return nil
end

local function restorePhysicalProperties()

	for part, stored in pairs(
		originalPhysicalProperties
	) do

		if part
			and part.Parent
		then

			part.CustomPhysicalProperties =
				stored.Value
		end
	end

	originalPhysicalProperties = {}
end

-- ==========================================================
-- FRICTION PROPERTIES
-- ==========================================================

local NORMAL_COLLIDER_PROPERTIES =
	PhysicalProperties.new(
		0.7,
		0.5,
		0,
		100,
		0
	)

local ZERO_FRICTION_PROPERTIES =
	PhysicalProperties.new(
		0.7,
		0,
		0,
		100,
		0
	)

-- ==========================================================
-- APPLY FRICTION MODE
-- ==========================================================

local function applyRagdollFriction()

	if not ragdolled then
		return
	end

	local backup =
		character:FindFirstChild(
			"RagdollBackupTorsoCollider"
		)

	if config.ZeroFriction then

		torso.CustomPhysicalProperties =
			ZERO_FRICTION_PROPERTIES

		if backup then

			backup.CustomPhysicalProperties =
				ZERO_FRICTION_PROPERTIES
		end

		if not config.TorsoOnlyCollision then

			for _, part in ipairs({

				head,

				leftArm,

				rightArm,

				leftLeg,

				rightLeg

			}) do

				part.CustomPhysicalProperties =
					ZERO_FRICTION_PROPERTIES
			end
		end

	else

		torso.CustomPhysicalProperties =
			getOriginalProperties(
				torso
			)

		if backup then

			backup.CustomPhysicalProperties =
				NORMAL_COLLIDER_PROPERTIES
		end

		for _, part in ipairs({

			head,

			leftArm,

			rightArm,

			leftLeg,

			rightLeg

		}) do

			part.CustomPhysicalProperties =
				getOriginalProperties(
					part
				)
		end
	end
end

-- ==========================================================
-- BACKUP TORSO COLLIDER
-- ==========================================================

local function createBackupTorsoCollider()

	if not config.BackupTorsoCollider then
		return nil
	end

	if not config.TorsoOnlyCollision then
		return nil
	end

	local collider =
		Instance.new("Part")

	collider.Name =
		"RagdollBackupTorsoCollider"

	collider.Size =
		Vector3.new(
			torso.Size.X * 0.88,
			torso.Size.Y * 0.88,
			torso.Size.Z * 0.78
		)

	collider.CFrame =
		torso.CFrame

	collider.Transparency =
		1

	collider.CastShadow =
		false

	collider.Anchored =
		false

	collider.Massless =
		true

	collider.CanCollide =
		true

	-- IMPORTANT:
	-- Touched must be enabled for physical-contact bounce.
	collider.CanTouch =
		true

	collider.CanQuery =
		false

	if config.ZeroFriction then

		collider.CustomPhysicalProperties =
			ZERO_FRICTION_PROPERTIES

	else

		collider.CustomPhysicalProperties =
			NORMAL_COLLIDER_PROPERTIES
	end

	collider.Parent =
		character

	local weld =
		Instance.new(
			"WeldConstraint"
		)

	weld.Part0 =
		torso

	weld.Part1 =
		collider

	weld.Parent =
		collider

	remember(collider)

	remember(weld)

	return collider
end

-- ==========================================================
-- COLLISION ENFORCEMENT
-- ==========================================================

local function enforceRagdollCollision()

	if not ragdolled then
		return
	end

	if config.TorsoOnlyCollision then

		for _, object in ipairs(
			character:GetDescendants()
		) do

			if object:IsA("BasePart") then

				object.CanCollide =
					false
			end
		end

		-- Actual torso.

		torso.CanCollide =
			true

		torso.CanTouch =
			true

		-- HRP never collides.

		root.CanCollide =
			false

		-- Backup collision shell.

		local backup =
			character:FindFirstChild(
				"RagdollBackupTorsoCollider"
			)

		if backup then

			backup.CanCollide =
				true

			backup.CanTouch =
				true
		end

	else

		root.CanCollide =
			false

		for _, part in ipairs({

			torso,

			head,

			leftArm,

			rightArm,

			leftLeg,

			rightLeg

		}) do

			part.CanCollide =
				true
		end
	end

	applyRagdollFriction()
end

-- ==========================================================
-- BOUNCE RAY PARAMS
-- ==========================================================

local bounceRayParams =
	RaycastParams.new()

bounceRayParams.FilterType =
	Enum.RaycastFilterType.Exclude

bounceRayParams.FilterDescendantsInstances =
	{ character }

bounceRayParams.IgnoreWater =
	false

bounceRayParams.RespectCanCollide =
	true

-- ==========================================================
-- ESTIMATE COLLISION NORMAL
-- ==========================================================
--
-- Touched gives us the object but not the normal.
--
-- We raycast in the PRE-COLLISION velocity direction to get
-- the actual face normal.
--
-- If that misses, use a center-to-center fallback.
--
-- ==========================================================

local function estimateCollisionNormal(
	otherPart,
	incomingVelocity
)

	if incomingVelocity.Magnitude
		< 0.001
	then

		return nil
	end

	local direction =
		incomingVelocity.Unit

	local distance =
		math.max(
			4,
			torso.Size.Magnitude
		)

	local origins = {

		torso.Position
			- direction * 1.5,

		torso.Position
			- direction * 0.75,

		torso.Position,

		torso.Position
			+ torso.CFrame.RightVector
				* torso.Size.X
				* 0.35,

		torso.Position
			- torso.CFrame.RightVector
				* torso.Size.X
				* 0.35,

		torso.Position
			+ torso.CFrame.UpVector
				* torso.Size.Y
				* 0.35,

		torso.Position
			- torso.CFrame.UpVector
				* torso.Size.Y
				* 0.35
	}

	for _, origin in ipairs(
		origins
	) do

		local result =
			Workspace:Raycast(
				origin,
				direction * distance,
				bounceRayParams
			)

		if result
			and result.Instance
			== otherPart
		then

			return result.Normal.Unit
		end
	end

	-- ======================================================
	-- FALLBACK NORMAL
	-- ======================================================

	local away =
		torso.Position
		- otherPart.Position

	if away.Magnitude
		> 0.001
	then

		return away.Unit
	end

	return -direction
end

-- ==========================================================
-- REFLECT
-- ==========================================================

local function reflect(
	velocity,
	normal
)

	return velocity
		- (
			2
			* velocity:Dot(normal)
			* normal
		)
end

-- ==========================================================
-- RANDOM ±ANGLE REDIRECTION
-- ==========================================================

local function randomizeBounceDirection(
	direction
)

	if direction.Magnitude
		< 0.001
	then

		return Vector3.yAxis
	end

	direction =
		direction.Unit

	local angle =
		config.BounceAngle

	local pitch =
		math.rad(
			math.random(
				-angle * 100,
				angle * 100
			) / 100
		)

	local yaw =
		math.rad(
			math.random(
				-angle * 100,
				angle * 100
			) / 100
		)

	local basis =
		CFrame.lookAt(
			Vector3.zero,
			direction
		)

	return (
		basis
		* CFrame.Angles(
			pitch,
			yaw,
			0
		)
	).LookVector.Unit
end

-- ==========================================================
-- PHYSICAL BOUNCE
-- ==========================================================

local function processPhysicalImpact(
	otherPart
)

	if not running
		or not ragdolled
		or not config.Bounce
	then

		return
	end

	if not otherPart
		or not otherPart:IsA("BasePart")
	then

		return
	end

	if otherPart:IsDescendantOf(
		character
	) then

		return
	end

	if not otherPart.CanCollide then
		return
	end

	local incoming =
		lastPhysicsVelocity

	local speed =
		incoming.Magnitude

	if speed
		< config.BounceMinSpeed
	then

		return
	end

	local now =
		os.clock()

	-- ======================================================
	-- COOLDOWN
	-- ======================================================

	if now - lastBounceTime
		< config.BounceCooldown
	then

		return
	end

	-- ======================================================
	-- FIND SURFACE NORMAL
	-- ======================================================

	local normal =
		estimateCollisionNormal(
			otherPart,
			incoming
		)

	if not normal then
		return
	end

	-- Must actually be traveling into surface.

	local approach =
		incoming:Dot(
			normal
		)

	if approach >= -0.25 then
		return
	end

	-- ======================================================
	-- REFLECT
	-- ======================================================

	local reflected =
		reflect(
			incoming,
			normal
		)

	if reflected.Magnitude
		< 0.001
	then

		reflected =
			normal
	end

	-- ======================================================
	-- RANDOMIZE
	-- ======================================================

	local redirected =
		randomizeBounceDirection(
			reflected
		)

	-- ======================================================
	-- DON'T RANDOMIZE BACK INTO SURFACE
	-- ======================================================

	if redirected:Dot(normal)
		< 0.18
	then

		redirected =
			redirected
			+ normal * 0.9

		if redirected.Magnitude
			> 0.001
		then

			redirected =
				redirected.Unit
		else

			redirected =
				normal
		end
	end

	local outputSpeed =
		speed
		* config.BouncePower

	local newVelocity =
		redirected
		* outputSpeed

	-- ======================================================
	-- IMPORTANT:
	--
	-- NO CFrame CHANGES.
	-- NO TELEPORT.
	--
	-- Roblox already resolved the physical collision.
	-- We only change velocity AFTER contact.
	-- ======================================================

	task.defer(function()

		if not running
			or not ragdolled
			or not config.Bounce
		then

			return
		end

		torso.AssemblyLinearVelocity =
			newVelocity

		root.AssemblyLinearVelocity =
			newVelocity

		torso.AssemblyAngularVelocity +=
			Vector3.new(
				math.random(-6, 6),
				math.random(-6, 6),
				math.random(-6, 6)
			)
	end)

	lastBounceTime =
		now

	lastBouncePart =
		otherPart
end

-- ==========================================================
-- START BOUNCE
-- ==========================================================

local function startBounceSystem(
	backupCollider
)

	lastBounceTime = 0

	lastBouncePart = nil

	lastPhysicsVelocity =
		torso.AssemblyLinearVelocity

	-- ======================================================
	-- SAVE VELOCITY BEFORE COLLISION RESPONSE
	-- ======================================================

	velocityTracker =
		RunService.PreSimulation:
			Connect(function()

				if not running
					or not ragdolled
				then

					return
				end

				local current =
					torso.AssemblyLinearVelocity

				if current.Magnitude
					> 0.1
				then

					lastPhysicsVelocity =
						current
				end
			end)

	trackRagdollConnection(
		velocityTracker
	)

	-- ======================================================
	-- REAL TORSO CONTACT
	-- ======================================================

	trackRagdollConnection(

		torso.Touched:
			Connect(
				processPhysicalImpact
			)
	)

	-- ======================================================
	-- BACKUP COLLIDER CONTACT
	-- ======================================================

	if backupCollider then

		trackRagdollConnection(

			backupCollider.Touched:
				Connect(
					processPhysicalImpact
				)
		)
	end
end

-- ==========================================================
-- DESTROY RAGDOLL OBJECTS
-- ==========================================================

local function destroyRagdollObjects()

	for _, object in ipairs(
		ragdollObjects
	) do

		if object
			and object.Parent
		then

			pcall(function()
				object:Destroy()
			end)
		end
	end

	table.clear(
		ragdollObjects
	)
end

-- ==========================================================
-- UPRIGHT RECOVERY
-- ==========================================================

local function makeRootUpright()

	local look =
		root.CFrame.LookVector

	local flatLook =
		Vector3.new(
			look.X,
			0,
			look.Z
		)

	if flatLook.Magnitude
		< 0.01
	then

		flatLook =
			Vector3.new(
				0,
				0,
				-1
			)
	end

	flatLook =
		flatLook.Unit

	root.CFrame =
		CFrame.lookAt(
			torso.Position,
			torso.Position
				+ flatLook,
			Vector3.yAxis
		)
end

