-- ==========================================================
-- MOTOR CONTROL
-- ==========================================================

local function disableMotors()

	if rootJoint then
		rootJoint.Enabled =
			false
	end

	if neck then
		neck.Enabled =
			false
	end

	if leftShoulder then
		leftShoulder.Enabled =
			false
	end

	if rightShoulder then
		rightShoulder.Enabled =
			false
	end

	if leftHip then
		leftHip.Enabled =
			false
	end

	if rightHip then
		rightHip.Enabled =
			false
	end
end

local function enableMotors()

	if rootJoint then
		rootJoint.Enabled =
			true
	end

	if neck then
		neck.Enabled =
			true
	end

	if leftShoulder then
		leftShoulder.Enabled =
			true
	end

	if rightShoulder then
		rightShoulder.Enabled =
			true
	end

	if leftHip then
		leftHip.Enabled =
			true
	end

	if rightHip then
		rightHip.Enabled =
			true
	end
end

-- ==========================================================
-- RAGDOLL
-- ==========================================================

local function ragdoll(
	extraVelocity,
	extraAngularVelocity
)

	if ragdolled
		or not running
	then
		return
	end

	ragdolled =
		true

	doingTrick =
		false

	rememberCollisionStates()

	createRagdollJoints()

	disableMotors()

	applyFunnyRagdollCollisions()

	humanoid.AutoRotate =
		false

	humanoid.PlatformStand =
		true

	humanoid:ChangeState(
		Enum.HumanoidStateType.Physics
	)

	-- ======================================================
	-- ROOT ↔ TORSO LOOSE CONNECTION
	-- ======================================================

	local rootAttachment =
		makeAttachment(
			root,
			CFrame.new(),
			"RagdollRootA0"
		)

	local torsoAttachment =
		makeAttachment(
			torso,
			root.CFrame:
				ToObjectSpace(
					torso.CFrame
				),
			"RagdollRootA1"
		)

	local rootSocket =
		Instance.new(
			"BallSocketConstraint"
		)

	rootSocket.Name =
		"RagdollRootSocket"

	rootSocket.Attachment0 =
		rootAttachment

	rootSocket.Attachment1 =
		torsoAttachment

	rootSocket.LimitsEnabled =
		false

	rootSocket.TwistLimitsEnabled =
		false

	rootSocket.Parent =
		root

	rememberRagdollObject(
		rootSocket
	)

	-- ======================================================
	-- PRESERVE STUNT MOMENTUM
	-- ======================================================

	if extraVelocity then

		torso.AssemblyLinearVelocity =
			extraVelocity
	end

	if extraAngularVelocity then

		torso.AssemblyAngularVelocity =
			extraAngularVelocity
	end
end

-- ==========================================================
-- UNRAGDOLL
-- ==========================================================

local function unragdoll()

	if not ragdolled then
		return
	end

	ragdolled =
		false

	for _, object in ipairs(
		createdRagdollObjects
	) do

		if object
			and object.Parent
		then

			pcall(function()
				object:Destroy()
			end)
		end
	end

	table.clear(
		createdRagdollObjects
	)

	enableMotors()

	-- ======================================================
	-- RESTORE COLLISIONS
	-- ======================================================

	for part, value in pairs(
		originalCollision
	) do

		if part
			and part.Parent
		then

			part.CanCollide =
				value
		end
	end

	originalCollision =
		{}

	root.CanCollide =
		false

	-- ======================================================
	-- STOP SPIN
	-- ======================================================

	root.AssemblyAngularVelocity =
		Vector3.zero

	torso.AssemblyAngularVelocity =
		Vector3.zero

	-- ======================================================
	-- RESTORE HUMANOID
	-- ======================================================

	humanoid.PlatformStand =
		false

	humanoid.AutoRotate =
		true

	local _, yaw, _ =
		torso.CFrame:
			ToEulerAnglesYXZ()

	root.CFrame =
		CFrame.new(
			torso.Position
				+ Vector3.new(
					0,
					2,
					0
				)
		)
		* CFrame.Angles(
			0,
			yaw,
			0
		)

	humanoid:ChangeState(
		Enum.HumanoidStateType.GettingUp
	)
end

-- ==========================================================
-- TOGGLE RAGDOLL
-- ==========================================================

local function toggleRagdoll()

	if doingTrick then
		return
	end

	if ragdolled then

		unragdoll()

	else

		ragdoll(
			root.AssemblyLinearVelocity,
			root.AssemblyAngularVelocity
		)
	end
end

-- ==========================================================
-- FAIL CHANCE
-- ==========================================================

local function stuntFails()

	return math.random(
		1,
		100
	) <= config.FailureChance
end

-- ==========================================================
-- BEGIN TRICK
-- ==========================================================

local function beginTrick()

	if doingTrick
		or ragdolled
		or not running
	then

		return false
	end

	doingTrick =
		true

	humanoid.AutoRotate =
		false

	humanoid.PlatformStand =
		true

	humanoid:ChangeState(
		Enum.HumanoidStateType.Physics
	)

	return true
end

-- ==========================================================
-- FINISH TRICK
-- ==========================================================

local function finishTrick()

	if ragdolled
		or not doingTrick
		or not running
	then

		return
	end

	root.AssemblyAngularVelocity =
		Vector3.zero

	torso.AssemblyAngularVelocity =
		Vector3.zero

	humanoid.PlatformStand =
		false

	humanoid.AutoRotate =
		true

	humanoid:ChangeState(
		Enum.HumanoidStateType.GettingUp
	)

	doingTrick =
		false
end

-- ==========================================================
-- FAIL TRICK
-- ==========================================================

local function failCurrentTrick()

	if not doingTrick
		or ragdolled
		or not running
	then

		return
	end

	ragdoll(
		root.AssemblyLinearVelocity,
		root.AssemblyAngularVelocity
	)
end

-- ==========================================================
-- FRONTFLIP
-- ==========================================================

local function frontflip()

	if not beginTrick() then
		return
	end

	local look =
		root.CFrame.LookVector

	root:ApplyImpulse(
		(
			look * 16

			+ Vector3.new(
				0,
				config.FrontflipPower,
				0
			)
		)
		* root.AssemblyMass
	)

	root.AssemblyAngularVelocity =
		root.CFrame.RightVector
		* -config.FlipAngularSpeed

	if stuntFails() then

		task.delay(
			math.random(
				28,
				58
			) / 100,

			failCurrentTrick
		)

	else

		task.delay(
			0.9,
			finishTrick
		)
	end
end

-- ==========================================================
-- BACKFLIP
-- ==========================================================

local function backflip()

	if not beginTrick() then
		return
	end

	local look =
		root.CFrame.LookVector

	root:ApplyImpulse(
		(
			-look * 8

			+ Vector3.new(
				0,
				config.BackflipPower,
				0
			)
		)
		* root.AssemblyMass
	)

	root.AssemblyAngularVelocity =
		root.CFrame.RightVector
		* config.FlipAngularSpeed

	if stuntFails() then

		task.delay(
			math.random(
				28,
				58
			) / 100,

			failCurrentTrick
		)

	else

		task.delay(
			0.9,
			finishTrick
		)
	end
end

-- ==========================================================
-- DIVE
-- ==========================================================

local function dive()

	if not beginTrick() then
		return
	end

	local look =
		root.CFrame.LookVector

	root:ApplyImpulse(
		(
			look
				* config.DiveForwardPower

			+ Vector3.new(
				0,
				config.DiveUpPower,
				0
			)
		)
		* root.AssemblyMass
	)

	root.AssemblyAngularVelocity =
		root.CFrame.RightVector
		* -4

	if stuntFails() then

		task.delay(
			0.35,
			failCurrentTrick
		)

	else

		task.delay(
			0.8,
			finishTrick
		)
	end
end

-- ==========================================================
-- SPIN JUMP
-- ==========================================================

local function spinJump()

	if not beginTrick() then
		return
	end

	root:ApplyImpulse(
		Vector3.new(
			0,
			config.SpinPower,
			0
		)
		* root.AssemblyMass
	)

	root.AssemblyAngularVelocity =
		Vector3.new(
			0,
			config.SpinAngularSpeed,
			0
		)

	if stuntFails() then

		task.delay(
			0.45,
			function()

				if doingTrick
					and not ragdolled
					and running
				then

					root.AssemblyAngularVelocity +=
						root.CFrame.LookVector
						* 8

					failCurrentTrick()
				end
			end
		)

	else

		task.delay(
			0.85,
			finishTrick
		)
	end
end

