-- ==========================================================
-- R6 STUNT / RAGDOLL LAB
-- PHYSICAL-CONTACT BOUNCE EDITION
-- ==========================================================
--
-- R = Ragdoll
-- F = Frontflip
-- G = Backflip
-- T = Dive
-- Y = Spin
--
-- BOUNCE FIX:
--   - NO Blockcast teleporting
--   - NO CFrame push-outs
--   - NO predictive collision replacement
--
-- Roblox performs the actual collision.
-- Touched then redirects the incoming velocity.
--
-- ==========================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ==========================================================
-- CLEAN PREVIOUS VERSION
-- ==========================================================

if _G.R6StuntCleanup then
	pcall(_G.R6StuntCleanup)
end

-- ==========================================================
-- CHARACTER
-- ==========================================================

local character =
	player.Character
	or player.CharacterAdded:Wait()

local humanoid =
	character:WaitForChild("Humanoid")

if humanoid.RigType ~= Enum.HumanoidRigType.R6 then
	error("This script requires R6.")
end

local root =
	character:WaitForChild("HumanoidRootPart")

local torso =
	character:WaitForChild("Torso")

local head =
	character:WaitForChild("Head")

local leftArm =
	character:WaitForChild("Left Arm")

local rightArm =
	character:WaitForChild("Right Arm")

local leftLeg =
	character:WaitForChild("Left Leg")

local rightLeg =
	character:WaitForChild("Right Leg")

humanoid.RequiresNeck = false

-- ==========================================================
-- CONFIG
-- ==========================================================

local config = {

	-- RAGDOLL

	Boneless = true,

	TorsoOnlyCollision = true,

	BackupTorsoCollider = true,

	PreserveMomentum = true,

	ExtraFlop = true,

	ZeroFriction = false,

	-- BOUNCE

	Bounce = false,

	BounceAngle = 45,

	BouncePower = 1,

	BounceMinSpeed = 6,

	BounceCooldown = 0.09,

	-- AUTO GET UP

	AutoGetUp = false,

	AutoGetUpDelay = 3,

	-- STUNTS

	FailureChance = 30,

	FrontflipPower = 52,

	BackflipPower = 52,

	DiveForwardPower = 58,

	DiveUpPower = 18,

	SpinPower = 48,

	FlipAngularSpeed = 12,

	SpinAngularSpeed = 14
}

