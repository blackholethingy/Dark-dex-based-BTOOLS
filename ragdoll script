-- ==========================================================
-- KEY INPUT
-- ==========================================================

trackConnection(
	UserInputService.InputBegan:
		Connect(function(
			input,
			gameProcessed
		)

			if not running
				or gameProcessed
			then
				return
			end

			if input.UserInputType
				~= Enum.UserInputType.Keyboard
			then
				return
			end

			-- ==============================================
			-- REBIND
			-- ==============================================

			if awaitingBind then

				local action =
					awaitingBind

				binds[action] =
					input.KeyCode

				awaitingBind =
					nil

				if bindButtons[action] then

					bindButtons[action].
						BackgroundColor3 =
						Color3.fromRGB(
							48,
							48,
							56
						)
				end

				if refreshFunctions[action] then
					refreshFunctions[action]()
				end

				return
			end

			-- ==============================================
			-- ACTIONS
			-- ==============================================

			for actionName,
				keyCode in pairs(
					binds
				)
			do

				if input.KeyCode
					== keyCode
				then

					local action =
						actions[
							actionName
						]

					if action then
						action()
					end

					return
				end
			end
		end)
)

-- ==========================================================
-- CLEANUP / KILL SCRIPT
-- ==========================================================

local function cleanup()

	if not running then
		return
	end

	running =
		false

	awaitingBind =
		nil

	doingTrick =
		false

	ragdolled =
		false

	-- Remove constraints.
	for _, object in ipairs(
		createdRagdollObjects
	) do

		if object
			and object.Parent
		then

			pcall(function()
				object:Destroy()
			end)
		end
	end

	table.clear(
		createdRagdollObjects
	)

	-- Restore motors.
	enableMotors()

	-- Restore collisions.
	for part, value in pairs(
		originalCollision
	) do

		if part
			and part.Parent
		then

			part.CanCollide =
				value
		end
	end

	originalCollision =
		{}

	root.CanCollide =
		false

	-- Stop physics.
	root.AssemblyAngularVelocity =
		Vector3.zero

	torso.AssemblyAngularVelocity =
		Vector3.zero

	-- Restore Humanoid.
	humanoid.PlatformStand =
		false

	humanoid.AutoRotate =
		true

	pcall(function()

		humanoid:ChangeState(
			Enum.HumanoidStateType.GettingUp
		)

	end)

	-- Disconnect events.
	for _, connection in ipairs(
		connections
	) do

		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(
		connections
	)

	if gui then
		gui:Destroy()
	end

	_G.R6StuntCleanup =
		nil

	print(
		"R6 Stunt Lab killed."
	)
end

_G.R6StuntCleanup =
	cleanup

killButton.MouseButton1Click:
	Connect(
		cleanup
	)

