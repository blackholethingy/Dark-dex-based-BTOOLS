-- ==========================================================
-- INPUT
-- ==========================================================

track(
	UserInputService.InputBegan:
		Connect(function(
			input,
			processed
		)

			if processed
				or not running
			then

				return
			end

			if input.UserInputType
				~= Enum.UserInputType.Keyboard
			then

				return
			end

			if awaitingBind then

				local actionName =
					awaitingBind

				binds[actionName] =
					input.KeyCode

				awaitingBind =
					nil

				if bindRefreshers[
					actionName
				] then

					bindRefreshers[
						actionName
					]()
				end

				return
			end

			for actionName,
				keyCode in pairs(
					binds
				)
			do

				if input.KeyCode
					== keyCode
				then

					local action =
						actions[
							actionName
						]

					if action then
						action()
					end

					return
				end
			end
		end)
)

-- ==========================================================
-- CLEANUP
-- ==========================================================

local function cleanup()

	if not running then
		return
	end

	running = false

	autoGetUpToken += 1

	doingTrick = false

	awaitingBind = nil

	disconnectRagdollConnections()

	if collisionEnforcer then

		collisionEnforcer:
			Disconnect()

		collisionEnforcer = nil
	end

	destroyRagdollObjects()

	restoreMotorStates()

	restoreCollisionStates()

	restorePhysicalProperties()

	ragdolled = false

	pcall(
		makeRootUpright
	)

	root.AssemblyAngularVelocity =
		Vector3.zero

	torso.AssemblyAngularVelocity =
		Vector3.zero

	humanoid.PlatformStand =
		false

	humanoid.AutoRotate =
		true

	pcall(function()

		humanoid:ChangeState(
			Enum.HumanoidStateType.GettingUp
		)

	end)

	for _, connection in ipairs(
		connections
	) do

		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(
		connections
	)

	if gui then
		gui:Destroy()
	end

	_G.R6StuntCleanup = nil

	print(
		"R6 Stunt / Ragdoll Lab killed."
	)
end

_G.R6StuntCleanup =
	cleanup

killButton.MouseButton1Click:
	Connect(
		cleanup
	)

