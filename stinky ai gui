-- Dynamic state collection engine to cleanly survive character respawns
local function getLocalCharacterState()
	local char = player.Character
	if not char then return nil, nil, nil end
	
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	
	if hum and root and hum.Health > 0 then
		return char, hum, root
	end
	return nil, nil, nil
end

-- Hardcoded reference path to the map infrastructure tool asset
local function getMopGiverAsset()
	local map = workspace:FindFirstChild("A_MAP")
	local infra = map and map:FindFirstChild("Infrastructure")
	local fac = infra and infra:FindFirstChild("Facility")
	local under = fac and fac:FindFirstChild("UndergroundFacility")
	local cafe = under and under:FindFirstChild("CafeGrid")
	return cafe and cafe:FindFirstChild("Double Mop Giver")
end

-- Dynamic visual asset and hostile tool filter engine
local function getSmartCombatTarget()
	local _, _, hrp = getLocalCharacterState()
	if not hrp then return nil end

	local closestEnemy = nil
	local shortestDistance = config.CombatRange
	
	for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
			local enemyChar = p.Character
			local enemyHum = enemyChar.Humanoid
			
			if enemyHum.Health > 0 then
				local isStaff = false
				
				local teamName = p.Team and p.Team.Name or ""
				local lowerTeam = string.lower(teamName)
				if string.find(lowerTeam, "orderly") or string.find(lowerTeam, "guard") or string.find(lowerTeam, "epu") or string.find(lowerTeam, "staff") then
					isStaff = true
				end
				
				if not isStaff then
					for _, item in ipairs(enemyChar:GetChildren()) do
						if item:IsA("Tool") and (string.find(string.lower(item.Name), "stun") or string.find(string.lower(item.Name), "staff") or string.find(string.lower(item.Name), "taser") or string.find(string.lower(item.Name), "handcuff")) then
							isStaff = true
							break
						end
					end
				end
				
				if not isStaff and p:FindFirstChild("Backpack") then
					for _, item in ipairs(p.Backpack:GetChildren()) do
						if string.find(string.lower(item.Name), "stun") or string.find(string.lower(item.Name), "staff") or string.find(string.lower(item.Name), "taser") then
							isStaff = true
							break
						end
					end
				end
				
				if isStaff then
					local distance = (hrp.Position - enemyChar.HumanoidRootPart.Position).Magnitude
					if distance < shortestDistance then
						shortestDistance = distance
						closestEnemy = enemyChar
					end
				end
			end
		end
	end
	return closestEnemy
end

local function walkToTarget(targetPosition)
	local char, humanoid, hrp = getLocalCharacterState()
	if not hrp or not humanoid then return end

	local visualCube = workspace:FindFirstChild("AITargetCube")
	if not visualCube then
		visualCube = Instance.new("Part")
		visualCube.Name = "AITargetCube"
		visualCube.Size = Vector3.new(1.5, 1.5, 1.5)
		visualCube.Anchored = true
		visualCube.CanCollide = false
		visualCube.Material = Enum.Material.Neon
		visualCube.Color = Color3.fromRGB(0, 255, 120)
		visualCube.Parent = workspace
	end
	visualCube.Position = targetPosition

	local path = PathfindingService:CreatePath({AgentRadius = 2.5, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 3})
	local success = pcall(function() path:ComputeAsync(hrp.Position, targetPosition) end)
	
	if success and path.Status == Enum.PathStatus.Success then
		local lastPosition = hrp.Position
		local stuckTimer = 0

		for _, waypoint in ipairs(path:GetWaypoints()) do
			char, humanoid, hrp = getLocalCharacterState()
			if not config.ScriptRunning or (not config.AutoMop and not config.AutoCombat) or not hrp or not humanoid then break end
			
			-- INSTANT BREAK FIX: If we touch the spill boundary while moving, halt walking and start mopping immediately
			if currentTargetSpill and currentTargetSpill.Parent then
				local spillPos = currentTargetSpill:IsA("BasePart") and currentTargetSpill.Position or currentTargetSpill:GetPivot().Position
				local currentDist = (hrp.Position - spillPos).Magnitude
				local triggerRange = (currentTargetSpill.Name == "Spill_Large") and 9.5 or 6.0
				
				if currentDist <= triggerRange then
					break 
				end
			end
			
			if waypoint.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
			
			local reachedNode = false
			local nodeTimeout = 0
			while not reachedNode and nodeTimeout < 1.5 do
				char, humanoid, hrp = getLocalCharacterState()
				if not hrp or not humanoid then break end
				
				if currentTargetSpill and currentTargetSpill.Parent then
					local spillPos = currentTargetSpill:IsA("BasePart") and currentTargetSpill.Position or currentTargetSpill:GetPivot().Position
					local currentDist = (hrp.Position - spillPos).Magnitude
					local triggerRange = (currentTargetSpill.Name == "Spill_Large") and 9.5 or 6.0
					if currentDist <= triggerRange then break end
				end
				
				local diffVector = waypoint.Position - hrp.Position
				if diffVector.Magnitude <= 4.5 then
					reachedNode = true
					break
				end
				
				-- ANTI-STUCK SYSTEM (Vault over Railings)
				stuckTimer = stuckTimer + 0.015
				if stuckTimer >= 0.8 then
					local distanceMoved = (hrp.Position - lastPosition).Magnitude
					if distanceMoved <= 1.2 then
						print("[Anti-Stuck] Railing bottleneck detected. Executing dynamic forward vault...")
						humanoid.Jump = true
						
						local forwardVector = Vector3.new(diffVector.X, 0, diffVector.Z).Unit
						local vaultFrames = 0
						while vaultFrames < 20 do
							char, humanoid, hrp = getLocalCharacterState()
							if not humanoid then break end
							humanoid:Move(forwardVector, false)
							RunService.PostSimulation:Wait()
							vaultFrames = vaultFrames + 1
						end
					end
					lastPosition = hrp.Position
					stuckTimer = 0
				end
				
				humanoid:Move(Vector3.new(diffVector.X, 0, diffVector.Z).Unit, false)
				RunService.PostSimulation:Wait()
				nodeTimeout = nodeTimeout + 0.015
			end
		end
	end
	
	if visualCube then visualCube:Destroy() end
end

local function findClosestSpill()
	local _, _, hrp = getLocalCharacterState()
	if not hrp then return nil end

	local closestSpill = nil
	local shortestDistance = math.huge
	local spillsFolder = workspace:FindFirstChild("Ignored") and workspace.Ignored:FindFirstChild("Spills")
	if not spillsFolder then return nil end
	
	for _, obj in ipairs(spillsFolder:GetChildren()) do
		local pos = obj:IsA("BasePart") and obj.Position or obj:IsA("Model") and obj:GetPivot().Position
		if pos and (string.find(obj.Name, "Spill") or string.find(string.lower(obj.Name), "puddle")) then
			local distance = (hrp.Position - pos).Magnitude
			if distance < shortestDistance then
				shortestDistance = distance
				closestSpill = obj
			end
		end
	end
	return closestSpill
end
